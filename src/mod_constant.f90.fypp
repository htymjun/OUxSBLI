#:include 'config.fypp'
#:if not defined('COMMZ')
  #:set COMMZ = False
#:endif
#:if not defined('BC_X')
  #:set BC_X = True
#:endif
#:if not defined('BC_Y')
  #:set BC_Y = True
#:endif
#:if not defined('BC_Z')
  #:set BC_Z = False
#:endif
#:include 'precision.fypp'
module mod_constant
  use cudafor
  use mod_precision
  use mod_globals, only : R, gamma, Pr, Prt, dt, dimension
  implicit none
  ! real(8) masters (host-side code uses these directly)
  real(8), parameter :: gamma_1        = gamma - 1.d0
  real(8), parameter :: over_gamma     = 1.d0 / gamma
  real(8), parameter :: over_gamma_1   = 1.d0 / (gamma - 1.d0)
  real(8), parameter :: R_over_gamma_1 = R / (gamma - 1.d0)
  real(8), parameter :: Cp = gamma * R / (gamma - 1.d0)
  real(8), parameter :: over_Cp     = 1.d0 / Cp
  real(8), parameter :: Cp_over_Pr  = Cp / Pr
  real(8), parameter :: over_T0     = 1.d0 / 273.2d0
  real(8), parameter :: mu0_T0_S_over_T0_2_3 = 1.716d-5 * 383.6d0 * 273.2d0**(-1.5d0) !1.716d-5 * 384.2d0 * 273.2d0**(-1.5d0)
  real(8), parameter :: one_third   = 1.d0 / 3.d0
  real(8), parameter :: two_third   = 2.d0 / 3.d0
  real(8), parameter :: one_sixth   = 1.d0 / 6.d0
  real(8), parameter :: one_twelfth = 1.d0 / 12.d0
  real(8), parameter :: one_sixty   = 1.d0 / 60.d0
  real(8), parameter :: tan10deg2   = (tan(10.d0 * acos(-1.d0) / 180.d0))**2
  real(8), parameter :: one_24        = 1.d0 / 24.d0
  real(8), parameter :: one_48        = 1.d0 / 48.d0
  real(8), parameter :: one_60        = 1.d0 / 60.d0
  real(8), parameter :: one_120       = 1.d0 / 120.d0
  real(8), parameter :: one_240       = 1.d0 / 240.d0
  real(8), parameter :: seven_twelfth = 7.d0 / 12.d0
  ! Device code never uses the masters above: it imports the copy of its own
  ! kind, `<name>_arr` (kd_arr: RK update, BCs, primitives), `<name>_conv`
  ! (kd_conv: convective kernels) or `<name>_visc` (kd_visc: viscous kernels),
  ! usually renamed back on import (`one_third => one_third_conv`) so the
  ! kernel bodies read the same in every precision. Each copy is the master
  ! rounded once to the target kind.
  #:set KIND_CONSTS = ['gamma', 'R', 'Pr', 'Prt', 'dt', 'gamma_1', 'over_gamma', 'over_gamma_1', 'R_over_gamma_1', &
    & 'Cp', 'over_Cp', 'Cp_over_Pr', 'over_T0', 'mu0_T0_S_over_T0_2_3', 'one_third', 'two_third', 'one_sixth', &
    & 'one_twelfth', 'one_sixty', 'tan10deg2', 'one_24', 'one_48', 'one_60', 'one_120', 'one_240', 'seven_twelfth']
  #:for sfx in ['arr', 'conv', 'visc']
  #:for c in KIND_CONSTS
  real(kd_${sfx}$), parameter :: ${c}$_${sfx}$ = real(${c}$, kd_${sfx}$)
  #:endfor
  #:endfor
  real(kd_conv), constant :: Normal_x_conv(5) = (/0._kd_conv, 1._kd_conv, 0._kd_conv, 0._kd_conv, 0._kd_conv/)
  real(kd_conv), constant :: Normal_y_conv(5) = (/0._kd_conv, 0._kd_conv, 1._kd_conv, 0._kd_conv, 0._kd_conv/)
  real(kd_conv), constant :: Normal_z_conv(5) = (/0._kd_conv, 0._kd_conv, 0._kd_conv, 1._kd_conv, 0._kd_conv/)
  ! Fypp-generated kind-dispatch parameters
  #:if VISC == 'Euler'
  integer(2), parameter :: id_visc = 0
  #:elif VISC == 'NS'
  integer(4), parameter :: id_visc = 0
  #:elif VISC == 'LES'
  integer(8), parameter :: id_visc = 0
  #:endif
  #:if ORDER == 2
  integer(2), parameter :: id_accuracy = 0
  #:elif ORDER == 4
  integer(4), parameter :: id_accuracy = 0
  #:elif ORDER == 6
  integer(8), parameter :: id_accuracy = 0
  #:endif
  #:if TVD == 'none'
  integer(2), parameter :: id_tvd = 0
  #:elif TVD == 'tvd'
  integer(4), parameter :: id_tvd = 0
  #:elif TVD == 'hybrid'
  integer(8), parameter :: id_tvd = 0
  #:endif
  #:if SLAU_VARIANT == 'SLAU'
  integer(2), parameter :: id_slau = 0
  #:elif SLAU_VARIANT == 'HRSLAU2'
  integer(4), parameter :: id_slau = 0
  #:endif
  integer(2), parameter :: id_gpumpi = 0
  #:if COMMZ and RESCALE
    $:error('COMMZ=True with RESCALE=True is not supported (no zdec_rescale procedure exists)')
  #:endif
  #:if RESTART
  logical, parameter :: id_recal = .true.
  #:else
  logical, parameter :: id_recal = .false.
  #:endif
  #:if SCHEME == 'KEEP'
  integer(2), parameter :: id_scheme = 0
  #:elif SCHEME == 'SLAU'
  real(2),    parameter :: id_scheme = 0
  #:elif SCHEME == 'Hybrid'
  real(8),    parameter :: id_scheme = 0
  #:endif
  #:if BC_X
  integer(4), parameter :: id_bc_x = 0
  #:else
  integer(2), parameter :: id_bc_x = 0
  #:endif
  #:if BC_Y
  integer(4), parameter :: id_bc_y = 0
  #:else
  integer(2), parameter :: id_bc_y = 0
  #:endif
  #:if BC_Z
  integer(4), parameter :: id_bc_z = 0
  #:else
  integer(2), parameter :: id_bc_z = 0
  #:endif
  #:if RESCALE
  integer(4), parameter :: id_rescale = 0
  #:else
  integer(2), parameter :: id_rescale = 0
  #:endif
end module mod_constant
