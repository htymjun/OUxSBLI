#! Precision selection shared by the templates (validated in mod_constant):
#!   RT: state/flux type (PREC), KT: KEEP arithmetic type (KEEP_PREC),
#!   VAL: ', value' for dummies of type RT (nvfortran cannot pass fltflt by value).
#:include 'config.fypp'
#:if not defined('PREC')
  #:set PREC = 'FP64'
#:endif
#:if not defined('KEEP_PREC')
  #:set KEEP_PREC = 'FP64'
#:endif
#:set RT = 'type(fltflt)' if PREC == 'DF' else 'real(8)'
#:set KT = 'type(dev)' if KEEP_PREC != 'FP64' else RT
#:set VAL = '' if PREC == 'DF' else ', value'
#:set KEEP_PROCS = 'KEEP2, KEEP4, KEEP6' + (', KEEPm2, KEEPm4, KEEPm6' if KEEP_PREC != 'FP64' else '')
#! cache-hint loads/stores take intrinsic types only: plain ones for DF (mod_prec ld/store)
#:set STCG = 'store' if PREC == 'DF' else '__stcg'
#:set LDCS = 'ld' if PREC == 'DF' else '__ldcs'
#:set LDLU = 'ld' if PREC == 'DF' else '__ldlu'
