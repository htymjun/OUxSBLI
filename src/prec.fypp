#! Precision selection shared by the templates (validated in mod_constant):
#!   RT: state/flux type (PREC), KT: KEEP arithmetic type (KEEP_PREC),
#!   KEEP_INST: the (type, suffix) instances of KEEP2/4/6 (DF adds the _ff set
#!   for the kernels that run on DF state; the others keep the real(8) one).
#:include 'config.fypp'
#:if not defined('PREC')
  #:set PREC = 'FP64'
#:endif
#:if not defined('KEEP_PREC')
  #:set KEEP_PREC = 'FP64'
#:endif
#:set RT = 'type(fltflt)' if PREC == 'DF' else 'real(8)'
#:set KT = 'type(dev)' if KEEP_PREC != 'FP64' else 'real(8)'
#:set KEEP_INST = [(KT, '')] + ([('type(fltflt)', '_ff')] if PREC == 'DF' else [])
#:set KEEP_PROCS = ', '.join('KEEP%d%s' % (n, S) for _, S in KEEP_INST for n in (2, 4, 6)) + (', KEEPm2, KEEPm4, KEEPm6' if KEEP_PREC != 'FP64' else '')
