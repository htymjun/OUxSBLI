#:include 'config.fypp'
module calc_slau_kernel_internal
  use mod_globals, only : threadsE, threadsF
  use mod_constant, only : over_gamma_1, id_slau, R_over_gamma_1, one_third, one_sixth, one_twelfth, two_third
  use calc_muscl
  use calc_hybrid
  use libm
  implicit none
  private
  public calc_slau_x_in, calc_slau_y_in
  integer, parameter :: io = ${ORDER_IO}$
  ! KEEP2/4/6 are compiled here too (calc_scheme_math.f90 include below covers
  ! both schemes) even though this module never calls them -- these constants
  ! are the ones their bodies reference.
  real(8), parameter :: one_24        = 1.d0 / 24.d0
  real(8), parameter :: one_48        = 1.d0 / 48.d0
  real(8), parameter :: one_60        = 1.d0 / 60.d0
  real(8), parameter :: one_120       = 1.d0 / 120.d0
  real(8), parameter :: one_240       = 1.d0 / 240.d0
  real(8), parameter :: seven_twelfth = 7.d0 / 12.d0

#:if ORDER == 6
  integer(8), parameter :: id_acc = 0_8
#:elif ORDER == 4
  integer(4), parameter :: id_acc = 0_4
#:else
  integer(2), parameter :: id_acc = 0_2
#:endif

  interface interp
    module procedure interp2, interp4, interp6
  end interface interp

  interface SLAU
    module procedure SLAU1, HRSLAU2
  end interface SLAU
contains
  include 'calc_scheme_math.f90'

  !$dir inline
  attributes(device) subroutine interp6(id_accuracy, rho,  u,  v, p, &
                                                     rhol, ul, vl, pl, &
                                                     rhor, ur, vr, pr, fd)
    integer(8), intent(in), value :: id_accuracy
    real(8), intent(in), contiguous :: rho(6), u(6), v(6), p(6)
    real(8), intent(out)            :: rhol, ul, vl, pl
    real(8), intent(out)            :: rhor, ur, vr, pr
    real(sp), intent(inout)         :: fd
    call delta6(fd, rho(:), rhol, rhor)
    call delta6(fd,   u(:),   ul,   ur)
    call delta6(fd,   v(:),   vl,   vr)
    call delta6(fd,   p(:),   pl,   pr)
    fd = wiggle_detector(p(2:5))
  end subroutine interp6


  !$dir inline
  attributes(device) subroutine interp4(id_accuracy, rho,  u,  v, p, &
                                                     rhol, ul, vl, pl, &
                                                     rhor, ur, vr, pr, fd)
    integer(4), intent(in), value :: id_accuracy
    real(8), intent(in), contiguous :: rho(4), u(4), v(4), p(4)
    real(8), intent(out)            :: rhol, ul, vl, pl
    real(8), intent(out)            :: rhor, ur, vr, pr
    real(sp), intent(inout)         :: fd
    call delta4(fd, rho(:), rhol, rhor)
    call delta4(fd,   u(:),   ul,   ur)
    call delta4(fd,   v(:),   vl,   vr)
    call delta4(fd,   p(:),   pl,   pr)
    fd = wiggle_detector(p(:))
  end subroutine interp4


  !$dir inline
  attributes(device) subroutine interp2(id_accuracy, rho,  u,  v,  p, &
                                                     rhol, ul, vl, pl, &
                                                     rhor, ur, vr, pr, fd)
    integer(2), intent(in), value :: id_accuracy
    real(8), intent(in), contiguous :: rho(2), u(2), v(2), p(2)
    real(8), intent(out)            :: rhol, ul, vl, pl
    real(8), intent(out)            :: rhor, ur, vr, pr
    real(sp), intent(inout)         :: fd
    rhol = rho(1); rhor = rho(2)
      ul =   u(1);   ur =   u(2)
      vl =   v(1);   vr =   v(2)
      pl =   p(1);   pr =   p(2)
      fd = 1.0_sp
  end subroutine interp2


  attributes(global) subroutine calc_slau_x_in(nx, ny, Q_1, Q_2, Q_3, Q_4, sensor, E)
    use mod_constant, only : Normal_x
    integer, intent(in), value                :: nx, ny
    real(8), intent(in), device, contiguous   :: Q_1(nx,ny), Q_2(nx,ny), Q_3(nx,ny), Q_4(nx,ny)
    real(sp), intent(in), device, contiguous  :: sensor(nx,ny)
    real(8), intent(out), device, contiguous  :: E(nx-1,ny-2,4)
    integer i, j, it, jt, ii, i_base, idx, idx_r, offset_yz, offset_yzr, i1, i2
    integer, parameter :: sx  = threadsE%x + 2*io + 1
    integer, parameter :: sxr = threadsE%x
    integer, parameter :: sy  = threadsE%y
    real(8), dimension(-(io-1):sx*sy-io), shared :: rho,  u,  v,  p
    real(8), dimension(sxr*sy), shared           :: rhor, ur, vr, pr
    real(8) rhol, ul, vl, pl
    real(sp) fdx
    it = threadIdx%x
    jt = threadIdx%y
    j  = (blockIdx%y-1)*blockDim%y + jt + 1
    i_base     = (blockIdx%x-1)*blockDim%x
    offset_yz  = (jt-1) * sx
    offset_yzr = (jt-1) * sxr
    do ii = it-io, threadsE%x+io+1, blockDim%x
      i = i_base + ii
      if (i >= 1 .and. i <= nx .and. j >= 1 .and. j <= ny) then
        idx = ii + offset_yz
        rho(idx) = Q_1(i,j); u(idx) = Q_2(i,j); v(idx) = Q_3(i,j); p(idx) = Q_4(i,j)
      endif
    enddo
    call syncthreads()
    i = (blockIdx%x-1)*blockDim%x + it
    if (io+1 <= i .and. i <= nx-(io+1) .and. j <= ny-1) then
      idx   = it + offset_yz
      idx_r = it + offset_yzr
      i1    = idx - io
      i2    = idx + io + 1
      fdx   = 0.50_sp * (sensor(i,j) + sensor(i+1,j))
      call interp(id_acc, &
                  rho(i1:i2),  u(i1:i2),  v(i1:i2), p(i1:i2), &
                  rhol,        ul,        vl,       pl, &
                  rhor(idx_r), ur(idx_r), vr(idx_r), pr(idx_r), fdx)
    endif
    call syncthreads()
    if (io+1 <= i .and. i <= nx-(io+1) .and. j <= ny-1) then
      rho(idx) = rhol; u(idx) = ul; v(idx) = vl; p(idx) = pl
      associate(un1 => u(idx), un2 => ur(idx_r))
        call SLAU(id_slau, rho(idx), rhor(idx_r), u(idx), ur(idx_r), v(idx), vr(idx_r), &
                  un1, un2, p(idx), pr(idx_r), Normal_x, fdx, &
                  E(i,j-1,1), E(i,j-1,2), E(i,j-1,3), E(i,j-1,4))
      end associate
    endif
  end subroutine calc_slau_x_in


  attributes(global) subroutine calc_slau_y_in(nx, ny, Q_1, Q_2, Q_3, Q_4, sensor, F)
    use mod_constant, only : Normal_y
    integer, intent(in), value                :: nx, ny
    real(8), intent(in), device, contiguous   :: Q_1(nx,ny), Q_2(nx,ny), Q_3(nx,ny), Q_4(nx,ny)
    real(sp), intent(in), device, contiguous  :: sensor(nx,ny)
    real(8), intent(out), device, contiguous  :: F(nx-2,ny-1,4)
    integer i, j, it, jt, jj, j_base, idx, idx_r, offset_xz, offset_xzr, i1, i2
    integer, parameter :: sx  = threadsF%x
    integer, parameter :: sy  = threadsF%y + 2*io + 1
    integer, parameter :: syr = threadsF%y
    real(8), dimension(-(io-1):sx*sy-io), shared :: rho,  u,  v,  p
    real(8), dimension(sx*syr), shared           :: rhor, ur, vr, pr
    real(8) rhol, ul, vl, pl
    real(sp) fdy
    it = threadIdx%x
    jt = threadIdx%y
    i  = (blockIdx%x-1)*blockDim%x + it + 1
    j_base     = (blockIdx%y-1)*blockDim%y
    offset_xz  = (it-1) * sy
    offset_xzr = (it-1) * syr
    do jj = jt-io, threadsF%y+io+1, blockDim%y
      j = j_base + jj
      if (i >= 1 .and. i <= nx .and. j >= 1 .and. j <= ny) then
        idx = jj + offset_xz
        rho(idx) = Q_1(i,j); u(idx) = Q_2(i,j); v(idx) = Q_3(i,j); p(idx) = Q_4(i,j)
      endif
    enddo
    call syncthreads()
    j = (blockIdx%y-1)*blockDim%y + jt
    if (io+1 <= j .and. j <= ny-(io+1) .and. i <= nx-1) then
      idx   = jt + offset_xz
      idx_r = jt + offset_xzr
      i1    = idx - io
      i2    = idx + io + 1
      fdy   = 0.50_sp * (sensor(i,j) + sensor(i,j+1))
      call interp(id_acc, &
                  rho(i1:i2),  u(i1:i2),  v(i1:i2), p(i1:i2), &
                  rhol,        ul,        vl,        pl, &
                  rhor(idx_r), ur(idx_r), vr(idx_r), pr(idx_r), fdy)
    endif
    call syncthreads()
    if (io+1 <= j .and. j <= ny-(io+1) .and. i <= nx-1) then
      rho(idx) = rhol; u(idx) = ul; v(idx) = vl; p(idx) = pl
      associate(un1 => v(idx), un2 => vr(idx_r))
        call SLAU(id_slau, rho(idx), rhor(idx_r), u(idx), ur(idx_r), v(idx), vr(idx_r), &
                  un1, un2, p(idx), pr(idx_r), Normal_y, fdy, &
                  F(i-1,j,1), F(i-1,j,2), F(i-1,j,3), F(i-1,j,4))
      end associate
    endif
  end subroutine calc_slau_y_in
end module calc_slau_kernel_internal
