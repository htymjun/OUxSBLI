#:include 'prec.fypp'
#:block fp
module calc_visc2
  use mod_globals, only : gamma, R, Pr, Prt, dt, threadsEv, threadsFv
  use mod_constant, only : Cp, gamma_1, Cp_over_Pr, one_third, two_third
  use libm
  use load_smem_visc2
  implicit none
  private
  public calc_Ev2, calc_Fv2
contains
  attributes(global) subroutine calc_Ev2(nx, ny, dx, dy, Q_2, Q_3, T, mu, E)
    integer, intent(in), value                 :: nx
    integer, intent(in), value                 :: ny
    ${WT}$, intent(in), device, contiguous    :: dx(nx-1)
    ${WT}$, intent(in), device, contiguous    :: dy(ny-1)
    ${RT}$, intent(in), device, contiguous    :: Q_2(nx,ny)
    ${RT}$, intent(in), device, contiguous    :: Q_3(nx,ny)
    ${RT}$, intent(in), device, contiguous    :: T(nx,ny)
    ${RT}$, intent(in), device, contiguous    :: mu(nx,ny)
    ${RT}$, intent(inout), device, contiguous :: E(nx-1,ny-2,4)
    integer, parameter :: sx = threadsEv%x + 1
    integer, parameter :: sy = threadsEv%y
    ${RT}$, dimension(0:sx*sy-1), shared :: u, v
    integer i, j, it, jt, idx
    ${RT}$ viscous_work, txx, txy
    ${RT}$ mux, mvx, muy, mvy
    it = threadIdx%x
    jt = threadIdx%y
    i  = (blockIdx%x-1)*blockDim%x + it
    j  = (blockIdx%y-1)*blockDim%y + jt + 1
    idx = (it-1) + (jt-1)*sx
    call load_smem_visc2_x(it, jt, j, idx, nx, ny, Q_2, Q_3, u, v)
    if (nx-1 < i .or. ny-1 < j) return
    block
      ${RT}$ mudx
      mudx         = 0.5d0 * (mu(i,j) + mu(i+1,j)) * dx(i)
      viscous_work = Cp_over_Pr * mudx * (-T(i,j) + T(i+1,j))
      mux          = mudx * (-u(idx) + u(idx+1))
      mvx          = mudx * (-v(idx) + v(idx+1))
    end block
    block
      ${RT}$ my1, my2, tmp
      ${RT}$ mui, muip1, mu_i_jm1, mu_ip1_jm1, mu_i_jp1, mu_ip1_jp1
      ${RT}$ au, bu
      mui        = mu(i,j)
      muip1      = mu(i+1,j)
      ! corner neighbours below are each read exactly once by this thread: __ldcs
      mu_i_jm1   = ${LDCS}$(mu(i,j-1))
      mu_ip1_jm1 = ${LDCS}$(mu(i+1,j-1))
      mu_i_jp1   = ${LDCS}$(mu(i,j+1))
      mu_ip1_jp1 = ${LDCS}$(mu(i+1,j+1))
      my1 = 0.0625d0 * (mu_i_jm1 + mui + mu_ip1_jm1 + muip1) ! my / 4
      my2 = 0.0625d0 * (mui + mu_i_jp1 + muip1 + mu_ip1_jp1) ! my / 4
      ! each Q neighbour below is read exactly once by this thread: __ldcs
      au  = -${LDCS}$(Q_2(i,j-1)) - ${LDCS}$(Q_2(i+1,j-1))
      bu  =  ${LDCS}$(Q_2(i,j+1)) + ${LDCS}$(Q_2(i+1,j+1))
      tmp = fma(my1, au, (my1 - my2) * (u(idx) + u(idx+1)))
      muy = fma(my2, bu, tmp) * dy(j)
      au  = -${LDCS}$(Q_3(i,j-1)) - ${LDCS}$(Q_3(i+1,j-1))
      bu  =  ${LDCS}$(Q_3(i,j+1)) + ${LDCS}$(Q_3(i+1,j+1))
      tmp = fma(my1, au, (my1 - my2) * (v(idx) + v(idx+1)))
      mvy = fma(my2, bu, tmp) * dy(j)
    end block
    txx = two_third * fma(2.d0, mux, -mvy)
    txy = muy + mvx
    block
      ${RT}$ au, av
      au = u(idx) + u(idx+1)
      av = v(idx) + v(idx+1)
      viscous_work = viscous_work + 0.5d0 * fma(au, txx, av * txy)
    end block
    block
      ${RT}$ Eold
      ! no other thread reads this address before the paired store below overwrites it: __ldlu
      Eold = ${LDLU}$(E(i,j-1,2))
      call ${STCG}$(E(i,j-1,2), Eold - txx)
      Eold = ${LDLU}$(E(i,j-1,3))
      call ${STCG}$(E(i,j-1,3), Eold - txy)
      Eold = ${LDLU}$(E(i,j-1,4))
      call ${STCG}$(E(i,j-1,4), Eold - viscous_work)
    end block
  end subroutine calc_Ev2


  attributes(global) subroutine calc_Fv2(nx, ny, dy, dx, Q_2, Q_3, T, mu, F)
    integer, intent(in), value                 :: nx
    integer, intent(in), value                 :: ny
    ${WT}$, intent(in), device, contiguous    :: dy(ny-1)
    ${WT}$, intent(in), device, contiguous    :: dx(nx-1)
    ${RT}$, intent(in), device, contiguous    :: Q_2(nx,ny)
    ${RT}$, intent(in), device, contiguous    :: Q_3(nx,ny)
    ${RT}$, intent(in), device, contiguous    :: T(nx,ny)
    ${RT}$, intent(in), device, contiguous    :: mu(nx,ny)
    ${RT}$, intent(inout), device, contiguous :: F(nx-2,ny-1,4)
    integer, parameter :: sx = threadsFv%x
    integer, parameter :: sy = threadsFv%y + 1
    ${RT}$, dimension(0:sx*sy-1), shared :: u, v
    integer i, j, it, jt, idx
    ${RT}$ viscous_work, tyx, tyy
    ${RT}$ muy, mvy, mux, mvx
    it = threadIdx%x
    jt = threadIdx%y
    i  = (blockIdx%x-1)*blockDim%x + it + 1
    j  = (blockIdx%y-1)*blockDim%y + jt
    idx = (jt-1) + (it-1)*sy
    call load_smem_visc2_y(it, jt, i, idx, nx, ny, Q_2, Q_3, u, v)
    if (nx-1 < i .or. ny-1 < j) return
    block
      ${RT}$ mudy, muij, muijp1, Tij, Tijp1
      muij   = mu(i,j)
      muijp1 = mu(i,j+1)
      Tij    = T(i,j)
      Tijp1  = T(i,j+1)
      mudy         = 0.5d0 * (muij + muijp1) * dy(j)
      viscous_work = Cp_over_Pr * mudy * (-Tij + Tijp1)
      muy          = mudy * (-u(idx) + u(idx+1))
      mvy          = mudy * (-v(idx) + v(idx+1))
    end block
    block
      ${RT}$ mx1, mx2, tmp
      ${RT}$ muij, muip1j, mu_im1_j, mu_im1_jp1, mu_ip1_jp1, mu_i_jp1
      ${RT}$ au, bu
      muij       = mu(i,j)
      mu_i_jp1   = mu(i,j+1)
      ! corner neighbours below are each read exactly once by this thread: __ldcs
      muip1j     = ${LDCS}$(mu(i+1,j))
      mu_im1_j   = ${LDCS}$(mu(i-1,j))
      mu_im1_jp1 = ${LDCS}$(mu(i-1,j+1))
      mu_ip1_jp1 = ${LDCS}$(mu(i+1,j+1))
      mx1 = 0.0625d0 * (mu_im1_j + muij + mu_im1_jp1 + mu_i_jp1) ! mx / 4
      mx2 = 0.0625d0 * (muij + muip1j + mu_i_jp1 + mu_ip1_jp1)   ! mx / 4
      ! each Q neighbour below is read exactly once by this thread: __ldcs
      au  = -${LDCS}$(Q_2(i-1,j)) - ${LDCS}$(Q_2(i-1,j+1))
      bu  =  ${LDCS}$(Q_2(i+1,j)) + ${LDCS}$(Q_2(i+1,j+1))
      tmp = fma(mx1, au, (mx1 - mx2) * (u(idx) + u(idx+1)))
      mux = fma(mx2, bu, tmp) * dx(i)
      au  = -${LDCS}$(Q_3(i-1,j)) - ${LDCS}$(Q_3(i-1,j+1))
      bu  =  ${LDCS}$(Q_3(i+1,j)) + ${LDCS}$(Q_3(i+1,j+1))
      tmp = fma(mx1, au, (mx1 - mx2) * (v(idx) + v(idx+1)))
      mvx = fma(mx2, bu, tmp) * dx(i)
    end block
    tyx = muy + mvx
    tyy = two_third * fma(2.d0, mvy, -mux)
    block
      ${RT}$ au, av
      au = u(idx) + u(idx+1)
      av = v(idx) + v(idx+1)
      viscous_work = viscous_work + 0.5d0 * fma(au, tyx, av * tyy)
    end block
    block
      ${RT}$ Fold
      ! no other thread reads this address before the paired store below overwrites it: __ldlu
      Fold = ${LDLU}$(F(i-1,j,2))
      call ${STCG}$(F(i-1,j,2), Fold - tyx)
      Fold = ${LDLU}$(F(i-1,j,3))
      call ${STCG}$(F(i-1,j,3), Fold - tyy)
      Fold = ${LDLU}$(F(i-1,j,4))
      call ${STCG}$(F(i-1,j,4), Fold - viscous_work)
    end block
  end subroutine calc_Fv2
end module calc_visc2
#:endblock fp
