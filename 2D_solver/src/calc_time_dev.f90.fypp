!> Module for time-stepping orchestration and time integration schemes
!> Implements 3rd-order and 4th-order Runge-Kutta time stepping with MPI/GPU support
#:include 'prec.fypp'
#! DF: split metric arrays (mod_prec fltw) for calc_EF and the RK3 stages 2 and 3
#:set JEF = 'JacW' if PREC == 'DF' else 'Jacobian'
#:set DTQ = 'dtdx_q, dtdy_q' if PREC == 'DF' else 'dtdx, dtdy'
#:set DT2 = 'dtdx_2, dtdy_2' if PREC == 'DF' else 'dtdx, dtdy'
#:if not defined('VISC_ORDER')
  #:set VISC_ORDER = 4 if ORDER >= 4 else 2
#:endif
#:block fp
module calc_time_dev
#:if PREC == 'DF'
  use mod_prec
#:endif
  use cudafor
  use mpi
  use nvtx
  use mod_globals, only : nt, np, &
  & blocks, threads, blocksE, blocksF, threadsE, threadsF, &
  & blocksEv, blocksFv, threadsEv, threadsFv
  use mod_constant, only : one_third
  use calc_flux_base
  use calc_steps
  use set
  use preprocess
  use print
#:if OUTPUT_RAW
  use io_raw
  use mod_globals, only : dt, step_offset
#:endif
#:if SOURCE
  use calc_source
#:endif
#:if FLUCT
  use mod_rng
  use calc_fluct
  use mod_globals, only : dt, kB, seed, mu0, gamma, R, Pr
  #:if SOURCE
  use mod_globals, only : fric
  #:endif
#:endif
  implicit none
contains
#:if RK == 3
  !> 3rd-order TVD Runge-Kutta time stepping without rescaling
  !> Solves dQ/dt = RHS(Q) using total variation diminishing (TVD) 3-stage scheme
  !> Stages: Q(1) = Q^n + (dt)*RHS(Q^n); Q(2) = (3/4)*Q^n + (1/4)*Q(1) + (1/4)*dt*RHS(Q(1))
  !>         Q^(n+1) = (1/3)*Q^n + (2/3)*Q(2) + (2/3)*dt*RHS(Q(2))
  !> TVD property: |Q^(n+1)|_TV <= |Q^n|_TV prevents spurious oscillations near shocks
  !> GPU computation: Each rank manages one GPU asynchronously; MPI sync only for I/O
  subroutine RungeKutta(myrank, mygpu, nx, ny, x, dx_cpu, y, dy_cpu, Jacobian_cpu, Q)
    integer, intent(in)    :: myrank              !< MPI rank
    integer, intent(in)    :: mygpu               !< GPU index for this rank
    integer, intent(in)    :: nx                  !< x grid dimension
    integer, intent(in)    :: ny                  !< y grid dimension
    real(8), intent(in)    :: x(nx)               !< x coordinates
    real(8), intent(in)    :: dx_cpu(nx-1)        !< inverse x spacing (host)
    real(8), intent(in)    :: y(ny)               !< y coordinates
    real(8), intent(in)    :: dy_cpu(ny-1)        !< inverse y spacing (host)
    real(8), intent(in)    :: Jacobian_cpu(nx,ny) !< Jacobian determinant (host)
    real(8), intent(inout) :: Q(nx,ny,4)          !< conservative variables on host
    integer i, j, k, l, t1, t2, overlap, ierr, nranks, ndevices, stat, ireq, ireq2(2)
    integer istat(MPI_STATUS_SIZE), istat2(MPI_STATUS_SIZE,2)
    ! GPU !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
    ${RT}$, allocatable, device :: Q_1(:,:), Q_2(:,:), Q_3(:,:), Q_4(:,:)
    ${RT}$, allocatable, device :: QJ_1(:,:), QJ_2(:,:), QJ_3(:,:), QJ_4(:,:)
    ${RT}$, allocatable, device :: QJ2_1(:,:), QJ2_2(:,:), QJ2_3(:,:), QJ2_4(:,:)
    ${RT}$, allocatable, device :: E(:,:,:), F(:,:,:)
    ${RT}$, allocatable, device :: T(:,:), mu(:,:), ux(:,:), vy(:,:)
    ${MT}$, allocatable, device :: xix(:), etay(:), dtdx(:), dtdy(:)
    ${WT}$, allocatable, device :: Jacobian(:,:)
#:if PREC == 'DF'
    ! split on the host (mod_prec fltw): Jacobian for calc_EF, dtdx and dtdy times the RK3 stage
    ! weights 1/4 and 2
    type(fltw), allocatable, device :: JacW(:,:), dtdx_q(:), dtdy_q(:), dtdx_2(:), dtdy_2(:)
#:endif
#:if FLUCT
    integer(8) keyA, keyB
    real(4) beta_s, s_mu, s_kap, s_fric
    real(8) dV
#:endif
#:if SOURCE
    ${RT}$, allocatable, device :: Sr(:,:,:), fx(:,:), fy(:,:) ! cell sources (calc_source)
    real(8), allocatable :: fx_cpu(:,:), fy_cpu(:,:)
    ${WT}$ q_cool
#:endif
    ! for plot
    real(4) :: ke0 = 1.d0, entropy0 = 1.d0

    call MPI_COMM_SIZE(MPI_COMM_WORLD, nranks, ierr)
    ! count GPU
    stat = cudaGetDeviceCount(ndevices)
    print *, "rank", myrank, " has found ", ndevices, " GPU devices"
    if (mod(myrank,2) == 0) then
      call check_gpu(mygpu)
      call allocate_device_mem(myrank, nx, ny, dtdx, dtdy, xix, etay, Jacobian, Q_1, Q_2, Q_3, Q_4, T, mu, ux, vy, E, F)
      allocate(QJ_1(nx,ny), QJ_2(nx,ny), QJ_3(nx,ny), QJ_4(nx,ny), &
               QJ2_1(nx,ny), QJ2_2(nx,ny), QJ2_3(nx,ny), QJ2_4(nx,ny), stat=ierr)
      if (ierr /= 0) then
        print *, "myrank is ", myrank, " memory allocation failed", ierr
      else
        print *, "myrank is ", myrank, " memory allocation has completed"
      endif
      call pre_calc(nx, ny, myrank, nranks, x, dx_cpu, y, dy_cpu, Jacobian_cpu, Q, overlap, &
                    dtdx, dtdy, xix, etay, Jacobian, QJ_1, QJ_2, QJ_3, QJ_4, ke0, entropy0)
#:if PREC == 'DF'
      call split_metrics(nx, ny, Jacobian_cpu, dtdx, dtdy, JacW, dtdx_q, dtdy_q, dtdx_2, dtdy_2)
#:endif
#:if SOURCE
      ! body force per unit mass, tabulated by the case (set_force in set.f90)
      allocate(Sr(nx-2,ny-2,4), fx(nx,ny), fy(nx,ny), fx_cpu(nx,ny), fy_cpu(nx,ny))
      call set_force(nx, ny, x, y, fx_cpu, fy_cpu)
      fx = fx_cpu
      fy = fy_cpu
      Sr = 0.d0
      q_cool = 0.d0
      deallocate(fx_cpu, fy_cpu)
#:endif
#:if FLUCT
      ! FP32 noise amplitudes (calc_fluct, calc_source); uniform cell volume dV
      dV     = 1.d0 / Jacobian_cpu(${ORDER // 2 + 1}$, ${ORDER // 2 + 1}$)
      s_mu   = real(2.d0 * kB * mu0 / (dV * dt), 4)
      s_kap  = real(sqrt(2.d0 * kB * mu0 * gamma * R / ((gamma - 1.d0) * Pr) / (dV * dt)), 4)
  #:if SOURCE
      s_fric = real(2.d0 * fric * kB / (dV * dt), 4)
  #:endif
#:endif
      QJ2_1 = QJ_1; QJ2_2 = QJ_2; QJ2_3 = QJ_3; QJ2_4 = QJ_4 ! initialize QJ2
    else
      call MPI_RECV(ke0,      1, MPI_REAL4, myrank-1, 3*myrank+1, MPI_COMM_WORLD, istat, ierr)
      call MPI_RECV(entropy0, 1, MPI_REAL4, myrank-1, 3*myrank+2, MPI_COMM_WORLD, istat, ierr)
    endif

    !> Time integration main loop with MPI domain decomposition
    !> Each rank computes assigned 2D subdomain on dedicated GPU independently
    !> Synchronization points: (1) end of each time integration step for boundary exchange
    !>                         (2) after every np iterations for I/O and statistics
    !> CFL constraint: dt = CFL * min_grid_spacing / max_wave_speed
    call MPI_BARRIER(MPI_COMM_WORLD, ierr)
    print *, "myrank is ", myrank, " start Runge-Kutta"
    do t2 = 1, np
      if (mod(myrank,2) == 0) then
        ! GPU-accelerated ranks perform time integration
        do t1 = 1, nt
          ! Step 1: Compute fluxes E, F from current state QJ
          call calc_EF(nx, ny, xix, etay, ${JEF}$, QJ_1, QJ_2, QJ_3, QJ_4, Q_1, Q_2, Q_3, Q_4, T, mu, ux, vy, E, F)
#:if FLUCT
          ! stochastic fluxes of stage 1 (stage noise W = xi_A + beta xi_B, mod_rng)
          call stage_keys(int(seed, 8), rng_step0 + int(t2-1, 8) * nt + (t1-1), 1, keyA, keyB, beta_s)
          call calc_Efluct<<<blocksE,threadsE>>>(nx, ny, Q_2, Q_3, T, E, s_mu, s_kap, keyA, keyB, beta_s)
          call calc_Ffluct<<<blocksF,threadsF>>>(nx, ny, Q_2, Q_3, T, F, s_mu, s_kap, keyA, keyB, beta_s)
#:endif
#:if SOURCE
          call calc_cooling(nx, ny, Q_4, q_cool)
#:if FLUCT
          call calc_source_term<<<blocks,threads>>>(nx, ny, Jacobian, Q_1, Q_2, Q_3, fx, fy, q_cool, Sr, &
                                                    T, s_fric, keyA, keyB, beta_s)
#:else
          call calc_source_term<<<blocks,threads>>>(nx, ny, Jacobian, Q_1, Q_2, Q_3, fx, fy, q_cool, Sr)
#:endif
#:endif
          ! Step 2a: TVD RK3 Stage 1 - compute Q(1), store in QJ2
#:if SOURCE
          call calc_step1<<<blocks,threads>>>(nx, ny, ${KACT('1.d0')}$, dtdx, dtdy, E, F, Sr, &
                                              QJ_1, QJ_2, QJ_3, QJ_4, QJ2_1, QJ2_2, QJ2_3, QJ2_4)
#:else
          call calc_step1<<<blocks,threads>>>(nx, ny, ${KACT('1.d0')}$, dtdx, dtdy, E, F, QJ_1, QJ_2, QJ_3, QJ_4, QJ2_1, QJ2_2, QJ2_3, QJ2_4)
#:endif
          ! Enforce boundary conditions at cell interfaces (extrapolation or characteristic-based)
          call set_bc(myrank, nx, ny, Jacobian, QJ2_1, QJ2_2, QJ2_3, QJ2_4)

          ! Step 2b: TVD RK3 Stage 2 - blend Q(1) with Q^n, store in QJ2
          call calc_EF(nx, ny, xix, etay, ${JEF}$, QJ2_1, QJ2_2, QJ2_3, QJ2_4, Q_1, Q_2, Q_3, Q_4, T, mu, ux, vy, E, F)
#:if FLUCT
          ! stochastic fluxes of stage 2 (stage noise W = xi_A + beta xi_B, mod_rng)
          call stage_keys(int(seed, 8), rng_step0 + int(t2-1, 8) * nt + (t1-1), 2, keyA, keyB, beta_s)
          call calc_Efluct<<<blocksE,threadsE>>>(nx, ny, Q_2, Q_3, T, E, s_mu, s_kap, keyA, keyB, beta_s)
          call calc_Ffluct<<<blocksF,threadsF>>>(nx, ny, Q_2, Q_3, T, F, s_mu, s_kap, keyA, keyB, beta_s)
#:endif
#:if SOURCE
#:if FLUCT
          call calc_source_term<<<blocks,threads>>>(nx, ny, Jacobian, Q_1, Q_2, Q_3, fx, fy, q_cool, Sr, &
                                                    T, s_fric, keyA, keyB, beta_s)
#:else
          call calc_source_term<<<blocks,threads>>>(nx, ny, Jacobian, Q_1, Q_2, Q_3, fx, fy, q_cool, Sr)
#:endif
#:endif
#:if SOURCE
          call calc_step2_3<<<blocks,threads>>>(nx, ny, ${KACT('0.75d0')}$, ${KACT('0.25d0')}$, ${KACT('0.25d0')}$, ${KACT('1.d0')}$, ${DTQ}$, E, F, Sr, &
                                                 QJ_1, QJ_2, QJ_3, QJ_4, QJ2_1, QJ2_2, QJ2_3, QJ2_4)
#:else
          call calc_step2_3<<<blocks,threads>>>(nx, ny, ${KACT('0.75d0')}$, ${KACT('0.25d0')}$, ${KACT('0.25d0')}$, ${KACT('1.d0')}$, ${DTQ}$, E, F, &
                                                 QJ_1, QJ_2, QJ_3, QJ_4, QJ2_1, QJ2_2, QJ2_3, QJ2_4)
#:endif
          call set_bc(myrank, nx, ny, Jacobian, QJ2_1, QJ2_2, QJ2_3, QJ2_4)

          ! Step 2c: TVD RK3 Stage 3 - final solution Q^(n+1), store in QJ (swap arrays)
          call calc_EF(nx, ny, xix, etay, ${JEF}$, QJ2_1, QJ2_2, QJ2_3, QJ2_4, Q_1, Q_2, Q_3, Q_4, T, mu, ux, vy, E, F)
#:if FLUCT
          ! stochastic fluxes of stage 3 (stage noise W = xi_A + beta xi_B, mod_rng)
          call stage_keys(int(seed, 8), rng_step0 + int(t2-1, 8) * nt + (t1-1), 3, keyA, keyB, beta_s)
          call calc_Efluct<<<blocksE,threadsE>>>(nx, ny, Q_2, Q_3, T, E, s_mu, s_kap, keyA, keyB, beta_s)
          call calc_Ffluct<<<blocksF,threadsF>>>(nx, ny, Q_2, Q_3, T, F, s_mu, s_kap, keyA, keyB, beta_s)
#:endif
#:if SOURCE
#:if FLUCT
          call calc_source_term<<<blocks,threads>>>(nx, ny, Jacobian, Q_1, Q_2, Q_3, fx, fy, q_cool, Sr, &
                                                    T, s_fric, keyA, keyB, beta_s)
#:else
          call calc_source_term<<<blocks,threads>>>(nx, ny, Jacobian, Q_1, Q_2, Q_3, fx, fy, q_cool, Sr)
#:endif
#:endif
#:if SOURCE
          call calc_step2_3<<<blocks,threads>>>(nx, ny, ${KACT('2.d0')}$, ${KACT('1.d0')}$, ${KACT('2.d0')}$, ${KACT('one_third')}$, ${DT2}$, E, F, Sr, &
                                                 QJ2_1, QJ2_2, QJ2_3, QJ2_4, QJ_1, QJ_2, QJ_3, QJ_4)
#:else
          call calc_step2_3<<<blocks,threads>>>(nx, ny, ${KACT('2.d0')}$, ${KACT('1.d0')}$, ${KACT('2.d0')}$, ${KACT('one_third')}$, ${DT2}$, E, F, &
                                                 QJ2_1, QJ2_2, QJ2_3, QJ2_4, QJ_1, QJ_2, QJ_3, QJ_4)
#:endif
          call set_bc(myrank, nx, ny, Jacobian, QJ_1, QJ_2, QJ_3, QJ_4)
        enddo
      endif

      if (mod(myrank, 2) == 0) then
#:if OUTPUT_RAW
        ! raw state of the interior (io_raw); the odd rank writes nothing
        Q(:,:,1) = QJ_1
        Q(:,:,2) = QJ_2
        Q(:,:,3) = QJ_3
        Q(:,:,4) = QJ_4
        call write_raw(t2 + step_offset, dble(t2) * dble(nt) * dt, t2 * nt, nx, ny, Jacobian_cpu, Q)
#:else
        call send_recv_for_print_even(myrank, nranks, t2, nx, ny, x, y, Jacobian_cpu, QJ_1, QJ_2, QJ_3, QJ_4, Q, ke0, entropy0)
#:endif
      else
#:if not OUTPUT_RAW
        call send_recv_for_print_odd(myrank, nranks, t2, nx, ny, x, y, Jacobian_cpu, Q, ke0, entropy0)
#:endif
      endif
    enddo

    if (mod(myrank,2) == 0) then
      deallocate(Q_1, Q_2, Q_3, Q_4, T, mu, ux, vy, QJ_1, QJ_2, QJ_3, QJ_4, QJ2_1, QJ2_2, QJ2_3, QJ2_4, &
                 E, F, xix, etay, Jacobian, dtdx, dtdy)
#:if PREC == 'DF'
      deallocate(JacW, dtdx_q, dtdy_q, dtdx_2, dtdy_2)
#:endif
#:if SOURCE
      deallocate(Sr, fx, fy)
#:endif
    endif
    print *, "myrank is ", myrank, " deallocate GPU memory"
  end subroutine RungeKutta
#:else
  !> 4th-order classical Runge-Kutta time stepping without rescaling
  !> Solves dQ/dt = RHS(Q) using standard 4-stage RK4 scheme
  !> Stages: k1 = RHS(Q^n); k2 = RHS(Q^n + 0.5*dt*k1); k3 = RHS(Q^n + 0.5*dt*k2)
  !>         k4 = RHS(Q^n + dt*k3); Q^(n+1) = Q^n + (dt/6)*(k1 + 2*k2 + 2*k3 + k4)
  !> More accurate than RK3 but lacks TVD property; requires smaller CFL (~0.8 vs 1.0)
  subroutine RungeKutta(myrank, mygpu, nx, ny, x, dx_cpu, y, dy_cpu, Jacobian_cpu, Q)
    integer, intent(in)    :: myrank              !< MPI rank
    integer, intent(in)    :: mygpu               !< GPU index for this rank
    integer, intent(in)    :: nx                  !< x grid dimension
    integer, intent(in)    :: ny                  !< y grid dimension
    real(8), intent(in)    :: x(nx)               !< x coordinates
    real(8), intent(in)    :: dx_cpu(nx-1)        !< inverse x spacing (host)
    real(8), intent(in)    :: y(ny)               !< y coordinates
    real(8), intent(in)    :: dy_cpu(ny-1)        !< inverse y spacing (host)
    real(8), intent(in)    :: Jacobian_cpu(nx,ny) !< Jacobian determinant (host)
    real(8), intent(inout) :: Q(nx,ny,4)          !< conservative variables on host
    integer i, j, k, l, t1, t2, overlap, ierr, nranks, ndevices, stat, ireq, ireq2(2)
    integer istat(MPI_STATUS_SIZE), istat2(MPI_STATUS_SIZE,2)
    ! GPU !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
    ${RT}$, allocatable, device :: Q_1(:,:), Q_2(:,:), Q_3(:,:), Q_4(:,:)
    ${RT}$, allocatable, device :: QJ_1(:,:), QJ_2(:,:), QJ_3(:,:), QJ_4(:,:)
    ${RT}$, allocatable, device :: QJs_1(:,:), QJs_2(:,:), QJs_3(:,:), QJs_4(:,:)
    ${RT}$, allocatable, device :: Rs(:,:,:)
    ${RT}$, allocatable, device :: E(:,:,:), F(:,:,:)
    ${RT}$, allocatable, device :: T(:,:), mu(:,:), ux(:,:), vy(:,:)
    ${MT}$, allocatable, device :: xix(:), etay(:), dtdx(:), dtdy(:)
    ${WT}$, allocatable, device :: Jacobian(:,:)
#:if PREC == 'DF'
    ! split on the host (mod_prec fltw): Jacobian for calc_EF, dtdx and dtdy times the RK3 stage
    ! weights 1/4 and 2
    type(fltw), allocatable, device :: JacW(:,:), dtdx_q(:), dtdy_q(:), dtdx_2(:), dtdy_2(:)
#:endif
#:if SOURCE
    ${RT}$, allocatable, device :: Sr(:,:,:), fx(:,:), fy(:,:) ! cell sources (calc_source)
    real(8), allocatable :: fx_cpu(:,:), fy_cpu(:,:)
    ${WT}$ q_cool
#:endif
    ! for plot
    real(4) :: ke0 = 1.d0, entropy0 = 1.d0

    call MPI_COMM_SIZE(MPI_COMM_WORLD, nranks, ierr)
    ! count GPU
    stat = cudaGetDeviceCount(ndevices)
    if (myrank == 0) then
      print '(2x, i2, a)', ndevices, " GPU devices are found"
    endif
    if (mod(myrank,2) == 0) then
      call check_gpu(mygpu)
      call allocate_device_mem(myrank, nx, ny, dtdx, dtdy, xix, etay, Jacobian, Q_1, Q_2, Q_3, Q_4, T, mu, ux, vy, E, F)
      allocate(QJ_1(nx,ny), QJ_2(nx,ny), QJ_3(nx,ny), QJ_4(nx,ny), &
               QJs_1(nx,ny), QJs_2(nx,ny), QJs_3(nx,ny), QJs_4(nx,ny), Rs(nx-2,ny-2,4))
      print *, "myrank is ", myrank, " memory allocation has completed"
      call pre_calc(nx, ny, myrank, nranks, x, dx_cpu, y, dy_cpu, Jacobian_cpu, Q, overlap, &
                    dtdx, dtdy, xix, etay, Jacobian, QJ_1, QJ_2, QJ_3, QJ_4, ke0, entropy0)
#:if PREC == 'DF'
      call split_metrics(nx, ny, Jacobian_cpu, dtdx, dtdy, JacW, dtdx_q, dtdy_q, dtdx_2, dtdy_2)
#:endif
#:if SOURCE
      ! body force per unit mass, tabulated by the case (set_force in set.f90)
      allocate(Sr(nx-2,ny-2,4), fx(nx,ny), fy(nx,ny), fx_cpu(nx,ny), fy_cpu(nx,ny))
      call set_force(nx, ny, x, y, fx_cpu, fy_cpu)
      fx = fx_cpu
      fy = fy_cpu
      Sr = 0.d0
      q_cool = 0.d0
      deallocate(fx_cpu, fy_cpu)
#:endif
      Rs = 0.d0
      QJs_1 = QJ_1; QJs_2 = QJ_2; QJs_3 = QJ_3; QJs_4 = QJ_4 ! initialize QJs
    else
      call MPI_RECV(ke0,      1, MPI_REAL4, myrank-1, 3*myrank+1, MPI_COMM_WORLD, istat, ierr)
      call MPI_RECV(entropy0, 1, MPI_REAL4, myrank-1, 3*myrank+2, MPI_COMM_WORLD, istat, ierr)
    endif

    !> 4-4 RK main integration loop with residual accumulation
    !> Stages 1-3: compute fluxes and update intermediate solutions, accumulate residuals in Rs
    !> Stage 4: final flux computation and assembly of weighted sum Q^(n+1) = Q^n - (1/6)*sum(R_i)
    call MPI_BARRIER(MPI_COMM_WORLD, ierr)
    print *, "myrank is ", myrank, " start Runge-Kutta"
    do t2 = 1, np
      if (mod(myrank,2) == 0) then
        do t1 = 1, nt
          ! Stage 1: k1 = RHS(Q^n), coefficients: 0.5*dt applied, weight 1.0 to Rs
          call calc_EF(nx, ny, xix, etay, ${JEF}$, QJ_1, QJ_2, QJ_3, QJ_4, Q_1, Q_2, Q_3, Q_4, T, mu, ux, vy, E, F)
#:if SOURCE
          call calc_cooling(nx, ny, Q_4, q_cool)
          call calc_source_term<<<blocks,threads>>>(nx, ny, Jacobian, Q_1, Q_2, Q_3, fx, fy, q_cool, Sr)
#:endif
#:if SOURCE
          call calc_step<<<blocks,threads>>>(nx, ny, ${KACT('0.5d0')}$, ${KACT('1.d0')}$, dtdx, dtdy, E, F, Sr, &
                                              QJ_1, QJ_2, QJ_3, QJ_4, QJs_1, QJs_2, QJs_3, QJs_4, Rs) ! QJs = Q2 = Q^n + 0.5*dt*k1
#:else
          call calc_step<<<blocks,threads>>>(nx, ny, ${KACT('0.5d0')}$, ${KACT('1.d0')}$, dtdx, dtdy, E, F, &
                                              QJ_1, QJ_2, QJ_3, QJ_4, QJs_1, QJs_2, QJs_3, QJs_4, Rs) ! QJs = Q2 = Q^n + 0.5*dt*k1
#:endif
          call set_bc(myrank, nx, ny, Jacobian, QJs_1, QJs_2, QJs_3, QJs_4)

          ! Stage 2: k2 = RHS(Q^n + 0.5*dt*k1), weight 2.0 to Rs for (2*k2 term)
          call calc_EF(nx, ny, xix, etay, ${JEF}$, QJs_1, QJs_2, QJs_3, QJs_4, Q_1, Q_2, Q_3, Q_4, T, mu, ux, vy, E, F)
#:if SOURCE
          call calc_source_term<<<blocks,threads>>>(nx, ny, Jacobian, Q_1, Q_2, Q_3, fx, fy, q_cool, Sr)
#:endif
#:if SOURCE
          call calc_step<<<blocks,threads>>>(nx, ny, ${KACT('0.5d0')}$, ${KACT('2.d0')}$, dtdx, dtdy, E, F, Sr, &
                                              QJ_1, QJ_2, QJ_3, QJ_4, QJs_1, QJs_2, QJs_3, QJs_4, Rs) ! QJs = Q3 = Q^n + 0.5*dt*k2
#:else
          call calc_step<<<blocks,threads>>>(nx, ny, ${KACT('0.5d0')}$, ${KACT('2.d0')}$, dtdx, dtdy, E, F, &
                                              QJ_1, QJ_2, QJ_3, QJ_4, QJs_1, QJs_2, QJs_3, QJs_4, Rs) ! QJs = Q3 = Q^n + 0.5*dt*k2
#:endif
          call set_bc(myrank, nx, ny, Jacobian, QJs_1, QJs_2, QJs_3, QJs_4)

          ! Stage 3: k3 = RHS(Q^n + 0.5*dt*k2), weight 2.0 for (2*k3 term)
          call calc_EF(nx, ny, xix, etay, ${JEF}$, QJs_1, QJs_2, QJs_3, QJs_4, Q_1, Q_2, Q_3, Q_4, T, mu, ux, vy, E, F)
#:if SOURCE
          call calc_source_term<<<blocks,threads>>>(nx, ny, Jacobian, Q_1, Q_2, Q_3, fx, fy, q_cool, Sr)
#:endif
#:if SOURCE
          call calc_step<<<blocks,threads>>>(nx, ny, ${KACT('1.0d0')}$, ${KACT('2.d0')}$, dtdx, dtdy, E, F, Sr, &
                                              QJ_1, QJ_2, QJ_3, QJ_4, QJs_1, QJs_2, QJs_3, QJs_4, Rs) ! QJs = Q4 = Q^n + dt*k3
#:else
          call calc_step<<<blocks,threads>>>(nx, ny, ${KACT('1.0d0')}$, ${KACT('2.d0')}$, dtdx, dtdy, E, F, &
                                              QJ_1, QJ_2, QJ_3, QJ_4, QJs_1, QJs_2, QJs_3, QJs_4, Rs) ! QJs = Q4 = Q^n + dt*k3
#:endif
          call set_bc(myrank, nx, ny, Jacobian, QJs_1, QJs_2, QJs_3, QJs_4)

          ! Stage 4: k4 = RHS(Q^n + dt*k3), weight 1.0, assemble final Q^(n+1)
          call calc_EF(nx, ny, xix, etay, ${JEF}$, QJs_1, QJs_2, QJs_3, QJs_4, Q_1, Q_2, Q_3, Q_4, T, mu, ux, vy, E, F)
#:if SOURCE
          call calc_source_term<<<blocks,threads>>>(nx, ny, Jacobian, Q_1, Q_2, Q_3, fx, fy, q_cool, Sr)
#:endif
#:if SOURCE
          call calc_step4<<<blocks,threads>>>(nx, ny, dtdx, dtdy, E, F, Sr, Rs, QJ_1, QJ_2, QJ_3, QJ_4)  ! QJ = Q^(n+1)
#:else
          call calc_step4<<<blocks,threads>>>(nx, ny, dtdx, dtdy, E, F, Rs, QJ_1, QJ_2, QJ_3, QJ_4)  ! QJ = Q^(n+1)
#:endif
          call set_bc(myrank, nx, ny, Jacobian, QJ_1, QJ_2, QJ_3, QJ_4)
        enddo
      endif

      if (mod(myrank, 2) == 0) then
#:if OUTPUT_RAW
        ! raw state of the interior (io_raw); the odd rank writes nothing
        Q(:,:,1) = QJ_1
        Q(:,:,2) = QJ_2
        Q(:,:,3) = QJ_3
        Q(:,:,4) = QJ_4
        call write_raw(t2 + step_offset, dble(t2) * dble(nt) * dt, t2 * nt, nx, ny, Jacobian_cpu, Q)
#:else
        call send_recv_for_print_even(myrank, nranks, t2, nx, ny, x, y, Jacobian_cpu, QJ_1, QJ_2, QJ_3, QJ_4, Q, ke0, entropy0)
#:endif
      else
#:if not OUTPUT_RAW
        call send_recv_for_print_odd(myrank, nranks, t2, nx, ny, x, y, Jacobian_cpu, Q, ke0, entropy0)
#:endif
      endif
    enddo

    if (mod(myrank,2) == 0) then
      deallocate(Q_1, Q_2, Q_3, Q_4, T, mu, ux, vy, QJ_1, QJ_2, QJ_3, QJ_4, QJs_1, QJs_2, QJs_3, QJs_4, Rs, &
                 E, F, xix, etay, Jacobian, dtdx, dtdy)
#:if PREC == 'DF'
      deallocate(JacW, dtdx_q, dtdy_q, dtdx_2, dtdy_2)
#:endif
#:if SOURCE
      deallocate(Sr, fx, fy)
#:endif
    endif
    print *, "myrank is ", myrank, " deallocate GPU memory"
  end subroutine RungeKutta
#:endif
end module calc_time_dev
#:endblock fp
