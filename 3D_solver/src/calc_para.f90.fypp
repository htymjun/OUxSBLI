!> Module for parallel MPI communication and domain decomposition
!> Handles halo exchange, data flattening, and ghost cell synchronization
#:include 'config.fypp'
#:if not defined('MPI')
  #:set MPI = 'CPU'
#:endif
module calc_para
  use mpi
  use cudafor
  implicit none
contains


  subroutine flatten_rescale(nx, ny, nz, nre, overlap, Q_1, Q_2, Q_3, Q_4, Q_5, Q1d_right)
    integer, intent(in), value   :: nx, ny, nz, nre, overlap
    real(8), intent(in), device  :: Q_1(nx,ny,nz), Q_2(nx,ny,nz), Q_3(nx,ny,nz), Q_4(nx,ny,nz), Q_5(nx,ny,nz)
    real(8), intent(out), device :: Q1d_right(overlap*(ny-2)*(nz-6)*5)
    integer i, j, k, ni, nj, nk
    ni = overlap
    nj = ny-2
    nk = nz-6
    !$cuf kernel do(3)<<<*,*>>>
    do k = 1, nk
      do j = 1, nj
        do i = 1, ni
          Q1d_right(nj*ni*5*(k-1)+ni*5*(j-1)+ni*0+i) = Q_1(nre-2*overlap+i,j+1,k+3)
          Q1d_right(nj*ni*5*(k-1)+ni*5*(j-1)+ni*1+i) = Q_2(nre-2*overlap+i,j+1,k+3)
          Q1d_right(nj*ni*5*(k-1)+ni*5*(j-1)+ni*2+i) = Q_3(nre-2*overlap+i,j+1,k+3)
          Q1d_right(nj*ni*5*(k-1)+ni*5*(j-1)+ni*3+i) = Q_4(nre-2*overlap+i,j+1,k+3)
          Q1d_right(nj*ni*5*(k-1)+ni*5*(j-1)+ni*4+i) = Q_5(nre-2*overlap+i,j+1,k+3)
    enddo;enddo;enddo
  end subroutine flatten_rescale


  subroutine reconstruct_sbli_inlet(nx, ny1, ny2, nz, overlap, Q1d, Q_1, Q_2, Q_3, Q_4, Q_5)
    integer, intent(in), value     :: nx, ny1, ny2, nz, overlap
    real(8), intent(in), device    :: Q1d(overlap*(ny1-2)*(nz-6)*5)
    real(8), intent(inout), device :: Q_1(nx,ny2,nz), Q_2(nx,ny2,nz), Q_3(nx,ny2,nz), Q_4(nx,ny2,nz), Q_5(nx,ny2,nz)
    integer i, j, k, ni, nj, nk
    ni = overlap
    nj = ny1-2
    nk = nz-6
    !$cuf kernel do(3)<<<*,*>>>
    do k = 1, nk
      do j = 1, nj
        do i = 1, overlap
          Q_1(i,j+1,k+3) = Q1d(nj*ni*5*(k-1)+ni*5*(j-1)+ni*0+i)
          Q_2(i,j+1,k+3) = Q1d(nj*ni*5*(k-1)+ni*5*(j-1)+ni*1+i)
          Q_3(i,j+1,k+3) = Q1d(nj*ni*5*(k-1)+ni*5*(j-1)+ni*2+i)
          Q_4(i,j+1,k+3) = Q1d(nj*ni*5*(k-1)+ni*5*(j-1)+ni*3+i)
          Q_5(i,j+1,k+3) = Q1d(nj*ni*5*(k-1)+ni*5*(j-1)+ni*4+i)
    enddo;enddo;enddo
  end subroutine reconstruct_sbli_inlet


  !> Pack bottom z interior slab (z=overlap+1..2*overlap) for sending to rank_lo
  subroutine flatten_z_lo(nx, ny, nz, overlap, Q_1, Q_2, Q_3, Q_4, Q_5, Q1d_lo)
    integer, intent(in), value   :: nx, ny, nz, overlap
    real(8), intent(in), device  :: Q_1(nx,ny,nz), Q_2(nx,ny,nz), Q_3(nx,ny,nz), Q_4(nx,ny,nz), Q_5(nx,ny,nz)
    real(8), intent(out), device :: Q1d_lo(nx*ny*overlap*5)
    integer i, j, k
    !$cuf kernel do(3)<<<*,*>>>
    do k = 1, overlap
      do j = 1, ny
        do i = 1, nx
          Q1d_lo(ny*nx*5*(k-1)+nx*5*(j-1)+nx*0+i) = Q_1(i,j,overlap+k)
          Q1d_lo(ny*nx*5*(k-1)+nx*5*(j-1)+nx*1+i) = Q_2(i,j,overlap+k)
          Q1d_lo(ny*nx*5*(k-1)+nx*5*(j-1)+nx*2+i) = Q_3(i,j,overlap+k)
          Q1d_lo(ny*nx*5*(k-1)+nx*5*(j-1)+nx*3+i) = Q_4(i,j,overlap+k)
          Q1d_lo(ny*nx*5*(k-1)+nx*5*(j-1)+nx*4+i) = Q_5(i,j,overlap+k)
    enddo;enddo;enddo
  end subroutine flatten_z_lo


  !> Pack top z interior slab (z=nz-2*overlap+1..nz-overlap) for sending to rank_hi
  subroutine flatten_z_hi(nx, ny, nz, overlap, Q_1, Q_2, Q_3, Q_4, Q_5, Q1d_hi)
    integer, intent(in), value   :: nx, ny, nz, overlap
    real(8), intent(in), device  :: Q_1(nx,ny,nz), Q_2(nx,ny,nz), Q_3(nx,ny,nz), Q_4(nx,ny,nz), Q_5(nx,ny,nz)
    real(8), intent(out), device :: Q1d_hi(nx*ny*overlap*5)
    integer i, j, k
    !$cuf kernel do(3)<<<*,*>>>
    do k = 1, overlap
      do j = 1, ny
        do i = 1, nx
          Q1d_hi(ny*nx*5*(k-1)+nx*5*(j-1)+nx*0+i) = Q_1(i,j,nz-2*overlap+k)
          Q1d_hi(ny*nx*5*(k-1)+nx*5*(j-1)+nx*1+i) = Q_2(i,j,nz-2*overlap+k)
          Q1d_hi(ny*nx*5*(k-1)+nx*5*(j-1)+nx*2+i) = Q_3(i,j,nz-2*overlap+k)
          Q1d_hi(ny*nx*5*(k-1)+nx*5*(j-1)+nx*3+i) = Q_4(i,j,nz-2*overlap+k)
          Q1d_hi(ny*nx*5*(k-1)+nx*5*(j-1)+nx*4+i) = Q_5(i,j,nz-2*overlap+k)
    enddo;enddo;enddo
  end subroutine flatten_z_hi


  !> Fill bottom z ghost cells (z=1..overlap) from data received from rank_lo
  subroutine reconstruct_z_lo(nx, ny, nz, overlap, Q1d_lo, Q_1, Q_2, Q_3, Q_4, Q_5)
    integer, intent(in), value     :: nx, ny, nz, overlap
    real(8), intent(in), device    :: Q1d_lo(nx*ny*overlap*5)
    real(8), intent(inout), device :: Q_1(nx,ny,nz), Q_2(nx,ny,nz), Q_3(nx,ny,nz), Q_4(nx,ny,nz), Q_5(nx,ny,nz)
    integer i, j, k
    !$cuf kernel do(3)<<<*,*>>>
    do k = 1, overlap
      do j = 1, ny
        do i = 1, nx
          Q_1(i,j,k) = Q1d_lo(ny*nx*5*(k-1)+nx*5*(j-1)+nx*0+i)
          Q_2(i,j,k) = Q1d_lo(ny*nx*5*(k-1)+nx*5*(j-1)+nx*1+i)
          Q_3(i,j,k) = Q1d_lo(ny*nx*5*(k-1)+nx*5*(j-1)+nx*2+i)
          Q_4(i,j,k) = Q1d_lo(ny*nx*5*(k-1)+nx*5*(j-1)+nx*3+i)
          Q_5(i,j,k) = Q1d_lo(ny*nx*5*(k-1)+nx*5*(j-1)+nx*4+i)
    enddo;enddo;enddo
  end subroutine reconstruct_z_lo


  !> Fill top z ghost cells (z=nz-overlap+1..nz) from data received from rank_hi
  subroutine reconstruct_z_hi(nx, ny, nz, overlap, Q1d_hi, Q_1, Q_2, Q_3, Q_4, Q_5)
    integer, intent(in), value     :: nx, ny, nz, overlap
    real(8), intent(in), device    :: Q1d_hi(nx*ny*overlap*5)
    real(8), intent(inout), device :: Q_1(nx,ny,nz), Q_2(nx,ny,nz), Q_3(nx,ny,nz), Q_4(nx,ny,nz), Q_5(nx,ny,nz)
    integer i, j, k
    !$cuf kernel do(3)<<<*,*>>>
    do k = 1, overlap
      do j = 1, ny
        do i = 1, nx
          Q_1(i,j,nz-overlap+k) = Q1d_hi(ny*nx*5*(k-1)+nx*5*(j-1)+nx*0+i)
          Q_2(i,j,nz-overlap+k) = Q1d_hi(ny*nx*5*(k-1)+nx*5*(j-1)+nx*1+i)
          Q_3(i,j,nz-overlap+k) = Q1d_hi(ny*nx*5*(k-1)+nx*5*(j-1)+nx*2+i)
          Q_4(i,j,nz-overlap+k) = Q1d_hi(ny*nx*5*(k-1)+nx*5*(j-1)+nx*3+i)
          Q_5(i,j,nz-overlap+k) = Q1d_hi(ny*nx*5*(k-1)+nx*5*(j-1)+nx*4+i)
    enddo;enddo;enddo
  end subroutine reconstruct_z_hi


  !> Post non-blocking z-halo exchange for even/odd compute/IO pattern.
  !> Only even compute ranks call this; neighbors are step=2 apart:
  !>   rank_lo = mod(myrank - 2 + nranks, nranks)
  !>   rank_hi = mod(myrank + 2, nranks)
  !> req(1)=Isend to rank_lo  req(2)=Isend to rank_hi
  !> req(3)=Irecv from rank_lo  req(4)=Irecv from rank_hi
  !> Caller must not modify send_lo/send_hi until after MPI_Waitall on req
  #:if MPI == 'CPU'
  subroutine start_exchange_z(myrank, nranks, overlap, nx, ny, nz, QJ_1, QJ_2, QJ_3, QJ_4, QJ_5, &
                               Qs1d_lo, Qs1d_hi, Qr1d_lo, Qr1d_hi, &
                               send_lo, send_hi, recv_lo, recv_hi, req)
    integer, intent(in)            :: myrank, nranks, overlap, nx, ny, nz
    real(8), intent(in), device    :: QJ_1(nx,ny,nz), QJ_2(nx,ny,nz), QJ_3(nx,ny,nz), QJ_4(nx,ny,nz), QJ_5(nx,ny,nz)
    real(8), intent(inout), device :: Qs1d_lo(nx*ny*overlap*5), Qs1d_hi(nx*ny*overlap*5)
    real(8), intent(inout), device :: Qr1d_lo(nx*ny*overlap*5), Qr1d_hi(nx*ny*overlap*5)
    real(8), intent(inout)         :: send_lo(nx*ny*overlap*5), send_hi(nx*ny*overlap*5)
    real(8), intent(inout)         :: recv_lo(nx*ny*overlap*5), recv_hi(nx*ny*overlap*5)
    integer, intent(out)           :: req(4)
    integer rank_lo, rank_hi, msglen, stat, ierr
    rank_lo = mod(myrank - 2 + nranks, nranks)
    rank_hi = mod(myrank + 2, nranks)
    msglen  = nx * ny * overlap * 5
    call flatten_z_lo(nx, ny, nz, overlap, QJ_1, QJ_2, QJ_3, QJ_4, QJ_5, Qs1d_lo)
    call flatten_z_hi(nx, ny, nz, overlap, QJ_1, QJ_2, QJ_3, QJ_4, QJ_5, Qs1d_hi)
    stat = cudaMemcpy(send_lo, Qs1d_lo, msglen, cudaMemcpyDeviceToHost)
    stat = cudaMemcpy(send_hi, Qs1d_hi, msglen, cudaMemcpyDeviceToHost)
    call MPI_Isend(send_lo, msglen, MPI_REAL8, rank_lo, 20, MPI_COMM_WORLD, req(1), ierr)
    call MPI_Isend(send_hi, msglen, MPI_REAL8, rank_hi, 21, MPI_COMM_WORLD, req(2), ierr)
    call MPI_Irecv(recv_lo, msglen, MPI_REAL8, rank_lo, 21, MPI_COMM_WORLD, req(3), ierr)
    call MPI_Irecv(recv_hi, msglen, MPI_REAL8, rank_hi, 20, MPI_COMM_WORLD, req(4), ierr)
  end subroutine start_exchange_z
  #:endif

  #:if MPI == 'GPU'
  subroutine start_exchange_z(myrank, nranks, overlap, nx, ny, nz, QJ_1, QJ_2, QJ_3, QJ_4, QJ_5, &
                               Qs1d_lo, Qs1d_hi, Qr1d_lo, Qr1d_hi, &
                               send_lo, send_hi, recv_lo, recv_hi, req)
    integer, intent(in)            :: myrank, nranks, overlap, nx, ny, nz
    real(8), intent(in), device    :: QJ_1(nx,ny,nz), QJ_2(nx,ny,nz), QJ_3(nx,ny,nz), QJ_4(nx,ny,nz), QJ_5(nx,ny,nz)
    real(8), intent(inout), device :: Qs1d_lo(nx*ny*overlap*5), Qs1d_hi(nx*ny*overlap*5)
    real(8), intent(inout), device :: Qr1d_lo(nx*ny*overlap*5), Qr1d_hi(nx*ny*overlap*5)
    real(8), intent(inout)         :: send_lo(nx*ny*overlap*5), send_hi(nx*ny*overlap*5)
    real(8), intent(inout), device :: recv_lo(nx*ny*overlap*5), recv_hi(nx*ny*overlap*5)
    integer, intent(out)           :: req(4)
    integer rank_lo, rank_hi, msglen, stat, ierr
    rank_lo = mod(myrank - 2 + nranks, nranks)
    rank_hi = mod(myrank + 2, nranks)
    msglen  = nx * ny * overlap * 5
    call flatten_z_lo(nx, ny, nz, overlap, QJ_1, QJ_2, QJ_3, QJ_4, QJ_5, Qs1d_lo)
    call flatten_z_hi(nx, ny, nz, overlap, QJ_1, QJ_2, QJ_3, QJ_4, QJ_5, Qs1d_hi)
    ! REQUIRED: the send buffers are handed to MPI as device pointers, and a
    ! CUDA-aware MPI reads them on its own stream / via IPC / RDMA, i.e. NOT
    ! ordered after the flatten kernels queued above on the default stream.
    ! Without this sync MPI can ship a partially written buffer. The same sync
    ! also orders the MPI_Irecv below after the previous stage's
    ! reconstruct_z_lo/hi kernels, which read recv_lo/hi (WAR hazard).
    ! The CPU variant does not need it because cudaMemcpy is synchronous.
    stat = cudaDeviceSynchronize()
    call MPI_Isend(Qs1d_lo, msglen, MPI_REAL8, rank_lo, 20, MPI_COMM_WORLD, req(1), ierr)
    call MPI_Isend(Qs1d_hi, msglen, MPI_REAL8, rank_hi, 21, MPI_COMM_WORLD, req(2), ierr)
    call MPI_Irecv(recv_lo, msglen, MPI_REAL8, rank_lo, 21, MPI_COMM_WORLD, req(3), ierr)
    call MPI_Irecv(recv_hi, msglen, MPI_REAL8, rank_hi, 20, MPI_COMM_WORLD, req(4), ierr)
  end subroutine start_exchange_z
  #:endif  


  !> One-time self-test of the z-halo transport, to be called once before the
  !> time loop. It fills the send buffers with a rank-identifying pattern,
  !> runs exactly the exchange the time loop uses, and aborts if a ghost
  !> buffer does not come back holding the neighbour's pattern.
  !>
  !> This exists because the failure it catches is silent. With MPI='GPU' the
  !> buffers handed to MPI are device pointers, and an MPI stack that selects
  !> a device-memory transport it cannot actually perform delivers wrong bytes
  !> without returning an error -- measured on a host where UCX picks cuda_ipc
  !> but CUDA IPC does not work: every received element came back as zero, and
  !> the only symptom was NaN a few hundred steps later. The same can happen
  !> on a cluster (UCX_TLS misconfigured, nvidia_peermem not loaded, ranks in
  !> containers without IPC access), so check rather than assume. Workarounds
  !> once it trips: set MPI='CPU' in config.fypp, or force a transport that
  !> works, e.g. UCX_TLS=self,sm,cuda_copy.
  !>
  !> With a single compute rank the exchange is a self-send and this can only
  !> confirm self-consistency, which is all there is to check in that case.
  #:if MPI == 'CPU'
  subroutine check_exchange_z(myrank, nranks, overlap, nx, ny, nz, &
                               Qs1d_lo, Qs1d_hi, send_lo, send_hi, recv_lo, recv_hi)
    integer, intent(in)            :: myrank, nranks, overlap, nx, ny, nz
    real(8), intent(inout), device :: Qs1d_lo(nx*ny*overlap*5), Qs1d_hi(nx*ny*overlap*5)
    real(8), intent(inout)         :: send_lo(nx*ny*overlap*5), send_hi(nx*ny*overlap*5)
    real(8), intent(inout)         :: recv_lo(nx*ny*overlap*5), recv_hi(nx*ny*overlap*5)
    integer rank_lo, rank_hi, msglen, stat, ierr, i, nbad, req(4)
    integer istat4(MPI_STATUS_SIZE,4)
    real(8) pat_lo, pat_hi, want_lo, want_hi
    rank_lo = mod(myrank - 2 + nranks, nranks)
    rank_hi = mod(myrank + 2, nranks)
    msglen  = nx * ny * overlap * 5
    pat_lo  = dble(myrank) + 0.25d0   ! payload I send downward
    pat_hi  = dble(myrank) + 0.75d0   ! payload I send upward
    want_lo = dble(rank_lo) + 0.75d0  ! low ghost must hold rank_lo's upward payload
    want_hi = dble(rank_hi) + 0.25d0  ! high ghost must hold rank_hi's downward payload
    !$cuf kernel do(1)<<<*,*>>>
    do i = 1, msglen
      Qs1d_lo(i) = pat_lo
      Qs1d_hi(i) = pat_hi
    enddo
    recv_lo(:) = -1.d0
    recv_hi(:) = -1.d0
    stat = cudaMemcpy(send_lo, Qs1d_lo, msglen, cudaMemcpyDeviceToHost)
    stat = cudaMemcpy(send_hi, Qs1d_hi, msglen, cudaMemcpyDeviceToHost)
    call MPI_Isend(send_lo, msglen, MPI_REAL8, rank_lo, 20, MPI_COMM_WORLD, req(1), ierr)
    call MPI_Isend(send_hi, msglen, MPI_REAL8, rank_hi, 21, MPI_COMM_WORLD, req(2), ierr)
    call MPI_Irecv(recv_lo, msglen, MPI_REAL8, rank_lo, 21, MPI_COMM_WORLD, req(3), ierr)
    call MPI_Irecv(recv_hi, msglen, MPI_REAL8, rank_hi, 20, MPI_COMM_WORLD, req(4), ierr)
    call MPI_Waitall(4, req, istat4, ierr)
    nbad = 0
    do i = 1, msglen
      if (recv_lo(i) /= want_lo) nbad = nbad + 1
      if (recv_hi(i) /= want_hi) nbad = nbad + 1
    enddo
    call report_exchange_z_check(myrank, rank_lo, rank_hi, nbad, 2*msglen, recv_lo(1), recv_hi(1), want_lo, want_hi)
  end subroutine check_exchange_z
  #:endif

  #:if MPI == 'GPU'
  subroutine check_exchange_z(myrank, nranks, overlap, nx, ny, nz, &
                               Qs1d_lo, Qs1d_hi, send_lo, send_hi, recv_lo, recv_hi)
    integer, intent(in)            :: myrank, nranks, overlap, nx, ny, nz
    real(8), intent(inout), device :: Qs1d_lo(nx*ny*overlap*5), Qs1d_hi(nx*ny*overlap*5)
    real(8), intent(inout)         :: send_lo(nx*ny*overlap*5), send_hi(nx*ny*overlap*5)
    real(8), intent(inout), device :: recv_lo(nx*ny*overlap*5), recv_hi(nx*ny*overlap*5)
    integer rank_lo, rank_hi, msglen, stat, ierr, i, nbad, req(4)
    integer istat4(MPI_STATUS_SIZE,4)
    real(8) pat_lo, pat_hi, want_lo, want_hi, got_lo, got_hi
    rank_lo = mod(myrank - 2 + nranks, nranks)
    rank_hi = mod(myrank + 2, nranks)
    msglen  = nx * ny * overlap * 5
    pat_lo  = dble(myrank) + 0.25d0   ! payload I send downward
    pat_hi  = dble(myrank) + 0.75d0   ! payload I send upward
    want_lo = dble(rank_lo) + 0.75d0  ! low ghost must hold rank_lo's upward payload
    want_hi = dble(rank_hi) + 0.25d0  ! high ghost must hold rank_hi's downward payload
    !$cuf kernel do(1)<<<*,*>>>
    do i = 1, msglen
      Qs1d_lo(i) = pat_lo
      Qs1d_hi(i) = pat_hi
      recv_lo(i) = -1.d0
      recv_hi(i) = -1.d0
    enddo
    stat = cudaDeviceSynchronize()
    call MPI_Isend(Qs1d_lo, msglen, MPI_REAL8, rank_lo, 20, MPI_COMM_WORLD, req(1), ierr)
    call MPI_Isend(Qs1d_hi, msglen, MPI_REAL8, rank_hi, 21, MPI_COMM_WORLD, req(2), ierr)
    call MPI_Irecv(recv_lo, msglen, MPI_REAL8, rank_lo, 21, MPI_COMM_WORLD, req(3), ierr)
    call MPI_Irecv(recv_hi, msglen, MPI_REAL8, rank_hi, 20, MPI_COMM_WORLD, req(4), ierr)
    call MPI_Waitall(4, req, istat4, ierr)
    nbad = 0
    !$cuf kernel do(1)<<<*,*>>>
    do i = 1, msglen
      if (recv_lo(i) /= want_lo) nbad = nbad + 1
      if (recv_hi(i) /= want_hi) nbad = nbad + 1
    enddo
    stat = cudaDeviceSynchronize()
    got_lo = recv_lo(1)
    got_hi = recv_hi(1)
    call report_exchange_z_check(myrank, rank_lo, rank_hi, nbad, 2*msglen, got_lo, got_hi, want_lo, want_hi)
  end subroutine check_exchange_z
  #:endif


  !> Shared verdict/abort for check_exchange_z above.
  subroutine report_exchange_z_check(myrank, rank_lo, rank_hi, nbad, ntot, got_lo, got_hi, want_lo, want_hi)
    integer, intent(in) :: myrank, rank_lo, rank_hi, nbad, ntot
    real(8), intent(in) :: got_lo, got_hi, want_lo, want_hi
    integer ierr
    if (nbad == 0) then
      if (myrank == 0) print '(1x,a,a,a)', "z-halo self-test passed (MPI='", "${MPI}$", "')"
      return
    endif
    print '(1x,a,i0,a)',        "z-halo SELF-TEST FAILED on rank ", myrank, ":"
    print '(1x,a,i0,a,i0,a)',   "  ", nbad, " of ", ntot, " received elements are wrong"
    print '(1x,a,i0,a,f8.2,a,f8.2)', "  from rank_lo=", rank_lo, " got ", got_lo, " expected ", want_lo
    print '(1x,a,i0,a,f8.2,a,f8.2)', "  from rank_hi=", rank_hi, " got ", got_hi, " expected ", want_hi
    print '(1x,a)',             "  The MPI layer is not delivering this buffer correctly."
    #:if MPI == 'GPU'
    print '(1x,a)',             "  MPI='GPU' passes device pointers straight to MPI: the MPI stack"
    print '(1x,a)',             "  must really support device memory. Set MPI='CPU' in config.fypp,"
    print '(1x,a)',             "  or force a working transport (e.g. UCX_TLS=self,sm,cuda_copy)."
    #:endif
    call MPI_ABORT(MPI_COMM_WORLD, 1, ierr)
  end subroutine report_exchange_z_check


  !> Complete z-halo exchange: MPI_Waitall, H2D copy, unpack ghost cells into QJ
  #:if MPI == 'CPU'
  subroutine finish_exchange_z(overlap, nx, ny, nz, &
                                recv_lo, recv_hi, Qr1d_lo, Qr1d_hi, QJ_1, QJ_2, QJ_3, QJ_4, QJ_5, req)
    integer, intent(in)            :: overlap, nx, ny, nz
    real(8), intent(in)            :: recv_lo(nx*ny*overlap*5), recv_hi(nx*ny*overlap*5)
    real(8), intent(inout), device :: Qr1d_lo(nx*ny*overlap*5), Qr1d_hi(nx*ny*overlap*5)
    real(8), intent(inout), device :: QJ_1(nx,ny,nz), QJ_2(nx,ny,nz), QJ_3(nx,ny,nz), QJ_4(nx,ny,nz), QJ_5(nx,ny,nz)
    integer, intent(inout)         :: req(4)
    integer msglen, stat, ierr
    integer istat4(MPI_STATUS_SIZE,4)
    msglen = nx * ny * overlap * 5
    call MPI_Waitall(4, req, istat4, ierr)
    stat = cudaMemcpy(Qr1d_lo, recv_lo, msglen, cudaMemcpyHostToDevice)
    stat = cudaMemcpy(Qr1d_hi, recv_hi, msglen, cudaMemcpyHostToDevice)
    call reconstruct_z_lo(nx, ny, nz, overlap, Qr1d_lo, QJ_1, QJ_2, QJ_3, QJ_4, QJ_5)
    call reconstruct_z_hi(nx, ny, nz, overlap, Qr1d_hi, QJ_1, QJ_2, QJ_3, QJ_4, QJ_5)
  end subroutine finish_exchange_z
  #:endif

  #:if MPI == 'GPU'
  subroutine finish_exchange_z(overlap, nx, ny, nz, &
                                recv_lo, recv_hi, Qr1d_lo, Qr1d_hi, QJ_1, QJ_2, QJ_3, QJ_4, QJ_5, req)
    integer, intent(in)            :: overlap, nx, ny, nz
    real(8), intent(in), device    :: recv_lo(nx*ny*overlap*5), recv_hi(nx*ny*overlap*5)
    real(8), intent(inout), device :: Qr1d_lo(nx*ny*overlap*5), Qr1d_hi(nx*ny*overlap*5)
    real(8), intent(inout), device :: QJ_1(nx,ny,nz), QJ_2(nx,ny,nz), QJ_3(nx,ny,nz), QJ_4(nx,ny,nz), QJ_5(nx,ny,nz)
    integer, intent(inout)         :: req(4)
    integer msglen, stat, ierr
    integer istat4(MPI_STATUS_SIZE,4)
    msglen = nx * ny * overlap * 5
    call MPI_Waitall(4, req, istat4, ierr)
    !stat = cudaMemcpy(Qr1d_lo, recv_lo, msglen, cudaMemcpyHostToDevice)
    !stat = cudaMemcpy(Qr1d_hi, recv_hi, msglen, cudaMemcpyHostToDevice)
    call reconstruct_z_lo(nx, ny, nz, overlap, recv_lo, QJ_1, QJ_2, QJ_3, QJ_4, QJ_5)
    call reconstruct_z_hi(nx, ny, nz, overlap, recv_hi, QJ_1, QJ_2, QJ_3, QJ_4, QJ_5)
  end subroutine finish_exchange_z
  #:endif
end module calc_para
