#:include 'config.fypp'
module calc_slau_kernel_internal
  use mod_globals, only : gamma, threadsE, threadsF, threadsG
  use mod_constant, only : id_slau, over_gamma_1
  use calc_muscl
  use calc_hybrid
  use libm
  implicit none
  private
  public calc_slau_x_in, calc_slau_y_in, calc_slau_z_in, calc_slau_z_in_koff
  integer, parameter :: io = ${ORDER_IO}$

#:if ORDER == 6
  integer(8), parameter :: id_acc = 0_8
#:elif ORDER == 4
  integer(4), parameter :: id_acc = 0_4
#:else
  integer(2), parameter :: id_acc = 0_2
#:endif

  interface interp
    module procedure interp2, interp4, interp6
  end interface interp

  interface SLAU
    module procedure SLAU1, HRSLAU2
  end interface SLAU
contains
  include 'calc_slau_3d.f90'

  !$dir inline
  attributes(device) subroutine interp6(id_accuracy, rho,  u,  v,  w,  p, &
                                                     rhol, ul, vl, wl, pl, &
                                                     rhor, ur, vr, wr, pr, fd)
    integer(8), intent(in), value :: id_accuracy
    real(8), intent(in), contiguous :: rho(6), u(6), v(6), w(6), p(6)
    real(8), intent(out)            :: rhol, ul, vl, wl, pl
    real(8), intent(out)            :: rhor, ur, vr, wr, pr
    real(sp), intent(inout)         :: fd
    call delta6(fd, rho(:), rhol, rhor)
    call delta6(fd,   u(:),   ul,   ur)
    call delta6(fd,   v(:),   vl,   vr)
    call delta6(fd,   w(:),   wl,   wr)
    call delta6(fd,   p(:),   pl,   pr)
    fd = wiggle_detector(p(2:5))
  end subroutine interp6


  !$dir inline
  attributes(device) subroutine interp4(id_accuracy, rho,  u,  v,  w,  p, &
                                                     rhol, ul, vl, wl, pl, &
                                                     rhor, ur, vr, wr, pr, fd)
    integer(4), intent(in), value :: id_accuracy
    real(8), intent(in), contiguous :: rho(4), u(4), v(4), w(4), p(4)
    real(8), intent(out)            :: rhol, ul, vl, wl, pl
    real(8), intent(out)            :: rhor, ur, vr, wr, pr
    real(sp), intent(inout)         :: fd
    call delta4(fd, rho(:), rhol, rhor)
    call delta4(fd,   u(:),   ul,   ur)
    call delta4(fd,   v(:),   vl,   vr)
    call delta4(fd,   w(:),   wl,   wr)
    call delta4(fd,   p(:),   pl,   pr)
    fd = wiggle_detector(p(:))
  end subroutine interp4


  !$dir inline
  attributes(device) subroutine interp2(id_accuracy, rho,  u,  v,  w,  p, &
                                                     rhol, ul, vl, wl, pl, &
                                                     rhor, ur, vr, wr, pr, fd)
    integer(2), intent(in), value :: id_accuracy
    real(8), intent(in), contiguous :: rho(2), u(2), v(2), w(2), p(2)
    real(8), intent(out)            :: rhol, ul, vl, wl, pl
    real(8), intent(out)            :: rhor, ur, vr, wr, pr
    real(sp), intent(inout)         :: fd
    rhol = rho(1); rhor = rho(2)
      ul =   u(1);   ur =   u(2)
      vl =   v(1);   vr =   v(2)
      wl =   w(1);   wr =   w(2)
      pl =   p(1);   pr =   p(2)
      fd = 1.0_sp
  end subroutine interp2


  attributes(global) subroutine calc_slau_x_in(nx, ny, nz, Q_1, Q_2, Q_3, Q_4, Q_5, sensor, E)
    use mod_constant, only : Normal_x
    integer, intent(in), value                :: nx, ny, nz
    real(8), intent(in), device, contiguous   :: Q_1(nx,ny,nz), Q_2(nx,ny,nz), Q_3(nx,ny,nz), Q_4(nx,ny,nz), Q_5(nx,ny,nz)
    real(sp), intent(in), device, contiguous  :: sensor(nx,ny,nz)
    real(8), intent(out), device, contiguous  :: E(nx-1,ny-2,nz-2,5)
    integer i, j, k, it, jt, kt
    integer ii, i_base, idx, idx_r, offset_yz, offset_yzr, i1, i2
    logical :: jk_in_range
    integer, parameter :: sx  = threadsE%x + 2*io + 1
    integer, parameter :: sxr = threadsE%x
    integer, parameter :: sy  = threadsE%y
    integer, parameter :: sz  = threadsE%z
    real(8), dimension(-(io-1):sx*sy*sz-io), shared :: rho, u, v, w, p
    real(8), dimension(sxr*sy*sz), shared           :: rhor, ur, vr, wr, pr
    real(8) rhol, ul, vl, wl, pl
    real(sp) fdx  ! sp intentional: sensor interpolation does not need double precision
    it = threadIdx%x
    jt = threadIdx%y
    kt = threadIdx%z
    j  = (blockIdx%y-1)*blockDim%y + jt + 1
    k  = (blockIdx%z-1)*blockDim%z + kt + 1
    i_base     = (blockIdx%x-1)*blockDim%x
    offset_yz  = (jt-1) * sx  + (kt-1) * sx  * sy
    offset_yzr = (jt-1) * sxr + (kt-1) * sxr * sy
    jk_in_range = (j >= 1 .and. j <= ny .and. k >= 1 .and. k <= nz)
    do ii = it-io, threadsE%x+io+1, blockDim%x
      i = i_base + ii
      if (i >= 1 .and. i <= nx .and. jk_in_range) then
        idx = ii + offset_yz
        rho(idx) = Q_1(i,j,k); u(idx) = Q_2(i,j,k); v(idx) = Q_3(i,j,k)
          w(idx) = Q_4(i,j,k); p(idx) = Q_5(i,j,k)
      endif
    enddo
    call syncthreads()
    i = (blockIdx%x-1)*blockDim%x + it
    if (io+1 <= i .and. i <= nx-(io+1) .and. j <= ny-1 .and. k <= nz-1) then
      idx   = it + offset_yz
      idx_r = it + offset_yzr
      i1    = idx - io
      i2    = idx + io + 1
      fdx   = 0.50_sp * (sensor(i,j,k) + sensor(i+1,j,k))
      call interp(id_acc, &
                  rho(i1:i2),  u(i1:i2),  v(i1:i2),  w(i1:i2),  p(i1:i2), &
                  rhol,        ul,        vl,        wl,        pl, &
                  rhor(idx_r), ur(idx_r), vr(idx_r), wr(idx_r), pr(idx_r), fdx)
    endif
    call syncthreads()
    if (io+1 <= i .and. i <= nx-(io+1) .and. j <= ny-1 .and. k <= nz-1) then
      rho(idx) = rhol; u(idx) = ul; v(idx) = vl; w(idx) = wl; p(idx) = pl
      associate(un1 => u(idx), un2 => ur(idx_r))
        call SLAU(id_slau, rho(idx), rhor(idx_r), u(idx), ur(idx_r), v(idx), vr(idx_r), &
                  w(idx), wr(idx_r), un1, un2, p(idx), pr(idx_r), Normal_x, fdx, &
                  E(i,j-1,k-1,1), E(i,j-1,k-1,2), E(i,j-1,k-1,3), E(i,j-1,k-1,4), E(i,j-1,k-1,5))
      end associate
    endif
  end subroutine calc_slau_x_in


  attributes(global) subroutine calc_slau_y_in(nx, ny, nz, Q_1, Q_2, Q_3, Q_4, Q_5, sensor, F)
    use mod_constant, only : Normal_y
    integer, intent(in), value                :: nx, ny, nz
    real(8), intent(in), device, contiguous   :: Q_1(nx,ny,nz), Q_2(nx,ny,nz), Q_3(nx,ny,nz), Q_4(nx,ny,nz), Q_5(nx,ny,nz)
    real(sp), intent(in), device, contiguous  :: sensor(nx,ny,nz)
    real(8), intent(out), device, contiguous  :: F(nx-2,ny-1,nz-2,5)
    integer i, j, k, it, jt, kt
    integer jj, j_base, idx, idx_r, offset_xz, offset_xzr, i1, i2
    logical :: ik_in_range
    integer, parameter :: sx  = threadsF%x
    integer, parameter :: sy  = threadsF%y + 2*io + 1
    integer, parameter :: syr = threadsF%y
    integer, parameter :: sz  = threadsF%z
    real(8), dimension(-(io-1):sx*sy*sz-io), shared :: rho, u, v, w, p
    real(8), dimension(sx*syr*sz), shared           :: rhor, ur, vr, wr, pr
    real(8) rhol, ul, vl, wl, pl
    real(sp) fdy  ! sp intentional: sensor interpolation does not need double precision
    it = threadIdx%x
    jt = threadIdx%y
    kt = threadIdx%z
    i  = (blockIdx%x-1)*blockDim%x + it + 1
    k  = (blockIdx%z-1)*blockDim%z + kt + 1
    j_base     = (blockIdx%y-1)*blockDim%y
    offset_xz  = (it-1) * sy  + (kt-1) * sy  * sx
    offset_xzr = (it-1) * syr + (kt-1) * syr * sx
    ik_in_range = (i >= 1 .and. i <= nx .and. k >= 1 .and. k <= nz)
    do jj = jt-io, threadsF%y+io+1, blockDim%y
      j = j_base + jj
      if (ik_in_range .and. j >= 1 .and. j <= ny) then
        idx = jj + offset_xz
        rho(idx) = Q_1(i,j,k); u(idx) = Q_2(i,j,k); v(idx) = Q_3(i,j,k)
          w(idx) = Q_4(i,j,k); p(idx) = Q_5(i,j,k)
      endif
    enddo
    call syncthreads()
    j = (blockIdx%y-1)*blockDim%y + jt
    if (io+1 <= j .and. j <= ny-(io+1) .and. k <= nz-1 .and. i <= nx-1) then
      idx   = jt + offset_xz
      idx_r = jt + offset_xzr
      i1    = idx - io
      i2    = idx + io + 1
      fdy   = 0.50_sp * (sensor(i,j,k) + sensor(i,j+1,k))
      call interp(id_acc, &
                  rho(i1:i2),  u(i1:i2),  v(i1:i2),  w(i1:i2),  p(i1:i2), &
                  rhol,        ul,        vl,        wl,        pl, &
                  rhor(idx_r), ur(idx_r), vr(idx_r), wr(idx_r), pr(idx_r), fdy)
    endif
    call syncthreads()
    if (io+1 <= j .and. j <= ny-(io+1) .and. k <= nz-1 .and. i <= nx-1) then
      rho(idx) = rhol; u(idx) = ul; v(idx) = vl; w(idx) = wl; p(idx) = pl
      associate(un1 => v(idx), un2 => vr(idx_r))
        call SLAU(id_slau, rho(idx), rhor(idx_r), u(idx), ur(idx_r), v(idx), vr(idx_r), &
                  w(idx), wr(idx_r), un1, un2, p(idx), pr(idx_r), Normal_y, fdy, &
                  F(i-1,j,k-1,1), F(i-1,j,k-1,2), F(i-1,j,k-1,3), F(i-1,j,k-1,4), F(i-1,j,k-1,5))
      end associate
    endif
  end subroutine calc_slau_y_in


  attributes(global) subroutine calc_slau_z_in(nx, ny, nz, Q_1, Q_2, Q_3, Q_4, Q_5, sensor, G)
    use mod_constant, only : Normal_z
    integer, intent(in), value                :: nx, ny, nz
    real(8), intent(in), device, contiguous   :: Q_1(nx,ny,nz), Q_2(nx,ny,nz), Q_3(nx,ny,nz), Q_4(nx,ny,nz), Q_5(nx,ny,nz)
    real(sp), intent(in), device, contiguous  :: sensor(nx,ny,nz)
    real(8), intent(out), device, contiguous  :: G(nx-2,ny-2,nz-1,5)
    integer i, j, k, it, jt, kt
    integer kk, k_base, idx, idx_r, offset_xy, offset_xyr, i1, i2
    logical :: ij_in_range
    integer, parameter :: sx  = threadsG%x
    integer, parameter :: sy  = threadsG%y
    integer, parameter :: sz  = threadsG%z + 2*io + 1
    integer, parameter :: szr = threadsG%z
    real(8), dimension(-(io-1):sx*sy*sz-io), shared :: rho, u, v, w, p
    real(8), dimension(sx*sy*szr), shared           :: rhor, ur, vr, wr, pr
    real(8) rhol, ul, vl, wl, pl
    real(sp) fdz  ! sp intentional: sensor interpolation does not need double precision
    it = threadIdx%x
    jt = threadIdx%y
    kt = threadIdx%z
    i  = (blockIdx%x-1)*blockDim%x + it + 1
    j  = (blockIdx%y-1)*blockDim%y + jt + 1
    k_base     = (blockIdx%z-1)*blockDim%z
    offset_xy  = (jt-1) * sz  + (it-1) * sz  * sy
    offset_xyr = (jt-1) * szr + (it-1) * szr * sy
    ij_in_range = (i >= 1 .and. i <= nx .and. j >= 1 .and. j <= ny)
    do kk = kt-io, threadsG%z+io+1, blockDim%z
      k = k_base + kk
      if (ij_in_range .and. k >= 1 .and. k <= nz) then
        idx = kk + offset_xy
        rho(idx) = Q_1(i,j,k); u(idx) = Q_2(i,j,k); v(idx) = Q_3(i,j,k)
          w(idx) = Q_4(i,j,k); p(idx) = Q_5(i,j,k)
      endif
    enddo
    call syncthreads()
    k = (blockIdx%z-1)*blockDim%z + kt
    if (io+1 <= k .and. k <= nz-(io+1) .and. i <= nx-1 .and. j <= ny-1) then
      idx   = kt + offset_xy
      idx_r = kt + offset_xyr
      i1    = idx - io
      i2    = idx + io + 1
      fdz   = 0.50_sp * (sensor(i,j,k) + sensor(i,j,k+1))
      call interp(id_acc, &
                  rho(i1:i2),  u(i1:i2),  v(i1:i2),  w(i1:i2),  p(i1:i2), &
                  rhol,        ul,        vl,        wl,        pl, &
                  rhor(idx_r), ur(idx_r), vr(idx_r), wr(idx_r), pr(idx_r), fdz)
    endif
    call syncthreads()
    if (io+1 <= k .and. k <= nz-(io+1) .and. i <= nx-1 .and. j <= ny-1) then
      rho(idx) = rhol; u(idx) = ul; v(idx) = vl; w(idx) = wl; p(idx) = pl
      associate(un1 => w(idx), un2 => wr(idx_r))
        call SLAU(id_slau, rho(idx), rhor(idx_r), u(idx), ur(idx_r), v(idx), vr(idx_r), &
                  w(idx), wr(idx_r), un1, un2, p(idx), pr(idx_r), Normal_z, fdz, &
                  G(i-1,j-1,k,1), G(i-1,j-1,k,2), G(i-1,j-1,k,3), G(i-1,j-1,k,4), G(i-1,j-1,k,5))
      end associate
    endif
  end subroutine calc_slau_z_in


  attributes(global) subroutine calc_slau_z_in_koff(nx, ny, nz, Q_1, Q_2, Q_3, Q_4, Q_5, sensor, G, k_lo, k_hi)
    use mod_constant, only : Normal_z
    integer, intent(in), value                :: nx, ny, nz, k_lo, k_hi
    real(8), intent(in), device, contiguous   :: Q_1(nx,ny,nz), Q_2(nx,ny,nz), Q_3(nx,ny,nz), Q_4(nx,ny,nz), Q_5(nx,ny,nz)
    real(sp), intent(in), device, contiguous  :: sensor(nx,ny,nz)
    real(8), intent(inout), device, contiguous :: G(nx-2,ny-2,nz-1,5)
    integer i, j, k, it, jt, kt
    integer kk, k_base, idx, idx_r, offset_xy, offset_xyr, i1, i2
    logical :: ij_in_range
    integer, parameter :: sx  = threadsG%x
    integer, parameter :: sy  = threadsG%y
    integer, parameter :: sz  = threadsG%z + 2*io + 1
    integer, parameter :: szr = threadsG%z
    real(8), dimension(-(io-1):sx*sy*sz-io), shared :: rho, u, v, w, p
    real(8), dimension(sx*sy*szr), shared           :: rhor, ur, vr, wr, pr
    real(8) rhol, ul, vl, wl, pl
    real(sp) fdz  ! sp intentional: sensor interpolation does not need double precision
    it = threadIdx%x
    jt = threadIdx%y
    kt = threadIdx%z
    i  = (blockIdx%x-1)*blockDim%x + it + 1
    j  = (blockIdx%y-1)*blockDim%y + jt + 1
    k_base     = (blockIdx%z-1)*blockDim%z + k_lo - 1
    offset_xy  = (jt-1) * sz  + (it-1) * sz  * sy
    offset_xyr = (jt-1) * szr + (it-1) * szr * sy
    ij_in_range = (i >= 1 .and. i <= nx .and. j >= 1 .and. j <= ny)
    do kk = kt-io, threadsG%z+io+1, blockDim%z
      k = k_base + kk
      if (ij_in_range .and. k >= 1 .and. k <= nz) then
        idx = kk + offset_xy
        rho(idx) = Q_1(i,j,k); u(idx) = Q_2(i,j,k); v(idx) = Q_3(i,j,k)
          w(idx) = Q_4(i,j,k); p(idx) = Q_5(i,j,k)
      endif
    enddo
    call syncthreads()
    k = k_base + kt
    if (k_lo <= k .and. k <= k_hi .and. i <= nx-1 .and. j <= ny-1) then
      idx   = kt + offset_xy
      idx_r = kt + offset_xyr
      i1    = idx - io
      i2    = idx + io + 1
      fdz   = 0.50_sp * (sensor(i,j,k) + sensor(i,j,k+1))
      call interp(id_acc, &
                  rho(i1:i2),  u(i1:i2),  v(i1:i2),  w(i1:i2),  p(i1:i2), &
                  rhol,        ul,        vl,        wl,        pl, &
                  rhor(idx_r), ur(idx_r), vr(idx_r), wr(idx_r), pr(idx_r), fdz)
    endif
    call syncthreads()
    if (k_lo <= k .and. k <= k_hi .and. i <= nx-1 .and. j <= ny-1) then
      rho(idx) = rhol; u(idx) = ul; v(idx) = vl; w(idx) = wl; p(idx) = pl
      associate(un1 => w(idx), un2 => wr(idx_r))
        call SLAU(id_slau, rho(idx), rhor(idx_r), u(idx), ur(idx_r), v(idx), vr(idx_r), &
                  w(idx), wr(idx_r), un1, un2, p(idx), pr(idx_r), Normal_z, fdz, &
                  G(i-1,j-1,k,1), G(i-1,j-1,k,2), G(i-1,j-1,k,3), G(i-1,j-1,k,4), G(i-1,j-1,k,5))
      end associate
    endif
  end subroutine calc_slau_z_in_koff
end module calc_slau_kernel_internal
