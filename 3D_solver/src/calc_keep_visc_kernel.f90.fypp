#:include 'config.fypp'
#:include 'precision.fypp'
#:if not defined('VISC_ORDER')
  #:set VISC_ORDER = ORDER
#:endif
! Fused convective (KEEP) + viscous flux kernel, one launch per direction
! instead of two. Only meaningful for the exact configuration NSTGV/DHIT's
! KEEP+NS build uses today: SCHEME='KEEP', VISC='NS', ORDER=VISC_ORDER=6,
! no boundary (periodic, BC_X=BC_Y=BC_Z=False), no COMMZ. Every other
! combination (SLAU/Hybrid, LES, BC_*=True, VISC_ORDER=4) keeps using the
! existing separate calc_keep_*_in / calc_*v6_in kernels unchanged -- this
! module is an empty no-op for those configs, so it never conflicts with
! them and never runs untested branches.
!
! Rationale: calc_keep_x_in (calc_keep_kernel_internal.f90.fypp) and
! calc_Ev6_in (calc_visc_high_internal.f90.fypp) both load rho/u/v/w/p/T (or
! u/v/w) over the same overlapping x-halo into two independent shared-memory
! tiles, and E/F/G is stored by the convective kernel then read-modified-
! written by the viscous kernel purely because they are separate launches.
! Here both are computed from ONE shared load pass and stored ONCE.
!
! Known risk (see calc_div.f90's own history): combining formerly-separate
! kernels can regress register pressure/occupancy even when it cuts memory
! traffic -- this must be measured (nsys/ncu), not assumed.
#:if SCHEME == 'KEEP' and VISC == 'NS' and ORDER == 6 and VISC_ORDER == 6 and not BC_X and not BC_Y and not BC_Z and not COMMZ
module calc_keep_visc_kernel_internal
  use mod_precision
  use libm
  use mod_globals, only : threadsE, threadsF, threadsG
  ! constants referenced by the included calc_scheme_math.f90
  use mod_constant, only : gamma_conv, over_gamma_1_conv, R_over_gamma_1_conv, one_third_conv, one_sixth_conv, one_twelfth_conv, two_third_conv, &
                           one_24_conv, one_48_conv, one_60_conv, one_120_conv, one_240_conv, seven_twelfth_conv
  ! constants referenced by the included calc_visc_cent.f90.fypp
  use mod_constant, only : two_third_visc, one_24_visc
  use mod_constant, only : Cp_over_Pr => Cp_over_Pr_visc, one_sixty => one_sixty_visc
  implicit none
  private
  public calc_keepv_x_in, calc_keepv_y_in, calc_keepv_z_in
  integer, parameter :: io   = ${ORDER_IO}$
  integer, parameter :: io_v = 2
  integer(8), parameter :: id_acc = 0_8

  interface KEEP
    module procedure KEEP2, KEEP4, KEEP6
  end interface KEEP
contains
  include 'calc_scheme_math.f90'
  #:include 'calc_visc_cent.f90.fypp'


  attributes(global) subroutine calc_keepv_x_in(nx, ny, nz, dx, dy, dz, Q_1, Q_2, Q_3, Q_4, Q_5, T, mu, vy, wz, E)
    use mod_constant, only : Normal_x => Normal_x_conv
    integer, intent(in), value                 :: nx, ny, nz
    real(kd_arr), intent(in), device, contiguous    :: dx(nx-1), dy(ny-1), dz(nz-1)
    real(kd_arr), intent(in), device, contiguous    :: Q_1(nx,ny,nz), Q_2(nx,ny,nz), Q_3(nx,ny,nz), Q_4(nx,ny,nz), Q_5(nx,ny,nz), T(nx,ny,nz)
    real(kd_arr), intent(in), device, contiguous    :: mu(nx,ny,nz)
    real(kd_arr), intent(in), device, contiguous    :: vy(nx,ny,nz) !< dv/dy at cell-center, precomputed by calc_div
    real(kd_arr), intent(in), device, contiguous    :: wz(nx,ny,nz) !< dw/dz at cell-center, precomputed by calc_div
    real(kd_arr), intent(inout), device, contiguous :: E(nx-1,ny-2,nz-2,5)
    integer i, j, k, it, jt, kt
    integer :: ii, i_base, idx, offset_yz
    logical :: jk_in_range, jk_in_range_grad_y, jk_in_range_grad_z, interior
    integer, parameter :: sx = threadsE%x + 2*io + 1
    integer, parameter :: sy = threadsE%y
    integer, parameter :: sz = threadsE%z
    real(kd_arr), dimension(-(io-1):sx*sy*sz-io), shared :: rho, u, v, w, p, tmp  ! read by both terms
    real(kd_visc), dimension(-(io-1):sx*sy*sz-io), shared :: uy, uz
    real(kd_arr)  :: flux(5)
    real(kd_visc) :: mui
    it = threadIdx%x
    jt = threadIdx%y
    kt = threadIdx%z
    j  = (blockIdx%y-1)*blockDim%y + jt + 1
    k  = (blockIdx%z-1)*blockDim%z + kt + 1
    i_base = (blockIdx%x-1)*blockDim%x
    offset_yz = (jt-1) * sx + (kt-1) * sx * sy
    jk_in_range        = (j >= 1 .and. j <= ny .and. k >= 1 .and. k <= nz)
    jk_in_range_grad_y = (4 <= j .and. j <= ny-3 .and. k >= 1 .and. k <= nz)
    jk_in_range_grad_z = (j >= 1 .and. j <= ny .and. 4 <= k .and. k <= nz-3)
    do ii = it-io, threadsE%x+io+1, blockDim%x
      i = i_base + ii
      if (i >= 1 .and. i <= nx .and. jk_in_range) then
        idx = ii + offset_yz
        rho(idx) = Q_1(i,j,k);   u(idx) = Q_2(i,j,k)
          v(idx) = Q_3(i,j,k);   w(idx) = Q_4(i,j,k)
          p(idx) = Q_5(i,j,k); tmp(idx) =   T(i,j,k)
        if (jk_in_range_grad_y) then
          uy(idx) = (one_sixty * (-real(Q_2(i,j-3,k), kd_visc) + real(Q_2(i,j+3,k), kd_visc)) + 0.15_kd_visc * (real(Q_2(i,j-2,k), kd_visc) - real(Q_2(i,j+2,k), kd_visc)) + 0.75_kd_visc * (-real(Q_2(i,j-1,k), kd_visc) + real(Q_2(i,j+1,k), kd_visc))) * real(dy(j), kd_visc)
        endif
        if (jk_in_range_grad_z) then
          uz(idx) = (one_sixty * (-real(Q_2(i,j,k-3), kd_visc) + real(Q_2(i,j,k+3), kd_visc)) + 0.15_kd_visc * (real(Q_2(i,j,k-2), kd_visc) - real(Q_2(i,j,k+2), kd_visc)) + 0.75_kd_visc * (-real(Q_2(i,j,k-1), kd_visc) + real(Q_2(i,j,k+1), kd_visc))) * real(dz(k), kd_visc)
        endif
      endif
    enddo
    call syncthreads()
    i = (blockIdx%x-1)*blockDim%x + it
    if (io+1 <= i .and. i <= nx-(io+1) .and. j <= ny-1 .and. k <= nz-1) then
      idx = it + offset_yz
      associate(uu => u)
      #:if CONV_CAST
      block
        real(kd_conv) :: s1(2*io+2), s2(2*io+2), s3(2*io+2), s4(2*io+2), s5(2*io+2), s6(2*io+2)
        s1 = rho(idx-io:idx+io+1)
        s2 = u(idx-io:idx+io+1)
        s3 = v(idx-io:idx+io+1)
        s4 = w(idx-io:idx+io+1)
        s5 = p(idx-io:idx+io+1)
        s6 = tmp(idx-io:idx+io+1)
        flux = KEEP(id_acc, s1, s2, s3, s4, s2, s5, s6, Normal_x)
      end block
      #:else
      flux = KEEP(id_acc, &
                  rho(idx-io:idx+io+1), u(idx-io:idx+io+1), &
                    v(idx-io:idx+io+1), w(idx-io:idx+io+1), &
                   uu(idx-io:idx+io+1), p(idx-io:idx+io+1), &
                  tmp(idx-io:idx+io+1), Normal_x)
      #:endif
      end associate
      ! narrower than the convective validity above: vy/wz are only valid
      ! where calc_div_vy_6_in/calc_div_wz_6_in's own y/z-margin covers them
      interior = (4 <= j .and. j <= ny-3 .and. 4 <= k .and. k <= nz-3)
      if (interior) then
        mui = interp6_s(real(mu(i-2,j,k), kd_visc)+real(mu(i+3,j,k), kd_visc), real(mu(i-1,j,k), kd_visc)+real(mu(i+2,j,k), kd_visc), real(mu(i,j,k), kd_visc)+real(mu(i+1,j,k), kd_visc))
        block
          real(kd_visc) :: tau, utau
          #:if VISC_CAST
          block
            real(kd_visc) :: s1(2*io_v+2), s2(2*io_v+2), s3(2*io_v+2)
            s1 = u(idx-io_v:idx+io_v+1)
            s2 = vy(i-io_v:i+io_v+1,j,k)
            s3 = wz(i-io_v:i+io_v+1,j,k)
            call calc_tau_straight(mui, s1, s2, s3, real(dx(i), kd_visc), tau, utau)
          end block
          #:else
          call calc_tau_straight(mui, u(idx-io_v:idx+io_v+1), vy(i-io_v:i+io_v+1,j,k), wz(i-io_v:i+io_v+1,j,k), real(dx(i), kd_visc), tau, utau)
          #:endif
          flux(2) = flux(2) - tau
          flux(5) = flux(5) - utau
        end block
        block
          real(kd_visc) :: tau, utau
          #:if VISC_CAST
          block
            real(kd_visc) :: s1(2*io_v+2)
            s1 = v(idx-io_v:idx+io_v+1)
            call calc_tau_cross(mui, s1, uy(idx-io_v:idx+io_v+1), real(dx(i), kd_visc), tau, utau)
          end block
          #:else
          call calc_tau_cross(mui, v(idx-io_v:idx+io_v+1), uy(idx-io_v:idx+io_v+1), real(dx(i), kd_visc), tau, utau)
          #:endif
          flux(3) = flux(3) - tau
          flux(5) = flux(5) - utau
        end block
        block
          real(kd_visc) :: tau, utau
          #:if VISC_CAST
          block
            real(kd_visc) :: s1(2*io_v+2)
            s1 = w(idx-io_v:idx+io_v+1)
            call calc_tau_cross(mui, s1, uz(idx-io_v:idx+io_v+1), real(dx(i), kd_visc), tau, utau)
          end block
          #:else
          call calc_tau_cross(mui, w(idx-io_v:idx+io_v+1), uz(idx-io_v:idx+io_v+1), real(dx(i), kd_visc), tau, utau)
          #:endif
          flux(4) = flux(4) - tau
          flux(5) = flux(5) - utau
        end block
        block
          real(kd_visc) :: Tx, kTx
          ! T sourced from the shared tmp tile (already loaded for KEEP's
          ! own energy term) instead of an independent global read -- a
          ! dedup only available because KEEP already tiles T.
          Tx  = diff6_s(real(dx(i), kd_visc), -real(tmp(idx-2), kd_visc)+real(tmp(idx+3), kd_visc), real(tmp(idx-1), kd_visc)-real(tmp(idx+2), kd_visc), -real(tmp(idx), kd_visc)+real(tmp(idx+1), kd_visc))
          kTx = Cp_over_Pr * mui * Tx
          flux(5) = flux(5) - kTx
        end block
      endif
      E(i,j-1,k-1,:) = flux(:)
    endif
  end subroutine calc_keepv_x_in


  attributes(global) subroutine calc_keepv_y_in(nx, ny, nz, dx, dy, dz, Q_1, Q_2, Q_3, Q_4, Q_5, T, mu, ux, wz, F)
    use mod_constant, only : Normal_y => Normal_y_conv
    integer, intent(in), value                 :: nx, ny, nz
    real(kd_arr), intent(in), device, contiguous    :: dx(nx-1), dy(ny-1), dz(nz-1)
    real(kd_arr), intent(in), device, contiguous    :: Q_1(nx,ny,nz), Q_2(nx,ny,nz), Q_3(nx,ny,nz), Q_4(nx,ny,nz), Q_5(nx,ny,nz), T(nx,ny,nz)
    real(kd_arr), intent(in), device, contiguous    :: mu(nx,ny,nz)
    real(kd_arr), intent(in), device, contiguous    :: ux(nx,ny,nz) !< du/dx at cell-center, precomputed by calc_div
    real(kd_arr), intent(in), device, contiguous    :: wz(nx,ny,nz) !< dw/dz at cell-center, precomputed by calc_div
    real(kd_arr), intent(inout), device, contiguous :: F(nx-2,ny-1,nz-2,5)
    integer i, j, k, it, jt, kt
    integer :: jj, j_base, idx, offset_xz
    logical :: ik_in_range, ik_in_range_grad_x, ik_in_range_grad_z, interior
    integer, parameter :: sx = threadsF%x
    integer, parameter :: sy = threadsF%y + 2*io + 1
    integer, parameter :: sz = threadsF%z
    real(kd_arr), dimension(-(io-1):sx*sy*sz-io), shared :: rho, u, v, w, p, tmp  ! read by both terms
    real(kd_visc), dimension(-(io-1):sx*sy*sz-io), shared :: vx, vz
    real(kd_arr)  :: flux(5)
    real(kd_visc) :: mui
    it = threadIdx%x
    jt = threadIdx%y
    kt = threadIdx%z
    i  = (blockIdx%x-1)*blockDim%x + it + 1
    k  = (blockIdx%z-1)*blockDim%z + kt + 1
    j_base = (blockIdx%y-1)*blockDim%y
    offset_xz = (it-1) * sy + (kt-1) * sy * sx
    ik_in_range        = (i >= 1 .and. i <= nx .and. k >= 1 .and. k <= nz)
    ik_in_range_grad_x = (4 <= i .and. i <= nx-3 .and. k >= 1 .and. k <= nz)
    ik_in_range_grad_z = (i >= 1 .and. i <= nx .and. 4 <= k .and. k <= nz-3)
    do jj = jt-io, threadsF%y+io+1, blockDim%y
      j = j_base + jj
      if (ik_in_range .and. j >= 1 .and. j <= ny) then
        idx = jj + offset_xz
        rho(idx) = Q_1(i,j,k);   u(idx) = Q_2(i,j,k)
          v(idx) = Q_3(i,j,k);   w(idx) = Q_4(i,j,k)
          p(idx) = Q_5(i,j,k); tmp(idx) =   T(i,j,k)
        if (ik_in_range_grad_x) then
          vx(idx) = (one_sixty * (-real(Q_3(i-3,j,k), kd_visc) + real(Q_3(i+3,j,k), kd_visc)) + 0.15_kd_visc * (real(Q_3(i-2,j,k), kd_visc) - real(Q_3(i+2,j,k), kd_visc)) + 0.75_kd_visc * (-real(Q_3(i-1,j,k), kd_visc) + real(Q_3(i+1,j,k), kd_visc))) * real(dx(i), kd_visc)
        endif
        if (ik_in_range_grad_z) then
          vz(idx) = (one_sixty * (-real(Q_3(i,j,k-3), kd_visc) + real(Q_3(i,j,k+3), kd_visc)) + 0.15_kd_visc * (real(Q_3(i,j,k-2), kd_visc) - real(Q_3(i,j,k+2), kd_visc)) + 0.75_kd_visc * (-real(Q_3(i,j,k-1), kd_visc) + real(Q_3(i,j,k+1), kd_visc))) * real(dz(k), kd_visc)
        endif
      endif
    enddo
    call syncthreads()
    j = (blockIdx%y-1)*blockDim%y + jt
    if (io+1 <= j .and. j <= ny-(io+1) .and. i <= nx-1 .and. k <= nz-1) then
      idx = jt + offset_xz
      associate(vv => v)
      #:if CONV_CAST
      block
        real(kd_conv) :: s1(2*io+2), s2(2*io+2), s3(2*io+2), s4(2*io+2), s5(2*io+2), s6(2*io+2)
        s1 = rho(idx-io:idx+io+1)
        s2 = u(idx-io:idx+io+1)
        s3 = v(idx-io:idx+io+1)
        s4 = w(idx-io:idx+io+1)
        s5 = p(idx-io:idx+io+1)
        s6 = tmp(idx-io:idx+io+1)
        flux = KEEP(id_acc, s1, s2, s3, s4, s3, s5, s6, Normal_y)
      end block
      #:else
      flux = KEEP(id_acc, &
                  rho(idx-io:idx+io+1), u(idx-io:idx+io+1), &
                    v(idx-io:idx+io+1), w(idx-io:idx+io+1), &
                   vv(idx-io:idx+io+1), p(idx-io:idx+io+1), &
                  tmp(idx-io:idx+io+1), Normal_y)
      #:endif
      end associate
      interior = (4 <= i .and. i <= nx-3 .and. 4 <= k .and. k <= nz-3)
      if (interior) then
        mui = interp6_s(real(mu(i,j-2,k), kd_visc)+real(mu(i,j+3,k), kd_visc), real(mu(i,j-1,k), kd_visc)+real(mu(i,j+2,k), kd_visc), real(mu(i,j,k), kd_visc)+real(mu(i,j+1,k), kd_visc))
        block
          real(kd_visc) :: tau, utau
          #:if VISC_CAST
          block
            real(kd_visc) :: s1(2*io_v+2)
            s1 = v(idx-io_v:idx+io_v+1)
            call calc_tau_straight_s(mui, s1, real(wz(i,j-2,k), kd_visc)+real(wz(i,j+3,k), kd_visc), real(ux(i,j-2,k), kd_visc)+real(ux(i,j+3,k), kd_visc), real(wz(i,j-1,k), kd_visc)+real(wz(i,j+2,k), kd_visc), real(ux(i,j-1,k), kd_visc)+real(ux(i,j+2,k), kd_visc), real(wz(i,j,  k), kd_visc)+real(wz(i,j+1,k), kd_visc), real(ux(i,j,  k), kd_visc)+real(ux(i,j+1,k), kd_visc), real(dy(j), kd_visc), tau, utau)
          end block
          #:else
          call calc_tau_straight_s(mui, v(idx-io_v:idx+io_v+1), &
               real(wz(i,j-2,k), kd_visc)+real(wz(i,j+3,k), kd_visc), real(ux(i,j-2,k), kd_visc)+real(ux(i,j+3,k), kd_visc), &
               real(wz(i,j-1,k), kd_visc)+real(wz(i,j+2,k), kd_visc), real(ux(i,j-1,k), kd_visc)+real(ux(i,j+2,k), kd_visc), &
               real(wz(i,j,  k), kd_visc)+real(wz(i,j+1,k), kd_visc), real(ux(i,j,  k), kd_visc)+real(ux(i,j+1,k), kd_visc), &
               real(dy(j), kd_visc), tau, utau)
          #:endif
          flux(3) = flux(3) - tau
          flux(5) = flux(5) - utau
        end block
        block
          real(kd_visc) :: tau, utau
          #:if VISC_CAST
          block
            real(kd_visc) :: s1(2*io_v+2)
            s1 = u(idx-io_v:idx+io_v+1)
            call calc_tau_cross(mui, s1, vx(idx-io_v:idx+io_v+1), real(dy(j), kd_visc), tau, utau)
          end block
          #:else
          call calc_tau_cross(mui, u(idx-io_v:idx+io_v+1), vx(idx-io_v:idx+io_v+1), real(dy(j), kd_visc), tau, utau)
          #:endif
          flux(2) = flux(2) - tau
          flux(5) = flux(5) - utau
        end block
        block
          real(kd_visc) :: tau, utau
          #:if VISC_CAST
          block
            real(kd_visc) :: s1(2*io_v+2)
            s1 = w(idx-io_v:idx+io_v+1)
            call calc_tau_cross(mui, s1, vz(idx-io_v:idx+io_v+1), real(dy(j), kd_visc), tau, utau)
          end block
          #:else
          call calc_tau_cross(mui, w(idx-io_v:idx+io_v+1), vz(idx-io_v:idx+io_v+1), real(dy(j), kd_visc), tau, utau)
          #:endif
          flux(4) = flux(4) - tau
          flux(5) = flux(5) - utau
        end block
        block
          real(kd_visc) :: Ty, kTy
          Ty  = diff6_s(real(dy(j), kd_visc), -real(tmp(idx-2), kd_visc)+real(tmp(idx+3), kd_visc), real(tmp(idx-1), kd_visc)-real(tmp(idx+2), kd_visc), -real(tmp(idx), kd_visc)+real(tmp(idx+1), kd_visc))
          kTy = Cp_over_Pr * mui * Ty
          flux(5) = flux(5) - kTy
        end block
      endif
      F(i-1,j,k-1,:) = flux(:)
    endif
  end subroutine calc_keepv_y_in


  attributes(global) subroutine calc_keepv_z_in(nx, ny, nz, dx, dy, dz, Q_1, Q_2, Q_3, Q_4, Q_5, T, mu, ux, vy, G)
    use mod_constant, only : Normal_z => Normal_z_conv
    integer, intent(in), value                 :: nx, ny, nz
    real(kd_arr), intent(in), device, contiguous    :: dx(nx-1), dy(ny-1), dz(nz-1)
    real(kd_arr), intent(in), device, contiguous    :: Q_1(nx,ny,nz), Q_2(nx,ny,nz), Q_3(nx,ny,nz), Q_4(nx,ny,nz), Q_5(nx,ny,nz), T(nx,ny,nz)
    real(kd_arr), intent(in), device, contiguous    :: mu(nx,ny,nz)
    real(kd_arr), intent(in), device, contiguous    :: ux(nx,ny,nz) !< du/dx at cell-center, precomputed by calc_div
    real(kd_arr), intent(in), device, contiguous    :: vy(nx,ny,nz) !< dv/dy at cell-center, precomputed by calc_div
    real(kd_arr), intent(inout), device, contiguous :: G(nx-2,ny-2,nz-1,5)
    integer i, j, k, it, jt, kt
    integer :: kk, k_base, idx, offset_xy
    logical :: ij_in_range, ij_in_range_grad_x, ij_in_range_grad_y, interior
    integer, parameter :: sx = threadsG%x
    integer, parameter :: sy = threadsG%y
    integer, parameter :: sz = threadsG%z + 2*io + 1
    real(kd_arr), dimension(-(io-1):sx*sy*sz-io), shared :: rho, u, v, w, p, tmp  ! read by both terms
    real(kd_visc), dimension(-(io-1):sx*sy*sz-io), shared :: wx, wy
    real(kd_arr)  :: flux(5)
    real(kd_visc) :: mui
    it = threadIdx%x
    jt = threadIdx%y
    kt = threadIdx%z
    i  = (blockIdx%x-1)*blockDim%x + it + 1
    j  = (blockIdx%y-1)*blockDim%y + jt + 1
    k_base = (blockIdx%z-1)*blockDim%z
    offset_xy = (jt-1) * sz + (it-1) * sz * sy
    ij_in_range        = (i >= 1 .and. i <= nx .and. j >= 1 .and. j <= ny)
    ij_in_range_grad_x = (4 <= i .and. i <= nx-3 .and. j >= 1 .and. j <= ny)
    ij_in_range_grad_y = (i >= 1 .and. i <= nx .and. 4 <= j .and. j <= ny-3)
    do kk = kt-io, threadsG%z+io+1, blockDim%z
      k = k_base + kk
      if (ij_in_range .and. k >= 1 .and. k <= nz) then
        idx = kk + offset_xy
        rho(idx) = Q_1(i,j,k);   u(idx) = Q_2(i,j,k)
          v(idx) = Q_3(i,j,k);   w(idx) = Q_4(i,j,k)
          p(idx) = Q_5(i,j,k); tmp(idx) =   T(i,j,k)
        if (ij_in_range_grad_x) then
          wx(idx) = (one_sixty * (-real(Q_4(i-3,j,k), kd_visc) + real(Q_4(i+3,j,k), kd_visc)) + 0.15_kd_visc * (real(Q_4(i-2,j,k), kd_visc) - real(Q_4(i+2,j,k), kd_visc)) + 0.75_kd_visc * (-real(Q_4(i-1,j,k), kd_visc) + real(Q_4(i+1,j,k), kd_visc))) * real(dx(i), kd_visc)
        endif
        if (ij_in_range_grad_y) then
          wy(idx) = (one_sixty * (-real(Q_4(i,j-3,k), kd_visc) + real(Q_4(i,j+3,k), kd_visc)) + 0.15_kd_visc * (real(Q_4(i,j-2,k), kd_visc) - real(Q_4(i,j+2,k), kd_visc)) + 0.75_kd_visc * (-real(Q_4(i,j-1,k), kd_visc) + real(Q_4(i,j+1,k), kd_visc))) * real(dy(j), kd_visc)
        endif
      endif
    enddo
    call syncthreads()
    k = (blockIdx%z-1)*blockDim%z + kt
    if (io+1 <= k .and. k <= nz-(io+1) .and. i <= nx-1 .and. j <= ny-1) then
      idx = kt + offset_xy
      associate(ww => w)
      #:if CONV_CAST
      block
        real(kd_conv) :: s1(2*io+2), s2(2*io+2), s3(2*io+2), s4(2*io+2), s5(2*io+2), s6(2*io+2)
        s1 = rho(idx-io:idx+io+1)
        s2 = u(idx-io:idx+io+1)
        s3 = v(idx-io:idx+io+1)
        s4 = w(idx-io:idx+io+1)
        s5 = p(idx-io:idx+io+1)
        s6 = tmp(idx-io:idx+io+1)
        flux = KEEP(id_acc, s1, s2, s3, s4, s4, s5, s6, Normal_z)
      end block
      #:else
      flux = KEEP(id_acc, &
                  rho(idx-io:idx+io+1), u(idx-io:idx+io+1), &
                    v(idx-io:idx+io+1), w(idx-io:idx+io+1), &
                   ww(idx-io:idx+io+1), p(idx-io:idx+io+1), &
                  tmp(idx-io:idx+io+1), Normal_z)
      #:endif
      end associate
      interior = (4 <= i .and. i <= nx-3 .and. 4 <= j .and. j <= ny-3)
      if (interior) then
        mui = interp6_s(real(mu(i,j,k-2), kd_visc)+real(mu(i,j,k+3), kd_visc), real(mu(i,j,k-1), kd_visc)+real(mu(i,j,k+2), kd_visc), real(mu(i,j,k), kd_visc)+real(mu(i,j,k+1), kd_visc))
        block
          real(kd_visc) :: tau, utau
          #:if VISC_CAST
          block
            real(kd_visc) :: s1(2*io_v+2)
            s1 = w(idx-io_v:idx+io_v+1)
            call calc_tau_straight_s(mui, s1, real(ux(i,j,k-2), kd_visc)+real(ux(i,j,k+3), kd_visc), real(vy(i,j,k-2), kd_visc)+real(vy(i,j,k+3), kd_visc), real(ux(i,j,k-1), kd_visc)+real(ux(i,j,k+2), kd_visc), real(vy(i,j,k-1), kd_visc)+real(vy(i,j,k+2), kd_visc), real(ux(i,j,k  ), kd_visc)+real(ux(i,j,k+1), kd_visc), real(vy(i,j,k  ), kd_visc)+real(vy(i,j,k+1), kd_visc), real(dz(k), kd_visc), tau, utau)
          end block
          #:else
          call calc_tau_straight_s(mui, w(idx-io_v:idx+io_v+1), &
               real(ux(i,j,k-2), kd_visc)+real(ux(i,j,k+3), kd_visc), real(vy(i,j,k-2), kd_visc)+real(vy(i,j,k+3), kd_visc), &
               real(ux(i,j,k-1), kd_visc)+real(ux(i,j,k+2), kd_visc), real(vy(i,j,k-1), kd_visc)+real(vy(i,j,k+2), kd_visc), &
               real(ux(i,j,k  ), kd_visc)+real(ux(i,j,k+1), kd_visc), real(vy(i,j,k  ), kd_visc)+real(vy(i,j,k+1), kd_visc), &
               real(dz(k), kd_visc), tau, utau)
          #:endif
          flux(4) = flux(4) - tau
          flux(5) = flux(5) - utau
        end block
        block
          real(kd_visc) :: tau, utau
          #:if VISC_CAST
          block
            real(kd_visc) :: s1(2*io_v+2)
            s1 = u(idx-io_v:idx+io_v+1)
            call calc_tau_cross(mui, s1, wx(idx-io_v:idx+io_v+1), real(dz(k), kd_visc), tau, utau)
          end block
          #:else
          call calc_tau_cross(mui, u(idx-io_v:idx+io_v+1), wx(idx-io_v:idx+io_v+1), real(dz(k), kd_visc), tau, utau)
          #:endif
          flux(2) = flux(2) - tau
          flux(5) = flux(5) - utau
        end block
        block
          real(kd_visc) :: tau, utau
          #:if VISC_CAST
          block
            real(kd_visc) :: s1(2*io_v+2)
            s1 = v(idx-io_v:idx+io_v+1)
            call calc_tau_cross(mui, s1, wy(idx-io_v:idx+io_v+1), real(dz(k), kd_visc), tau, utau)
          end block
          #:else
          call calc_tau_cross(mui, v(idx-io_v:idx+io_v+1), wy(idx-io_v:idx+io_v+1), real(dz(k), kd_visc), tau, utau)
          #:endif
          flux(3) = flux(3) - tau
          flux(5) = flux(5) - utau
        end block
        block
          real(kd_visc) :: Tz, kTz
          Tz  = diff6_s(real(dz(k), kd_visc), -real(tmp(idx-2), kd_visc)+real(tmp(idx+3), kd_visc), real(tmp(idx-1), kd_visc)-real(tmp(idx+2), kd_visc), -real(tmp(idx), kd_visc)+real(tmp(idx+1), kd_visc))
          kTz = Cp_over_Pr * mui * Tz
          flux(5) = flux(5) - kTz
        end block
      endif
      G(i-1,j-1,k,:) = flux(:)
    endif
  end subroutine calc_keepv_z_in
end module calc_keep_visc_kernel_internal
#:else
module calc_keep_visc_kernel_internal
  use mod_precision
end module calc_keep_visc_kernel_internal
#:endif
