#:include 'config.fypp'
module calc_hybrid_kernel_internal
  use mod_globals, only : gamma, threshold, threadsE, threadsF, threadsG
  use mod_constant, only : id_slau, over_gamma_1, R_over_gamma_1, one_third, one_sixth, one_twelfth, two_third
  use calc_muscl
  use calc_hybrid
  use libm
  implicit none
  private
  public calc_hybrid_x_in, calc_hybrid_y_in, calc_hybrid_z_in, calc_hybrid_z_in_koff
  integer, parameter :: io = ${ORDER_IO}$
  real(8), parameter :: one_24        = 1.d0 / 24.d0
  real(8), parameter :: one_48        = 1.d0 / 48.d0
  real(8), parameter :: one_60        = 1.d0 / 60.d0
  real(8), parameter :: one_120       = 1.d0 / 120.d0
  real(8), parameter :: one_240       = 1.d0 / 240.d0
  real(8), parameter :: seven_twelfth = 7.d0 / 12.d0

#:if ORDER == 6
  integer(8), parameter :: id_acc = 0_8
#:elif ORDER == 4
  integer(4), parameter :: id_acc = 0_4
#:else
  integer(2), parameter :: id_acc = 0_2
#:endif

  interface KEEP
    module procedure KEEP2, KEEP4, KEEP6
  end interface KEEP

  interface SLAU
    module procedure SLAU1, HRSLAU2
  end interface SLAU

  interface delta_r
    module procedure delta_r2, delta_r4, delta_r6
  end interface delta_r
contains
  include 'calc_scheme_math.f90'

  !$dir inline
  attributes(device) subroutine delta_r2(id_acc, sensor, a, al, ar)
    integer(2), intent(in), value :: id_acc
    real(sp), intent(in), value   :: sensor
    real(8), intent(in)           :: a(2)
    real(8), intent(out)          :: al, ar
    al = a(1); ar = a(2)
  end subroutine delta_r2

  !$dir inline
  attributes(device) subroutine delta_r4(id_acc, sensor, a, al, ar)
    integer(4), intent(in), value :: id_acc
    real(sp), intent(in), value   :: sensor
    real(8), intent(in)           :: a(4)
    real(8), intent(out)          :: al, ar
    call delta4(sensor, a, al, ar)
  end subroutine delta_r4

  !$dir inline
  attributes(device) subroutine delta_r6(id_acc, sensor, a, al, ar)
    integer(8), intent(in), value :: id_acc
    real(sp), intent(in), value   :: sensor
    real(8), intent(in)           :: a(6)
    real(8), intent(out)          :: al, ar
    call delta6(sensor, a, al, ar)
  end subroutine delta_r6


  attributes(global) subroutine calc_hybrid_x_in(nx, ny, nz, Q_1, Q_2, Q_3, Q_4, Q_5, T, sensor, E)
    use mod_constant, only : Normal_x
    integer, intent(in), value                :: nx, ny, nz
    real(8), intent(in), device, contiguous   :: Q_1(nx,ny,nz), Q_2(nx,ny,nz), Q_3(nx,ny,nz), Q_4(nx,ny,nz), Q_5(nx,ny,nz), T(nx,ny,nz)
    real(sp), intent(in), device, contiguous  :: sensor(nx,ny,nz)
    real(8), intent(out), device, contiguous  :: E(nx-1,ny-2,nz-2,5)
    integer i, j, k, it, jt, kt, ii, i_base
    logical :: jk_in_range
    real(8), dimension(-(io-1):threadsE%x+io+1, threadsE%y, threadsE%z), shared :: rho, u, v, w, p
    real(8), dimension(threadsE%x, threadsE%y, threadsE%z), shared :: rhor, ur, vr, wr, pr
    real(sp) fdx
    real(8) rhol, ul, vl, wl, pl
    it = threadIdx%x;  jt = threadIdx%y;  kt = threadIdx%z
    j  = (blockIdx%y-1)*blockDim%y + jt + 1
    k  = (blockIdx%z-1)*blockDim%z + kt + 1
    i_base = (blockIdx%x-1)*blockDim%x
    jk_in_range = (j >= 1 .and. j <= ny .and. k >= 1 .and. k <= nz)
    do ii = it-io, threadsE%x+io+1, blockDim%x
      i = i_base + ii
      if (i >= 1 .and. i <= nx .and. jk_in_range) then
        rho(ii,jt,kt) = Q_1(i,j,k);   u(ii,jt,kt) = Q_2(i,j,k)
          v(ii,jt,kt) = Q_3(i,j,k);   w(ii,jt,kt) = Q_4(i,j,k)
          p(ii,jt,kt) = Q_5(i,j,k)
      endif
    enddo
    call syncthreads()
    i = i_base + it
    if (io+1 <= i .and. i <= nx-(io+1) .and. j <= ny-1 .and. k <= nz-1) then
      fdx = 0.5_sp * (sensor(i,j,k) + sensor(i+1,j,k))
      if (fdx <= threshold) then
        block
          real(8) tmp(2*io+2)
          tmp = T(i-io:i+io+1, j, k)
          associate(uu => u)
            E(i,j-1,k-1,:) = KEEP(id_acc, &
                                   rho(it-io:it+io+1,jt,kt), u(it-io:it+io+1,jt,kt), &
                                     v(it-io:it+io+1,jt,kt), w(it-io:it+io+1,jt,kt), &
                                    uu(it-io:it+io+1,jt,kt), p(it-io:it+io+1,jt,kt), tmp, Normal_x)
          end associate
        end block
      else
        call delta_r(id_acc, fdx, rho(it-io:it+io+1,jt,kt), rhol, rhor(it,jt,kt))
        call delta_r(id_acc, fdx,   u(it-io:it+io+1,jt,kt),   ul,   ur(it,jt,kt))
        call delta_r(id_acc, fdx,   v(it-io:it+io+1,jt,kt),   vl,   vr(it,jt,kt))
        call delta_r(id_acc, fdx,   w(it-io:it+io+1,jt,kt),   wl,   wr(it,jt,kt))
        call delta_r(id_acc, fdx,   p(it-io:it+io+1,jt,kt),   pl,   pr(it,jt,kt))
      endif
    endif
    call syncthreads()
    if (io+1 <= i .and. i <= nx-(io+1) .and. j <= ny-1 .and. k <= nz-1 .and. fdx > threshold) then
      rho(it,jt,kt) = rhol;   u(it,jt,kt) = ul;   v(it,jt,kt) = vl
        w(it,jt,kt) = wl;     p(it,jt,kt) = pl
      associate(un1 => u(it,jt,kt), un2 => ur(it,jt,kt))
        call SLAU(id_slau, rho(it,jt,kt), rhor(it,jt,kt), u(it,jt,kt), ur(it,jt,kt), v(it,jt,kt), vr(it,jt,kt), &
                  w(it,jt,kt), wr(it,jt,kt), un1, un2, p(it,jt,kt), pr(it,jt,kt), Normal_x, 1.0_sp, &
                  E(i,j-1,k-1,1), E(i,j-1,k-1,2), E(i,j-1,k-1,3), E(i,j-1,k-1,4), E(i,j-1,k-1,5))
      end associate
    endif
  end subroutine calc_hybrid_x_in


  attributes(global) subroutine calc_hybrid_y_in(nx, ny, nz, Q_1, Q_2, Q_3, Q_4, Q_5, T, sensor, F)
    use mod_constant, only : Normal_y
    integer, intent(in), value                :: nx, ny, nz
    real(8), intent(in), device, contiguous   :: Q_1(nx,ny,nz), Q_2(nx,ny,nz), Q_3(nx,ny,nz), Q_4(nx,ny,nz), Q_5(nx,ny,nz), T(nx,ny,nz)
    real(sp), intent(in), device, contiguous  :: sensor(nx,ny,nz)
    real(8), intent(out), device, contiguous  :: F(nx-2,ny-1,nz-2,5)
    integer i, j, k, it, jt, kt, jj, j_base
    logical :: ik_in_range
    real(8), dimension(-(io-1):threadsF%y+io+1, threadsF%x, threadsF%z), shared :: rho, u, v, w, p
    real(8), dimension(threadsF%y, threadsF%x, threadsF%z), shared :: rhor, ur, vr, wr, pr
    real(sp) fdy
    real(8) rhol, ul, vl, wl, pl
    it = threadIdx%x;  jt = threadIdx%y;  kt = threadIdx%z
    i  = (blockIdx%x-1)*blockDim%x + it + 1
    k  = (blockIdx%z-1)*blockDim%z + kt + 1
    j_base = (blockIdx%y-1)*blockDim%y
    ik_in_range = (i >= 1 .and. i <= nx .and. k >= 1 .and. k <= nz)
    do jj = jt-io, threadsF%y+io+1, blockDim%y
      j = j_base + jj
      if (ik_in_range .and. j >= 1 .and. j <= ny) then
        rho(jj,it,kt) = Q_1(i,j,k);   u(jj,it,kt) = Q_2(i,j,k)
          v(jj,it,kt) = Q_3(i,j,k);   w(jj,it,kt) = Q_4(i,j,k)
          p(jj,it,kt) = Q_5(i,j,k)
      endif
    enddo
    call syncthreads()
    j = j_base + jt
    if (io+1 <= j .and. j <= ny-(io+1) .and. i <= nx-1 .and. k <= nz-1) then
      fdy = 0.5_sp * (sensor(i,j,k) + sensor(i,j+1,k))
      if (fdy <= threshold) then
        block
          real(8) tmp(2*io+2)
          tmp = T(i, j-io:j+io+1, k)
          associate(vv => v)
            F(i-1,j,k-1,:) = KEEP(id_acc, &
                                   rho(jt-io:jt+io+1,it,kt), u(jt-io:jt+io+1,it,kt), &
                                     v(jt-io:jt+io+1,it,kt), w(jt-io:jt+io+1,it,kt), &
                                    vv(jt-io:jt+io+1,it,kt), p(jt-io:jt+io+1,it,kt), tmp, Normal_y)
          end associate
        end block
      else
        call delta_r(id_acc, fdy, rho(jt-io:jt+io+1,it,kt), rhol, rhor(jt,it,kt))
        call delta_r(id_acc, fdy,   u(jt-io:jt+io+1,it,kt),   ul,   ur(jt,it,kt))
        call delta_r(id_acc, fdy,   v(jt-io:jt+io+1,it,kt),   vl,   vr(jt,it,kt))
        call delta_r(id_acc, fdy,   w(jt-io:jt+io+1,it,kt),   wl,   wr(jt,it,kt))
        call delta_r(id_acc, fdy,   p(jt-io:jt+io+1,it,kt),   pl,   pr(jt,it,kt))
      endif
    endif
    call syncthreads()
    if (io+1 <= j .and. j <= ny-(io+1) .and. i <= nx-1 .and. k <= nz-1 .and. fdy > threshold) then
      rho(jt,it,kt) = rhol;   u(jt,it,kt) = ul;   v(jt,it,kt) = vl
        w(jt,it,kt) = wl;     p(jt,it,kt) = pl
      associate(un1 => v(jt,it,kt), un2 => vr(jt,it,kt))
        call SLAU(id_slau, rho(jt,it,kt), rhor(jt,it,kt), u(jt,it,kt), ur(jt,it,kt), v(jt,it,kt), vr(jt,it,kt), &
                  w(jt,it,kt), wr(jt,it,kt), un1, un2, p(jt,it,kt), pr(jt,it,kt), Normal_y, 1.0_sp, &
                  F(i-1,j,k-1,1), F(i-1,j,k-1,2), F(i-1,j,k-1,3), F(i-1,j,k-1,4), F(i-1,j,k-1,5))
      end associate
    endif
  end subroutine calc_hybrid_y_in


  attributes(global) subroutine calc_hybrid_z_in(nx, ny, nz, Q_1, Q_2, Q_3, Q_4, Q_5, T, sensor, G)
    use mod_constant, only : Normal_z
    integer, intent(in), value                :: nx, ny, nz
    real(8), intent(in), device, contiguous   :: Q_1(nx,ny,nz), Q_2(nx,ny,nz), Q_3(nx,ny,nz), Q_4(nx,ny,nz), Q_5(nx,ny,nz), T(nx,ny,nz)
    real(sp), intent(in), device, contiguous  :: sensor(nx,ny,nz)
    real(8), intent(out), device, contiguous  :: G(nx-2,ny-2,nz-1,5)
    integer i, j, k, it, jt, kt, kk, k_base
    logical :: ij_in_range
    real(8), dimension(-(io-1):threadsG%z+io+1, threadsG%y, threadsG%x), shared :: rho, u, v, w, p
    real(8), dimension(threadsG%z, threadsG%y, threadsG%x), shared :: rhor, ur, vr, wr, pr
    real(sp) fdz
    real(8) rhol, ul, vl, wl, pl
    it = threadIdx%x;  jt = threadIdx%y;  kt = threadIdx%z
    i  = (blockIdx%x-1)*blockDim%x + it + 1
    j  = (blockIdx%y-1)*blockDim%y + jt + 1
    k_base = (blockIdx%z-1)*blockDim%z
    ij_in_range = (i >= 1 .and. i <= nx .and. j >= 1 .and. j <= ny)
    do kk = kt-io, threadsG%z+io+1, blockDim%z
      k = k_base + kk
      if (ij_in_range .and. k >= 1 .and. k <= nz) then
        rho(kk,jt,it) = Q_1(i,j,k);   u(kk,jt,it) = Q_2(i,j,k)
          v(kk,jt,it) = Q_3(i,j,k);   w(kk,jt,it) = Q_4(i,j,k)
          p(kk,jt,it) = Q_5(i,j,k)
      endif
    enddo
    call syncthreads()
    k = k_base + kt
    if (io+1 <= k .and. k <= nz-(io+1) .and. i <= nx-1 .and. j <= ny-1) then
      fdz = 0.5_sp * (sensor(i,j,k) + sensor(i,j,k+1))
      if (fdz <= threshold) then
        block
          real(8) tmp(2*io+2)
          tmp = T(i, j, k-io:k+io+1)
          associate(ww => w)
            G(i-1,j-1,k,:) = KEEP(id_acc, &
                                   rho(kt-io:kt+io+1,jt,it), u(kt-io:kt+io+1,jt,it), &
                                     v(kt-io:kt+io+1,jt,it), w(kt-io:kt+io+1,jt,it), &
                                    ww(kt-io:kt+io+1,jt,it), p(kt-io:kt+io+1,jt,it), tmp, Normal_z)
          end associate
        end block
      else
        call delta_r(id_acc, fdz, rho(kt-io:kt+io+1,jt,it), rhol, rhor(kt,jt,it))
        call delta_r(id_acc, fdz,   u(kt-io:kt+io+1,jt,it),   ul,   ur(kt,jt,it))
        call delta_r(id_acc, fdz,   v(kt-io:kt+io+1,jt,it),   vl,   vr(kt,jt,it))
        call delta_r(id_acc, fdz,   w(kt-io:kt+io+1,jt,it),   wl,   wr(kt,jt,it))
        call delta_r(id_acc, fdz,   p(kt-io:kt+io+1,jt,it),   pl,   pr(kt,jt,it))
      endif
    endif
    call syncthreads()
    if (io+1 <= k .and. k <= nz-(io+1) .and. i <= nx-1 .and. j <= ny-1 .and. fdz > threshold) then
      rho(kt,jt,it) = rhol;   u(kt,jt,it) = ul;   v(kt,jt,it) = vl
        w(kt,jt,it) = wl;     p(kt,jt,it) = pl
      associate(un1 => w(kt,jt,it), un2 => wr(kt,jt,it))
        call SLAU(id_slau, rho(kt,jt,it), rhor(kt,jt,it), u(kt,jt,it), ur(kt,jt,it), v(kt,jt,it), vr(kt,jt,it), &
                  w(kt,jt,it), wr(kt,jt,it), un1, un2, p(kt,jt,it), pr(kt,jt,it), Normal_z, 1.0_sp, &
                  G(i-1,j-1,k,1), G(i-1,j-1,k,2), G(i-1,j-1,k,3), G(i-1,j-1,k,4), G(i-1,j-1,k,5))
      end associate
    endif
  end subroutine calc_hybrid_z_in


  attributes(global) subroutine calc_hybrid_z_in_koff(nx, ny, nz, Q_1, Q_2, Q_3, Q_4, Q_5, T, sensor, G, k_lo, k_hi)
    use mod_constant, only : Normal_z
    integer, intent(in), value                :: nx, ny, nz, k_lo, k_hi
    real(8), intent(in), device, contiguous   :: Q_1(nx,ny,nz), Q_2(nx,ny,nz), Q_3(nx,ny,nz), Q_4(nx,ny,nz), Q_5(nx,ny,nz), T(nx,ny,nz)
    real(sp), intent(in), device, contiguous  :: sensor(nx,ny,nz)
    real(8), intent(inout), device, contiguous :: G(nx-2,ny-2,nz-1,5)
    integer i, j, k, it, jt, kt, kk, k_base
    logical :: ij_in_range
    real(8), dimension(-(io-1):threadsG%z+io+1, threadsG%y, threadsG%x), shared :: rho, u, v, w, p
    real(8), dimension(threadsG%z, threadsG%y, threadsG%x), shared :: rhor, ur, vr, wr, pr
    real(sp) fdz
    real(8) rhol, ul, vl, wl, pl
    it = threadIdx%x;  jt = threadIdx%y;  kt = threadIdx%z
    i  = (blockIdx%x-1)*blockDim%x + it + 1
    j  = (blockIdx%y-1)*blockDim%y + jt + 1
    k_base = (blockIdx%z-1)*blockDim%z + k_lo - 1
    ij_in_range = (i >= 1 .and. i <= nx .and. j >= 1 .and. j <= ny)
    do kk = kt-io, threadsG%z+io+1, blockDim%z
      k = k_base + kk
      if (ij_in_range .and. k >= 1 .and. k <= nz) then
        rho(kk,jt,it) = Q_1(i,j,k);   u(kk,jt,it) = Q_2(i,j,k)
          v(kk,jt,it) = Q_3(i,j,k);   w(kk,jt,it) = Q_4(i,j,k)
          p(kk,jt,it) = Q_5(i,j,k)
      endif
    enddo
    call syncthreads()
    k = k_base + kt
    if (k_lo <= k .and. k <= k_hi .and. i <= nx-1 .and. j <= ny-1) then
      fdz = 0.5_sp * (sensor(i,j,k) + sensor(i,j,k+1))
      if (fdz <= threshold) then
        block
          real(8) tmp(2*io+2)
          tmp = T(i, j, k-io:k+io+1)
          associate(ww => w)
            G(i-1,j-1,k,:) = KEEP(id_acc, &
                                   rho(kt-io:kt+io+1,jt,it), u(kt-io:kt+io+1,jt,it), &
                                     v(kt-io:kt+io+1,jt,it), w(kt-io:kt+io+1,jt,it), &
                                    ww(kt-io:kt+io+1,jt,it), p(kt-io:kt+io+1,jt,it), tmp, Normal_z)
          end associate
        end block
      else
        call delta_r(id_acc, fdz, rho(kt-io:kt+io+1,jt,it), rhol, rhor(kt,jt,it))
        call delta_r(id_acc, fdz,   u(kt-io:kt+io+1,jt,it),   ul,   ur(kt,jt,it))
        call delta_r(id_acc, fdz,   v(kt-io:kt+io+1,jt,it),   vl,   vr(kt,jt,it))
        call delta_r(id_acc, fdz,   w(kt-io:kt+io+1,jt,it),   wl,   wr(kt,jt,it))
        call delta_r(id_acc, fdz,   p(kt-io:kt+io+1,jt,it),   pl,   pr(kt,jt,it))
      endif
    endif
    call syncthreads()
    if (k_lo <= k .and. k <= k_hi .and. i <= nx-1 .and. j <= ny-1 .and. fdz > threshold) then
      rho(kt,jt,it) = rhol;   u(kt,jt,it) = ul;   v(kt,jt,it) = vl
        w(kt,jt,it) = wl;     p(kt,jt,it) = pl
      associate(un1 => w(kt,jt,it), un2 => wr(kt,jt,it))
        call SLAU(id_slau, rho(kt,jt,it), rhor(kt,jt,it), u(kt,jt,it), ur(kt,jt,it), v(kt,jt,it), vr(kt,jt,it), &
                  w(kt,jt,it), wr(kt,jt,it), un1, un2, p(kt,jt,it), pr(kt,jt,it), Normal_z, 1.0_sp, &
                  G(i-1,j-1,k,1), G(i-1,j-1,k,2), G(i-1,j-1,k,3), G(i-1,j-1,k,4), G(i-1,j-1,k,5))
      end associate
    endif
  end subroutine calc_hybrid_z_in_koff
end module calc_hybrid_kernel_internal
