#:include 'config.fypp'
#:if not defined('VISC_ORDER')
  #:set VISC_ORDER = ORDER
#:endif
! Fused convective (SLAU) + viscous flux kernel, one launch per direction
! instead of two -- generalizes calc_keep_visc_kernel.f90.fypp's fusion
! recipe from KEEP to SLAU. Only meaningful for the exact configuration
! NSTGV's SLAU+NS build uses today: SCHEME='SLAU', VISC='NS',
! ORDER=VISC_ORDER=6, no boundary (periodic, BC_X=BC_Y=BC_Z=False), no
! COMMZ. Every other combination keeps using the existing separate
! calc_slau_*_in / calc_*v6_in kernels unchanged -- this module is an
! empty no-op for those configs.
!
! Two differences from the KEEP+visc fusion that this file has to handle:
!
! 1. SLAU's own reconstruction (recon2/recon4/recon6 below, renamed from
!    calc_slau_kernel_internal.f90.fypp's local `interp2/4/6` to avoid
!    colliding with calc_visc_cent.f90.fypp's own interpN (N=VISC_ORDER) function,
!    both #:include'd into this one module) computes left/right states
!    from the raw rho/u/v/w/p tile and would, in the original kernel,
!    overwrite that tile with the left state before calling SLAU(). The
!    viscous stress/heat-flux terms below are computed from the RAW tile
!    *before* reconstruction runs, and the reconstructed left state is
!    kept in local scalars (rhol/ul/vl/wl/pl) instead of being written
!    back into the shared tile -- so no overwrite ever happens, and the
!    ordering constraint that would otherwise apply is moot by construction.
! 2. SLAU never loads T (it has no need for it convectively), and this
!    kernel deliberately does not add a new shared-memory tile for it --
!    SLAU already carries more shared arrays than KEEP (rho/u/v/w/p +
!    rhor/ur/vr/wr/pr = 10, vs. KEEP's rho/u/v/w/p/tmp = 6) before even
!    adding this fusion's uy/uz-style cross-derivative tiles, so T (and mu,
!    same as KEEP's fused kernel) is read straight from DRAM per-point
!    instead, mirroring calc_visc_cent.f90.fypp's own scalar-read helpers.
#:if SCHEME == 'SLAU' and VISC == 'NS' and ORDER == 6 and VISC_ORDER == 6 and not BC_X and not BC_Y and not BC_Z and not COMMZ
module calc_slau_visc_kernel_internal
  use mod_globals, only : gamma, threadsE, threadsF, threadsG
  use mod_constant, only : id_slau, over_gamma_1, R_over_gamma_1, one_third, one_sixth, one_twelfth, two_third, &
                            Cp_over_Pr, one_sixty
  use calc_muscl
  use calc_hybrid
  use libm
  implicit none
  private
  public calc_slauv_x_in, calc_slauv_y_in, calc_slauv_z_in
  real(8), parameter :: one_24        = 1.d0 / 24.d0
  real(8), parameter :: one_48        = 1.d0 / 48.d0
  real(8), parameter :: one_60        = 1.d0 / 60.d0
  real(8), parameter :: one_120       = 1.d0 / 120.d0
  real(8), parameter :: one_240       = 1.d0 / 240.d0
  real(8), parameter :: seven_twelfth = 7.d0 / 12.d0
  integer, parameter :: io   = ${ORDER_IO}$
  integer, parameter :: io_v = 2

  integer(8), parameter :: id_acc = 0_8

  interface recon
    module procedure recon2, recon4, recon6
  end interface recon

  interface SLAU
    module procedure SLAU1, HRSLAU2
  end interface SLAU
contains
  include 'calc_scheme_math.f90'
  #:include 'calc_visc_cent.f90.fypp'

  !$dir inline
  attributes(device) subroutine recon6(id_accuracy, rho,  u,  v,  w,  p, &
                                                    rhol, ul, vl, wl, pl, &
                                                    rhor, ur, vr, wr, pr, fd)
    integer(8), intent(in), value :: id_accuracy
    real(8), intent(in), contiguous :: rho(6), u(6), v(6), w(6), p(6)
    real(8), intent(out)            :: rhol, ul, vl, wl, pl
    real(8), intent(out)            :: rhor, ur, vr, wr, pr
    real(sp), intent(inout)         :: fd
    call delta6(fd, rho(:), rhol, rhor)
    call delta6(fd,   u(:),   ul,   ur)
    call delta6(fd,   v(:),   vl,   vr)
    call delta6(fd,   w(:),   wl,   wr)
    call delta6(fd,   p(:),   pl,   pr)
    fd = wiggle_detector(p(2:5))
  end subroutine recon6


  !$dir inline
  attributes(device) subroutine recon4(id_accuracy, rho,  u,  v,  w,  p, &
                                                    rhol, ul, vl, wl, pl, &
                                                    rhor, ur, vr, wr, pr, fd)
    integer(4), intent(in), value :: id_accuracy
    real(8), intent(in), contiguous :: rho(4), u(4), v(4), w(4), p(4)
    real(8), intent(out)            :: rhol, ul, vl, wl, pl
    real(8), intent(out)            :: rhor, ur, vr, wr, pr
    real(sp), intent(inout)         :: fd
    call delta4(fd, rho(:), rhol, rhor)
    call delta4(fd,   u(:),   ul,   ur)
    call delta4(fd,   v(:),   vl,   vr)
    call delta4(fd,   w(:),   wl,   wr)
    call delta4(fd,   p(:),   pl,   pr)
    fd = wiggle_detector(p(:))
  end subroutine recon4


  !$dir inline
  attributes(device) subroutine recon2(id_accuracy, rho,  u,  v,  w,  p, &
                                                    rhol, ul, vl, wl, pl, &
                                                    rhor, ur, vr, wr, pr, fd)
    integer(2), intent(in), value :: id_accuracy
    real(8), intent(in), contiguous :: rho(2), u(2), v(2), w(2), p(2)
    real(8), intent(out)            :: rhol, ul, vl, wl, pl
    real(8), intent(out)            :: rhor, ur, vr, wr, pr
    real(sp), intent(inout)         :: fd
    rhol = rho(1); rhor = rho(2)
      ul =   u(1);   ur =   u(2)
      vl =   v(1);   vr =   v(2)
      wl =   w(1);   wr =   w(2)
      pl =   p(1);   pr =   p(2)
      fd = 1.0_sp
  end subroutine recon2


  attributes(global) subroutine calc_slauv_x_in(nx, ny, nz, dx, dy, dz, Q_1, Q_2, Q_3, Q_4, Q_5, T, mu, sensor, vy, wz, E)
    use mod_constant, only : Normal_x
    integer, intent(in), value                 :: nx, ny, nz
    real(8), intent(in), device, contiguous    :: dx(nx-1), dy(ny-1), dz(nz-1)
    real(8), intent(in), device, contiguous    :: Q_1(nx,ny,nz), Q_2(nx,ny,nz), Q_3(nx,ny,nz), Q_4(nx,ny,nz), Q_5(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: T(nx,ny,nz), mu(nx,ny,nz)
    real(sp), intent(in), device, contiguous   :: sensor(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: vy(nx,ny,nz) !< dv/dy at cell-center, precomputed by calc_div
    real(8), intent(in), device, contiguous    :: wz(nx,ny,nz) !< dw/dz at cell-center, precomputed by calc_div
    real(8), intent(inout), device, contiguous :: E(nx-1,ny-2,nz-2,5)
    integer i, j, k, it, jt, kt
    integer ii, i_base, idx, idx_r, offset_yz, offset_yzr, i1, i2
    logical :: jk_in_range, jk_in_range_grad_y, jk_in_range_grad_z, interior
    integer, parameter :: sx  = threadsE%x + 2*io + 1
    integer, parameter :: sxr = threadsE%x
    integer, parameter :: sy  = threadsE%y
    integer, parameter :: sz  = threadsE%z
    real(8), dimension(-(io-1):sx*sy*sz-io), shared :: rho, u, v, w, p, uy, uz
    real(8), dimension(sxr*sy*sz), shared           :: rhor, ur, vr, wr, pr
    real(8) rhol, ul, vl, wl, pl
    real(8) :: flux(5), mui
    real(sp) fdx  ! sp intentional: sensor interpolation does not need double precision
    it = threadIdx%x
    jt = threadIdx%y
    kt = threadIdx%z
    j  = (blockIdx%y-1)*blockDim%y + jt + 1
    k  = (blockIdx%z-1)*blockDim%z + kt + 1
    i_base     = (blockIdx%x-1)*blockDim%x
    offset_yz  = (jt-1) * sx  + (kt-1) * sx  * sy
    offset_yzr = (jt-1) * sxr + (kt-1) * sxr * sy
    jk_in_range        = (j >= 1 .and. j <= ny .and. k >= 1 .and. k <= nz)
    jk_in_range_grad_y = (4 <= j .and. j <= ny-3 .and. k >= 1 .and. k <= nz)
    jk_in_range_grad_z = (j >= 1 .and. j <= ny .and. 4 <= k .and. k <= nz-3)
    do ii = it-io, threadsE%x+io+1, blockDim%x
      i = i_base + ii
      if (i >= 1 .and. i <= nx .and. jk_in_range) then
        idx = ii + offset_yz
        rho(idx) = Q_1(i,j,k); u(idx) = Q_2(i,j,k); v(idx) = Q_3(i,j,k)
          w(idx) = Q_4(i,j,k); p(idx) = Q_5(i,j,k)
        if (jk_in_range_grad_y) then
          uy(idx) = (one_sixty * (-Q_2(i,j-3,k) + Q_2(i,j+3,k)) + 0.15d0 * (Q_2(i,j-2,k) - Q_2(i,j+2,k)) + 0.75d0 * (-Q_2(i,j-1,k) + Q_2(i,j+1,k))) * dy(j)
        endif
        if (jk_in_range_grad_z) then
          uz(idx) = (one_sixty * (-Q_2(i,j,k-3) + Q_2(i,j,k+3)) + 0.15d0 * (Q_2(i,j,k-2) - Q_2(i,j,k+2)) + 0.75d0 * (-Q_2(i,j,k-1) + Q_2(i,j,k+1))) * dz(k)
        endif
      endif
    enddo
    call syncthreads()
    i = (blockIdx%x-1)*blockDim%x + it
    if (io+1 <= i .and. i <= nx-(io+1) .and. j <= ny-1 .and. k <= nz-1) then
      idx   = it + offset_yz
      idx_r = it + offset_yzr
      i1    = idx - io
      i2    = idx + io + 1
      flux = 0.d0
      ! narrower than the convective validity above: vy/wz are only valid
      ! where calc_div_vy_6_in/calc_div_wz_6_in's own y/z-margin covers them
      interior = (4 <= j .and. j <= ny-3 .and. 4 <= k .and. k <= nz-3)
      if (interior) then
        mui = interp6_s(mu(i-2,j,k)+mu(i+3,j,k), mu(i-1,j,k)+mu(i+2,j,k), mu(i,j,k)+mu(i+1,j,k))
        block
          real(8) :: tau, utau
          call calc_tau_straight(mui, u(idx-io_v:idx+io_v+1), vy(i-io_v:i+io_v+1,j,k), wz(i-io_v:i+io_v+1,j,k), dx(i), tau, utau)
          flux(2) = flux(2) - tau
          flux(5) = flux(5) - utau
        end block
        block
          real(8) :: tau, utau
          call calc_tau_cross(mui, v(idx-io_v:idx+io_v+1), uy(idx-io_v:idx+io_v+1), dx(i), tau, utau)
          flux(3) = flux(3) - tau
          flux(5) = flux(5) - utau
        end block
        block
          real(8) :: tau, utau
          call calc_tau_cross(mui, w(idx-io_v:idx+io_v+1), uz(idx-io_v:idx+io_v+1), dx(i), tau, utau)
          flux(4) = flux(4) - tau
          flux(5) = flux(5) - utau
        end block
        block
          real(8) :: Tx, kTx
          Tx  = diff6_s(dx(i), -T(i-2,j,k)+T(i+3,j,k), T(i-1,j,k)-T(i+2,j,k), -T(i,j,k)+T(i+1,j,k))
          kTx = Cp_over_Pr * mui * Tx
          flux(5) = flux(5) - kTx
        end block
      endif
      fdx = 0.50_sp * (sensor(i,j,k) + sensor(i+1,j,k))
      call recon(id_acc, &
                 rho(i1:i2),  u(i1:i2),  v(i1:i2),  w(i1:i2),  p(i1:i2), &
                 rhol,        ul,        vl,        wl,        pl, &
                 rhor(idx_r), ur(idx_r), vr(idx_r), wr(idx_r), pr(idx_r), fdx)
    endif
    call syncthreads()
    if (io+1 <= i .and. i <= nx-(io+1) .and. j <= ny-1 .and. k <= nz-1) then
      block
        real(8) :: e1, e2, e3, e4, e5
        associate(un1 => ul, un2 => ur(idx_r))
          call SLAU(id_slau, rhol, rhor(idx_r), ul, ur(idx_r), vl, vr(idx_r), &
                    wl, wr(idx_r), un1, un2, pl, pr(idx_r), Normal_x, fdx, &
                    e1, e2, e3, e4, e5)
        end associate
        E(i,j-1,k-1,1) = e1
        E(i,j-1,k-1,2) = e2 + flux(2)
        E(i,j-1,k-1,3) = e3 + flux(3)
        E(i,j-1,k-1,4) = e4 + flux(4)
        E(i,j-1,k-1,5) = e5 + flux(5)
      end block
    endif
  end subroutine calc_slauv_x_in


  attributes(global) subroutine calc_slauv_y_in(nx, ny, nz, dx, dy, dz, Q_1, Q_2, Q_3, Q_4, Q_5, T, mu, sensor, ux, wz, F)
    use mod_constant, only : Normal_y
    integer, intent(in), value                 :: nx, ny, nz
    real(8), intent(in), device, contiguous    :: dx(nx-1), dy(ny-1), dz(nz-1)
    real(8), intent(in), device, contiguous    :: Q_1(nx,ny,nz), Q_2(nx,ny,nz), Q_3(nx,ny,nz), Q_4(nx,ny,nz), Q_5(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: T(nx,ny,nz), mu(nx,ny,nz)
    real(sp), intent(in), device, contiguous   :: sensor(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: ux(nx,ny,nz) !< du/dx at cell-center, precomputed by calc_div
    real(8), intent(in), device, contiguous    :: wz(nx,ny,nz) !< dw/dz at cell-center, precomputed by calc_div
    real(8), intent(inout), device, contiguous :: F(nx-2,ny-1,nz-2,5)
    integer i, j, k, it, jt, kt
    integer jj, j_base, idx, idx_r, offset_xz, offset_xzr, i1, i2
    logical :: ik_in_range, ik_in_range_grad_x, ik_in_range_grad_z, interior
    integer, parameter :: sx  = threadsF%x
    integer, parameter :: sy  = threadsF%y + 2*io + 1
    integer, parameter :: syr = threadsF%y
    integer, parameter :: sz  = threadsF%z
    real(8), dimension(-(io-1):sx*sy*sz-io), shared :: rho, u, v, w, p, vx, vz
    real(8), dimension(sx*syr*sz), shared           :: rhor, ur, vr, wr, pr
    real(8) rhol, ul, vl, wl, pl
    real(8) :: flux(5), mui
    real(sp) fdy  ! sp intentional: sensor interpolation does not need double precision
    it = threadIdx%x
    jt = threadIdx%y
    kt = threadIdx%z
    i  = (blockIdx%x-1)*blockDim%x + it + 1
    k  = (blockIdx%z-1)*blockDim%z + kt + 1
    j_base     = (blockIdx%y-1)*blockDim%y
    offset_xz  = (it-1) * sy  + (kt-1) * sy  * sx
    offset_xzr = (it-1) * syr + (kt-1) * syr * sx
    ik_in_range        = (i >= 1 .and. i <= nx .and. k >= 1 .and. k <= nz)
    ik_in_range_grad_x = (4 <= i .and. i <= nx-3 .and. k >= 1 .and. k <= nz)
    ik_in_range_grad_z = (i >= 1 .and. i <= nx .and. 4 <= k .and. k <= nz-3)
    do jj = jt-io, threadsF%y+io+1, blockDim%y
      j = j_base + jj
      if (ik_in_range .and. j >= 1 .and. j <= ny) then
        idx = jj + offset_xz
        rho(idx) = Q_1(i,j,k); u(idx) = Q_2(i,j,k); v(idx) = Q_3(i,j,k)
          w(idx) = Q_4(i,j,k); p(idx) = Q_5(i,j,k)
        if (ik_in_range_grad_x) then
          vx(idx) = (one_sixty * (-Q_3(i-3,j,k) + Q_3(i+3,j,k)) + 0.15d0 * (Q_3(i-2,j,k) - Q_3(i+2,j,k)) + 0.75d0 * (-Q_3(i-1,j,k) + Q_3(i+1,j,k))) * dx(i)
        endif
        if (ik_in_range_grad_z) then
          vz(idx) = (one_sixty * (-Q_3(i,j,k-3) + Q_3(i,j,k+3)) + 0.15d0 * (Q_3(i,j,k-2) - Q_3(i,j,k+2)) + 0.75d0 * (-Q_3(i,j,k-1) + Q_3(i,j,k+1))) * dz(k)
        endif
      endif
    enddo
    call syncthreads()
    j = (blockIdx%y-1)*blockDim%y + jt
    if (io+1 <= j .and. j <= ny-(io+1) .and. k <= nz-1 .and. i <= nx-1) then
      idx   = jt + offset_xz
      idx_r = jt + offset_xzr
      i1    = idx - io
      i2    = idx + io + 1
      flux = 0.d0
      interior = (4 <= i .and. i <= nx-3 .and. 4 <= k .and. k <= nz-3)
      if (interior) then
        mui = interp6_s(mu(i,j-2,k)+mu(i,j+3,k), mu(i,j-1,k)+mu(i,j+2,k), mu(i,j,k)+mu(i,j+1,k))
        block
          real(8) :: tau, utau
          call calc_tau_straight_s(mui, v(idx-io_v:idx+io_v+1), &
               wz(i,j-2,k)+wz(i,j+3,k), ux(i,j-2,k)+ux(i,j+3,k), &
               wz(i,j-1,k)+wz(i,j+2,k), ux(i,j-1,k)+ux(i,j+2,k), &
               wz(i,j,  k)+wz(i,j+1,k), ux(i,j,  k)+ux(i,j+1,k), &
               dy(j), tau, utau)
          flux(3) = flux(3) - tau
          flux(5) = flux(5) - utau
        end block
        block
          real(8) :: tau, utau
          call calc_tau_cross(mui, u(idx-io_v:idx+io_v+1), vx(idx-io_v:idx+io_v+1), dy(j), tau, utau)
          flux(2) = flux(2) - tau
          flux(5) = flux(5) - utau
        end block
        block
          real(8) :: tau, utau
          call calc_tau_cross(mui, w(idx-io_v:idx+io_v+1), vz(idx-io_v:idx+io_v+1), dy(j), tau, utau)
          flux(4) = flux(4) - tau
          flux(5) = flux(5) - utau
        end block
        block
          real(8) :: Ty, kTy
          Ty  = diff6_s(dy(j), -T(i,j-2,k)+T(i,j+3,k), T(i,j-1,k)-T(i,j+2,k), -T(i,j,k)+T(i,j+1,k))
          kTy = Cp_over_Pr * mui * Ty
          flux(5) = flux(5) - kTy
        end block
      endif
      fdy = 0.50_sp * (sensor(i,j,k) + sensor(i,j+1,k))
      call recon(id_acc, &
                 rho(i1:i2),  u(i1:i2),  v(i1:i2),  w(i1:i2),  p(i1:i2), &
                 rhol,        ul,        vl,        wl,        pl, &
                 rhor(idx_r), ur(idx_r), vr(idx_r), wr(idx_r), pr(idx_r), fdy)
    endif
    call syncthreads()
    if (io+1 <= j .and. j <= ny-(io+1) .and. k <= nz-1 .and. i <= nx-1) then
      block
        real(8) :: e1, e2, e3, e4, e5
        associate(un1 => vl, un2 => vr(idx_r))
          call SLAU(id_slau, rhol, rhor(idx_r), ul, ur(idx_r), vl, vr(idx_r), &
                    wl, wr(idx_r), un1, un2, pl, pr(idx_r), Normal_y, fdy, &
                    e1, e2, e3, e4, e5)
        end associate
        F(i-1,j,k-1,1) = e1
        F(i-1,j,k-1,2) = e2 + flux(2)
        F(i-1,j,k-1,3) = e3 + flux(3)
        F(i-1,j,k-1,4) = e4 + flux(4)
        F(i-1,j,k-1,5) = e5 + flux(5)
      end block
    endif
  end subroutine calc_slauv_y_in


  attributes(global) subroutine calc_slauv_z_in(nx, ny, nz, dx, dy, dz, Q_1, Q_2, Q_3, Q_4, Q_5, T, mu, sensor, ux, vy, G)
    use mod_constant, only : Normal_z
    integer, intent(in), value                 :: nx, ny, nz
    real(8), intent(in), device, contiguous    :: dx(nx-1), dy(ny-1), dz(nz-1)
    real(8), intent(in), device, contiguous    :: Q_1(nx,ny,nz), Q_2(nx,ny,nz), Q_3(nx,ny,nz), Q_4(nx,ny,nz), Q_5(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: T(nx,ny,nz), mu(nx,ny,nz)
    real(sp), intent(in), device, contiguous   :: sensor(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: ux(nx,ny,nz) !< du/dx at cell-center, precomputed by calc_div
    real(8), intent(in), device, contiguous    :: vy(nx,ny,nz) !< dv/dy at cell-center, precomputed by calc_div
    real(8), intent(inout), device, contiguous :: G(nx-2,ny-2,nz-1,5)
    integer i, j, k, it, jt, kt
    integer kk, k_base, idx, idx_r, offset_xy, offset_xyr, i1, i2
    logical :: ij_in_range, ij_in_range_grad_x, ij_in_range_grad_y, interior
    integer, parameter :: sx  = threadsG%x
    integer, parameter :: sy  = threadsG%y
    integer, parameter :: sz  = threadsG%z + 2*io + 1
    integer, parameter :: szr = threadsG%z
    real(8), dimension(-(io-1):sx*sy*sz-io), shared :: rho, u, v, w, p, wx, wy
    real(8), dimension(sx*sy*szr), shared           :: rhor, ur, vr, wr, pr
    real(8) rhol, ul, vl, wl, pl
    real(8) :: flux(5), mui
    real(sp) fdz  ! sp intentional: sensor interpolation does not need double precision
    it = threadIdx%x
    jt = threadIdx%y
    kt = threadIdx%z
    i  = (blockIdx%x-1)*blockDim%x + it + 1
    j  = (blockIdx%y-1)*blockDim%y + jt + 1
    k_base     = (blockIdx%z-1)*blockDim%z
    offset_xy  = (jt-1) * sz  + (it-1) * sz  * sy
    offset_xyr = (jt-1) * szr + (it-1) * szr * sy
    ij_in_range        = (i >= 1 .and. i <= nx .and. j >= 1 .and. j <= ny)
    ij_in_range_grad_x = (4 <= i .and. i <= nx-3 .and. j >= 1 .and. j <= ny)
    ij_in_range_grad_y = (i >= 1 .and. i <= nx .and. 4 <= j .and. j <= ny-3)
    do kk = kt-io, threadsG%z+io+1, blockDim%z
      k = k_base + kk
      if (ij_in_range .and. k >= 1 .and. k <= nz) then
        idx = kk + offset_xy
        rho(idx) = Q_1(i,j,k); u(idx) = Q_2(i,j,k); v(idx) = Q_3(i,j,k)
          w(idx) = Q_4(i,j,k); p(idx) = Q_5(i,j,k)
        if (ij_in_range_grad_x) then
          wx(idx) = (one_sixty * (-Q_4(i-3,j,k) + Q_4(i+3,j,k)) + 0.15d0 * (Q_4(i-2,j,k) - Q_4(i+2,j,k)) + 0.75d0 * (-Q_4(i-1,j,k) + Q_4(i+1,j,k))) * dx(i)
        endif
        if (ij_in_range_grad_y) then
          wy(idx) = (one_sixty * (-Q_4(i,j-3,k) + Q_4(i,j+3,k)) + 0.15d0 * (Q_4(i,j-2,k) - Q_4(i,j+2,k)) + 0.75d0 * (-Q_4(i,j-1,k) + Q_4(i,j+1,k))) * dy(j)
        endif
      endif
    enddo
    call syncthreads()
    k = (blockIdx%z-1)*blockDim%z + kt
    if (io+1 <= k .and. k <= nz-(io+1) .and. i <= nx-1 .and. j <= ny-1) then
      idx   = kt + offset_xy
      idx_r = kt + offset_xyr
      i1    = idx - io
      i2    = idx + io + 1
      flux = 0.d0
      interior = (4 <= i .and. i <= nx-3 .and. 4 <= j .and. j <= ny-3)
      if (interior) then
        mui = interp6_s(mu(i,j,k-2)+mu(i,j,k+3), mu(i,j,k-1)+mu(i,j,k+2), mu(i,j,k)+mu(i,j,k+1))
        block
          real(8) :: tau, utau
          call calc_tau_straight_s(mui, w(idx-io_v:idx+io_v+1), &
               ux(i,j,k-2)+ux(i,j,k+3), vy(i,j,k-2)+vy(i,j,k+3), &
               ux(i,j,k-1)+ux(i,j,k+2), vy(i,j,k-1)+vy(i,j,k+2), &
               ux(i,j,k  )+ux(i,j,k+1), vy(i,j,k  )+vy(i,j,k+1), &
               dz(k), tau, utau)
          flux(4) = flux(4) - tau
          flux(5) = flux(5) - utau
        end block
        block
          real(8) :: tau, utau
          call calc_tau_cross(mui, u(idx-io_v:idx+io_v+1), wx(idx-io_v:idx+io_v+1), dz(k), tau, utau)
          flux(2) = flux(2) - tau
          flux(5) = flux(5) - utau
        end block
        block
          real(8) :: tau, utau
          call calc_tau_cross(mui, v(idx-io_v:idx+io_v+1), wy(idx-io_v:idx+io_v+1), dz(k), tau, utau)
          flux(3) = flux(3) - tau
          flux(5) = flux(5) - utau
        end block
        block
          real(8) :: Tz, kTz
          Tz  = diff6_s(dz(k), -T(i,j,k-2)+T(i,j,k+3), T(i,j,k-1)-T(i,j,k+2), -T(i,j,k)+T(i,j,k+1))
          kTz = Cp_over_Pr * mui * Tz
          flux(5) = flux(5) - kTz
        end block
      endif
      fdz = 0.50_sp * (sensor(i,j,k) + sensor(i,j,k+1))
      call recon(id_acc, &
                 rho(i1:i2),  u(i1:i2),  v(i1:i2),  w(i1:i2),  p(i1:i2), &
                 rhol,        ul,        vl,        wl,        pl, &
                 rhor(idx_r), ur(idx_r), vr(idx_r), wr(idx_r), pr(idx_r), fdz)
    endif
    call syncthreads()
    if (io+1 <= k .and. k <= nz-(io+1) .and. i <= nx-1 .and. j <= ny-1) then
      block
        real(8) :: e1, e2, e3, e4, e5
        associate(un1 => wl, un2 => wr(idx_r))
          call SLAU(id_slau, rhol, rhor(idx_r), ul, ur(idx_r), vl, vr(idx_r), &
                    wl, wr(idx_r), un1, un2, pl, pr(idx_r), Normal_z, fdz, &
                    e1, e2, e3, e4, e5)
        end associate
        G(i-1,j-1,k,1) = e1
        G(i-1,j-1,k,2) = e2 + flux(2)
        G(i-1,j-1,k,3) = e3 + flux(3)
        G(i-1,j-1,k,4) = e4 + flux(4)
        G(i-1,j-1,k,5) = e5 + flux(5)
      end block
    endif
  end subroutine calc_slauv_z_in
end module calc_slau_visc_kernel_internal
#:else
module calc_slau_visc_kernel_internal
end module calc_slau_visc_kernel_internal
#:endif
