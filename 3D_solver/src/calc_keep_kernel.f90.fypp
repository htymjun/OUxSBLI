#:include 'config.fypp'
#:if not defined('COMMZ')
  #:set COMMZ = False
#:endif
#! With COMMZ the x/y kernels also get a "_koff" twin that sweeps only the z
#! planes [k_lo, k_hi], so calc_flux_base can evaluate the planes whose stencil
#! reaches a z ghost plane after the halo exchange has landed.
#:set KOFF_VARIANTS = [False, True] if COMMZ else [False]
#:if not defined('KEEP_TVD')
  #:set KEEP_TVD = False
#:endif
#! KEEP_TVD=True adds a MUSCL-limited Rusanov dissipation term to the KEEP
#! central flux, so that `TVD` actually reaches this scheme instead of being
#! silently ignored. See calc_keep_tvd.f90.fypp for the formula and for what
#! it costs (KEEP stops being exactly entropy/kinetic-energy preserving).
#:set MD = ' - D' if KEEP_TVD else ''
module calc_keep_kernel
  use mod_globals, only : gamma, threadsE, threadsF, threadsG
  use mod_constant, only : R_over_gamma_1, one_third, one_sixth, one_twelfth, two_third
  use libm
  #:if KEEP_TVD
  use mod_globals, only : sp
  use mod_constant, only : over_gamma_1
  use calc_muscl
  #:endif
  implicit none
  private
  public calc_keep_x, calc_keep_y, calc_keep_z
  #:if COMMZ
  public calc_keep_x_koff, calc_keep_y_koff
  #:endif
  real(8), parameter :: one_24        = 1.d0 / 24.d0
  real(8), parameter :: one_48        = 1.d0 / 48.d0
  real(8), parameter :: one_60        = 1.d0 / 60.d0
  real(8), parameter :: one_120       = 1.d0 / 120.d0
  real(8), parameter :: one_240       = 1.d0 / 240.d0
  real(8), parameter :: seven_twelfth = 7.d0 / 12.d0
  integer, parameter :: io            = ${ORDER_IO}$
  #:if ORDER == 6
  integer(8), parameter :: id_acc   = 0_8
  integer(4), parameter :: id_acc4 = 0_4
  integer(2), parameter :: id_acc2 = 0_2
  #:elif ORDER == 4
  integer(4), parameter :: id_acc   = 0_4
  integer(2), parameter :: id_acc2 = 0_2
  #:else
  integer(2), parameter :: id_acc   = 0_2
  #:endif

  interface KEEP
    module procedure KEEP2, KEEP4, KEEP6
  end interface KEEP
  #:if KEEP_TVD
  interface delta_r
    module procedure delta_r2, delta_r4, delta_r6
  end interface delta_r

  interface keep_diss
    module procedure keep_diss2, keep_diss4, keep_diss6
  end interface keep_diss
  #:endif
contains
  include 'calc_scheme_math.f90'
#:if KEEP_TVD
#:include 'calc_keep_tvd.f90.fypp'
#:endif

#:for is_koff in KOFF_VARIANTS
#:set sfx  = '_koff' if is_koff else ''
#:set karg = ', k_lo, k_hi' if is_koff else ''
  attributes(global) subroutine calc_keep_x${sfx}$(nx, ny, nz, Q_1, Q_2, Q_3, Q_4, Q_5, T, E${karg}$)
    use mod_constant, only : Normal_x
    integer, intent(in), value                :: nx, ny, nz${karg}$
    real(8), intent(in), device, contiguous   :: Q_1(nx,ny,nz), Q_2(nx,ny,nz), Q_3(nx,ny,nz), Q_4(nx,ny,nz), Q_5(nx,ny,nz), T(nx,ny,nz)
    real(8), intent(${'inout' if is_koff else 'out'}$), device, contiguous  :: E(nx-1,ny-2,nz-2,5)
    integer i, j, k, it, jt, kt
#:if KEEP_TVD
    real(8) :: D(5)   ! limited Rusanov dissipation (calc_keep_tvd.f90.fypp)
#:endif
    integer :: ii, i_base, idx, offset_yz
    logical :: jk_in_range
    integer, parameter :: sx = threadsE%x + 2*io + 1
    integer, parameter :: sy = threadsE%y
    integer, parameter :: sz = threadsE%z
    real(8), dimension(-(io-1):sx*sy*sz-io), shared :: rho, u, v, w, p, tmp
    it = threadIdx%x
    jt = threadIdx%y
    kt = threadIdx%z
    j  = (blockIdx%y-1)*blockDim%y + jt + 1
    k  = (blockIdx%z-1)*blockDim%z + kt + ${'k_lo - 1' if is_koff else '1'}$
    i_base = (blockIdx%x-1)*blockDim%x
    offset_yz = (jt-1) * sx + (kt-1) * sx * sy
    jk_in_range = (j >= 1 .and. j <= ny .and. k >= 1 .and. k <= nz)
    do ii = it-io, threadsE%x+io+1, blockDim%x
      i = i_base + ii
      if (i >= 1 .and. i <= nx .and. jk_in_range) then
        idx = ii + offset_yz
        rho(idx) = Q_1(i,j,k);   u(idx) = Q_2(i,j,k)
          v(idx) = Q_3(i,j,k);   w(idx) = Q_4(i,j,k)
          p(idx) = Q_5(i,j,k); tmp(idx) =   T(i,j,k)
      endif
    enddo
    call syncthreads()
    i = (blockIdx%x-1)*blockDim%x + it
    if (nx-1 < i .or. ny-1 < j .or. ${'k_hi' if is_koff else 'nz-1'}$ < k) return
    idx = it + offset_yz
    associate(uu => u)
    #:if ORDER == 6
    if (3 <= i .and. i <= nx-3) then
#:if KEEP_TVD
      call keep_diss(id_acc, rho(idx-2:idx+3), u(idx-2:idx+3), v(idx-2:idx+3), &
                     w(idx-2:idx+3), p(idx-2:idx+3), Normal_x, D)
#:endif
      E(i,j-1,k-1,:) = KEEP(id_acc,        rho(idx-2:idx+3), u(idx-2:idx+3),   v(idx-2:idx+3), &
                            w(idx-2:idx+3), uu(idx-2:idx+3), p(idx-2:idx+3), tmp(idx-2:idx+3), Normal_x)${MD}$
    elseif (2 <= i .and. i <= nx-2) then
#:if KEEP_TVD
      call keep_diss(id_acc4, rho(idx-1:idx+2), u(idx-1:idx+2), v(idx-1:idx+2), &
                     w(idx-1:idx+2), p(idx-1:idx+2), Normal_x, D)
#:endif
      E(i,j-1,k-1,:) = KEEP(id_acc4,       rho(idx-1:idx+2), u(idx-1:idx+2),   v(idx-1:idx+2), &
                            w(idx-1:idx+2), uu(idx-1:idx+2), p(idx-1:idx+2), tmp(idx-1:idx+2), Normal_x)${MD}$
    else
#:if KEEP_TVD
      call keep_diss(id_acc2, rho(idx:idx+1), u(idx:idx+1), v(idx:idx+1), &
                     w(idx:idx+1), p(idx:idx+1), Normal_x, D)
#:endif
      E(i,j-1,k-1,:) = KEEP(id_acc2,       rho(idx:idx+1),   u(idx:idx+1),     v(idx:idx+1), &
                            w(idx:idx+1),   uu(idx:idx+1),   p(idx:idx+1),   tmp(idx:idx+1),   Normal_x)${MD}$
    endif
    #:elif ORDER == 4
    if (2 <= i .and. i <= nx-2) then
#:if KEEP_TVD
      call keep_diss(id_acc, rho(idx-1:idx+2), u(idx-1:idx+2), v(idx-1:idx+2), &
                     w(idx-1:idx+2), p(idx-1:idx+2), Normal_x, D)
#:endif
      E(i,j-1,k-1,:) = KEEP(id_acc,        rho(idx-1:idx+2), u(idx-1:idx+2),   v(idx-1:idx+2), &
                            w(idx-1:idx+2), uu(idx-1:idx+2), p(idx-1:idx+2), tmp(idx-1:idx+2), Normal_x)${MD}$
    else
#:if KEEP_TVD
      call keep_diss(id_acc2, rho(idx:idx+1), u(idx:idx+1), v(idx:idx+1), &
                     w(idx:idx+1), p(idx:idx+1), Normal_x, D)
#:endif
      E(i,j-1,k-1,:) = KEEP(id_acc2,       rho(idx:idx+1),   u(idx:idx+1),     v(idx:idx+1), &
                            w(idx:idx+1),   uu(idx:idx+1),   p(idx:idx+1),   tmp(idx:idx+1),   Normal_x)${MD}$
    endif
    #:else
#:if KEEP_TVD
      call keep_diss(id_acc, rho(idx:idx+1), u(idx:idx+1), v(idx:idx+1), &
                     w(idx:idx+1), p(idx:idx+1), Normal_x, D)
#:endif
      E(i,j-1,k-1,:) = KEEP(id_acc,        rho(idx:idx+1),   u(idx:idx+1),     v(idx:idx+1), &
                            w(idx:idx+1),   uu(idx:idx+1),   p(idx:idx+1),   tmp(idx:idx+1),   Normal_x)${MD}$
    #:endif
    end associate
  end subroutine calc_keep_x${sfx}$
#:endfor


#:for is_koff in KOFF_VARIANTS
#:set sfx  = '_koff' if is_koff else ''
#:set karg = ', k_lo, k_hi' if is_koff else ''
  attributes(global) subroutine calc_keep_y${sfx}$(nx, ny, nz, Q_1, Q_2, Q_3, Q_4, Q_5, T, F${karg}$)
    use mod_constant, only : Normal_y
    integer, intent(in), value                :: nx, ny, nz${karg}$
    real(8), intent(in), device, contiguous   :: Q_1(nx,ny,nz), Q_2(nx,ny,nz), Q_3(nx,ny,nz), Q_4(nx,ny,nz), Q_5(nx,ny,nz), T(nx,ny,nz)
    real(8), intent(${'inout' if is_koff else 'out'}$), device, contiguous  :: F(nx-2,ny-1,nz-2,5)
    integer i, j, k, it, jt, kt
#:if KEEP_TVD
    real(8) :: D(5)   ! limited Rusanov dissipation (calc_keep_tvd.f90.fypp)
#:endif
    integer :: jj, j_base, idx, offset_xz
    logical :: ik_in_range

    integer, parameter :: sx = threadsF%x
    integer, parameter :: sy = threadsF%y + 2*io + 1
    integer, parameter :: sz = threadsF%z
    real(8), dimension(-(io-1):sx*sy*sz-io), shared :: rho, u, v, w, p, tmp

    it = threadIdx%x
    jt = threadIdx%y
    kt = threadIdx%z
    i  = (blockIdx%x-1)*blockDim%x + it + 1
    k  = (blockIdx%z-1)*blockDim%z + kt + ${'k_lo - 1' if is_koff else '1'}$
    j_base = (blockIdx%y-1)*blockDim%y
    offset_xz = (it-1) * sy + (kt-1) * sy * sx
    ik_in_range = (i >= 1 .and. i <= nx .and. k >= 1 .and. k <= nz)

    do jj = jt-io, threadsF%y+io+1, blockDim%y
      j = j_base + jj
      if (ik_in_range .and. j >= 1 .and. j <= ny) then
        idx = jj + offset_xz
        rho(idx) = Q_1(i,j,k);   u(idx) = Q_2(i,j,k)
          v(idx) = Q_3(i,j,k);   w(idx) = Q_4(i,j,k)
          p(idx) = Q_5(i,j,k); tmp(idx) =   T(i,j,k)
      endif
    enddo
    call syncthreads()
    
    j = (blockIdx%y-1)*blockDim%y + jt
    if (nx-1 < i .or. ny-1 < j .or. ${'k_hi' if is_koff else 'nz-1'}$ < k) return
    
    idx = jt + offset_xz
    associate(vv => v)
    
    #:if ORDER == 6
    if (3 <= j .and. j <= ny-3) then
#:if KEEP_TVD
      call keep_diss(id_acc, rho(idx-2:idx+3), u(idx-2:idx+3), v(idx-2:idx+3), &
                     w(idx-2:idx+3), p(idx-2:idx+3), Normal_y, D)
#:endif
      F(i-1,j,k-1,:) = KEEP(id_acc,        rho(idx-2:idx+3), u(idx-2:idx+3),   v(idx-2:idx+3), &
                            w(idx-2:idx+3), vv(idx-2:idx+3), p(idx-2:idx+3), tmp(idx-2:idx+3), Normal_y)${MD}$
    elseif (2 <= j .and. j <= ny-2) then
#:if KEEP_TVD
      call keep_diss(id_acc4, rho(idx-1:idx+2), u(idx-1:idx+2), v(idx-1:idx+2), &
                     w(idx-1:idx+2), p(idx-1:idx+2), Normal_y, D)
#:endif
      F(i-1,j,k-1,:) = KEEP(id_acc4,       rho(idx-1:idx+2), u(idx-1:idx+2),   v(idx-1:idx+2), &
                            w(idx-1:idx+2), vv(idx-1:idx+2), p(idx-1:idx+2), tmp(idx-1:idx+2), Normal_y)${MD}$
    else
#:if KEEP_TVD
      call keep_diss(id_acc2, rho(idx:idx+1), u(idx:idx+1), v(idx:idx+1), &
                     w(idx:idx+1), p(idx:idx+1), Normal_y, D)
#:endif
      F(i-1,j,k-1,:) = KEEP(id_acc2,       rho(idx:idx+1),   u(idx:idx+1),     v(idx:idx+1),   &
                            w(idx:idx+1),   vv(idx:idx+1),   p(idx:idx+1),   tmp(idx:idx+1),   Normal_y)${MD}$
    endif
    #:elif ORDER == 4
    if (2 <= j .and. j <= ny-2) then
#:if KEEP_TVD
      call keep_diss(id_acc, rho(idx-1:idx+2), u(idx-1:idx+2), v(idx-1:idx+2), &
                     w(idx-1:idx+2), p(idx-1:idx+2), Normal_y, D)
#:endif
      F(i-1,j,k-1,:) = KEEP(id_acc,        rho(idx-1:idx+2), u(idx-1:idx+2),   v(idx-1:idx+2), &
                            w(idx-1:idx+2), vv(idx-1:idx+2), p(idx-1:idx+2), tmp(idx-1:idx+2), Normal_y)${MD}$
    else
#:if KEEP_TVD
      call keep_diss(id_acc2, rho(idx:idx+1), u(idx:idx+1), v(idx:idx+1), &
                     w(idx:idx+1), p(idx:idx+1), Normal_y, D)
#:endif
      F(i-1,j,k-1,:) = KEEP(id_acc2,       rho(idx:idx+1),   u(idx:idx+1),     v(idx:idx+1),   &
                            w(idx:idx+1),   vv(idx:idx+1),   p(idx:idx+1),   tmp(idx:idx+1),   Normal_y)${MD}$
    endif
    #:else
#:if KEEP_TVD
      call keep_diss(id_acc, rho(idx:idx+1), u(idx:idx+1), v(idx:idx+1), &
                     w(idx:idx+1), p(idx:idx+1), Normal_y, D)
#:endif
      F(i-1,j,k-1,:) = KEEP(id_acc,        rho(idx:idx+1),   u(idx:idx+1),     v(idx:idx+1),   &
                            w(idx:idx+1),   vv(idx:idx+1),   p(idx:idx+1),   tmp(idx:idx+1),   Normal_y)${MD}$
    #:endif
    end associate
  end subroutine calc_keep_y${sfx}$
#:endfor


  attributes(global) subroutine calc_keep_z(nx, ny, nz, Q_1, Q_2, Q_3, Q_4, Q_5, T, G)
    use mod_constant, only : Normal_z
    integer, intent(in), value                :: nx, ny, nz
    real(8), intent(in), device, contiguous   :: Q_1(nx,ny,nz), Q_2(nx,ny,nz), Q_3(nx,ny,nz), Q_4(nx,ny,nz), Q_5(nx,ny,nz), T(nx,ny,nz)
    real(8), intent(out), device, contiguous  :: G(nx-2,ny-2,nz-1,5)
    integer i, j, k, it, jt, kt
#:if KEEP_TVD
    real(8) :: D(5)   ! limited Rusanov dissipation (calc_keep_tvd.f90.fypp)
#:endif
    integer :: kk, k_base, idx, offset_xy
    logical :: ij_in_range

    integer, parameter :: sx = threadsG%x
    integer, parameter :: sy = threadsG%y
    integer, parameter :: sz = threadsG%z + 2*io + 1
    real(8), dimension(-(io-1):sx*sy*sz-io), shared :: rho, u, v, w, p, tmp

    it = threadIdx%x
    jt = threadIdx%y
    kt = threadIdx%z
    i  = (blockIdx%x-1)*blockDim%x + it + 1
    j  = (blockIdx%y-1)*blockDim%y + jt + 1
    k_base = (blockIdx%z-1)*blockDim%z
    offset_xy = (jt-1) * sz + (it-1) * sz * sy
    ij_in_range = (i >= 1 .and. i <= nx .and. j >= 1 .and. j <= ny)

    do kk = kt-io, threadsG%z+io+1, blockDim%z
      k = k_base + kk
      if (ij_in_range .and. k >= 1 .and. k <= nz) then
        idx = kk + offset_xy
        rho(idx) = Q_1(i,j,k);   u(idx) = Q_2(i,j,k)
          v(idx) = Q_3(i,j,k);   w(idx) = Q_4(i,j,k)
          p(idx) = Q_5(i,j,k); tmp(idx) =   T(i,j,k)
      endif
    enddo
    call syncthreads()
    
    k = (blockIdx%z-1)*blockDim%z + kt
    if (nx-1 < i .or. ny-1 < j .or. nz-1 < k) return
    
    idx = kt + offset_xy
    associate(ww => w)
    
    #:if ORDER == 6
    if (3 <= k .and. k <= nz-3) then
#:if KEEP_TVD
      call keep_diss(id_acc, rho(idx-2:idx+3), u(idx-2:idx+3), v(idx-2:idx+3), &
                     w(idx-2:idx+3), p(idx-2:idx+3), Normal_z, D)
#:endif
      G(i-1,j-1,k,:) = KEEP(id_acc,        rho(idx-2:idx+3), u(idx-2:idx+3),   v(idx-2:idx+3), &
                            w(idx-2:idx+3), ww(idx-2:idx+3), p(idx-2:idx+3), tmp(idx-2:idx+3), Normal_z)${MD}$
    elseif (2 <= k .and. k <= nz-2) then
#:if KEEP_TVD
      call keep_diss(id_acc4, rho(idx-1:idx+2), u(idx-1:idx+2), v(idx-1:idx+2), &
                     w(idx-1:idx+2), p(idx-1:idx+2), Normal_z, D)
#:endif
      G(i-1,j-1,k,:) = KEEP(id_acc4,       rho(idx-1:idx+2), u(idx-1:idx+2),   v(idx-1:idx+2), &
                            w(idx-1:idx+2), ww(idx-1:idx+2), p(idx-1:idx+2), tmp(idx-1:idx+2), Normal_z)${MD}$
    else
#:if KEEP_TVD
      call keep_diss(id_acc2, rho(idx:idx+1), u(idx:idx+1), v(idx:idx+1), &
                     w(idx:idx+1), p(idx:idx+1), Normal_z, D)
#:endif
      G(i-1,j-1,k,:) = KEEP(id_acc2,       rho(idx:idx+1),   u(idx:idx+1),     v(idx:idx+1),   &
                            w(idx:idx+1),   ww(idx:idx+1),   p(idx:idx+1),   tmp(idx:idx+1),   Normal_z)${MD}$
    endif
    #:elif ORDER == 4
    if (2 <= k .and. k <= nz-2) then
#:if KEEP_TVD
      call keep_diss(id_acc, rho(idx-1:idx+2), u(idx-1:idx+2), v(idx-1:idx+2), &
                     w(idx-1:idx+2), p(idx-1:idx+2), Normal_z, D)
#:endif
      G(i-1,j-1,k,:) = KEEP(id_acc,        rho(idx-1:idx+2), u(idx-1:idx+2),   v(idx-1:idx+2), &
                            w(idx-1:idx+2), ww(idx-1:idx+2), p(idx-1:idx+2), tmp(idx-1:idx+2), Normal_z)${MD}$
    else
#:if KEEP_TVD
      call keep_diss(id_acc2, rho(idx:idx+1), u(idx:idx+1), v(idx:idx+1), &
                     w(idx:idx+1), p(idx:idx+1), Normal_z, D)
#:endif
      G(i-1,j-1,k,:) = KEEP(id_acc2,       rho(idx:idx+1),   u(idx:idx+1),     v(idx:idx+1),   &
                            w(idx:idx+1),   ww(idx:idx+1),   p(idx:idx+1),   tmp(idx:idx+1),   Normal_z)${MD}$
    endif
    #:else
#:if KEEP_TVD
      call keep_diss(id_acc, rho(idx:idx+1), u(idx:idx+1), v(idx:idx+1), &
                     w(idx:idx+1), p(idx:idx+1), Normal_z, D)
#:endif
      G(i-1,j-1,k,:) = KEEP(id_acc,        rho(idx:idx+1),   u(idx:idx+1),     v(idx:idx+1),   &
                            w(idx:idx+1),   ww(idx:idx+1),   p(idx:idx+1),   tmp(idx:idx+1),   Normal_z)${MD}$
    #:endif
    end associate
  end subroutine calc_keep_z
end module calc_keep_kernel
