!> Module for time-stepping orchestration and time integration schemes
!> Implements 3rd-order and 4th-order Runge-Kutta time stepping with MPI/GPU support
#:include 'config.fypp'
#:if not defined('MPI')
  #:set MPI = 'CPU'
#:endif
#:if not defined('BC_FORCING')
  #:set BC_FORCING = False
#:endif
#! BC_FORCING=True: the case's set_bc takes extra arguments (x, z, random
#! phases, current step) for a time-dependent blowing/suction strip. Only
#! SWLBLI defines it; every other case keeps the plain set_bc signature.
#:set bc_extra = 'x, z, phi_l_gpu, phi_m_gpu, t_now, ' if BC_FORCING else ''
#! Initial value of the running-mean counter of the rescaling profile Qm: a restart
#! resumes from recal/Qm.dat with the weight of 2000 steps (see calc_mean, pre_rescale).
#:set QM_STEP0 = 2001 if RESTART else 1
#:if BC_FORCING and RESCALE
  #:stop 'BC_FORCING is only implemented for the RESCALE=False time loops (RK=3 and RK=4, with or without COMMZ)'
#:endif
#! ---------------------------------------------------------------------------
#! One RungeKutta routine for RK = 3 | 4, with or without RESCALE or COMMZ.
#! Q5('QJ') is the argument list "QJ_1, QJ_2, QJ_3, QJ_4, QJ_5".
#! STAGES lists, per RK stage, (state the fluxes are computed from, update kernel
#! call, state the kernel writes and set_bc is applied to):
#!   RK = 3 (TVD):  Q1 = Q^n + dt R(Q^n);  Q2 = 3/4 Q^n + 1/4 (Q1 + dt R(Q1));
#!                  Q^(n+1) = 1/3 Q^n + 2/3 (Q2 + dt R(Q2)).  QJ2 holds Q1, then Q2.
#!   RK = 4 (classical): QJs holds Q^n + c dt k_i, Rs accumulates k1 + 2 k2 + 2 k3;
#!                  calc_step4 adds k4, writes Q^(n+1) to QJ and clears Rs.
#! ---------------------------------------------------------------------------
#:set Q5 = lambda p: ', '.join('%s_%d' % (p, i) for i in range(1, 6))
#:set SA = 'QJ2' if RK == 3 else 'QJs'
#:set GEOM = 'dtdxdy, dtdydz, dtdzdx, E, F, G, '
#:if RK == 3
  #:set STAGES = [('QJ',  'calc_step1<<<blocks,threads>>>(nx, ny, nz, 1.d0, ' + GEOM + Q5('QJ') + ', ' + Q5('QJ2') + ')', 'QJ2'), &
                & ('QJ2', 'calc_step2_3<<<blocks,threads>>>(nx, ny, nz, 0.75d0, 0.25d0, 0.25d0, 1.d0, ' + GEOM + Q5('QJ') + ', ' + Q5('QJ2') + ')', 'QJ2'), &
                & ('QJ2', 'calc_step2_3<<<blocks,threads>>>(nx, ny, nz, 2.d0, 1.d0, 2.d0, one_third, ' + GEOM + Q5('QJ2') + ', ' + Q5('QJ') + ')', 'QJ')]
#:else
  #:set STAGES = [(q, 'calc_step<<<blocks,threads>>>(nx, ny, nz, ' + c + ', ' + GEOM + Q5('QJ') + ', ' + Q5('QJs') + ', Rs)', 'QJs') &
                & for q, c in (('QJ', '0.5d0, 1.d0'), ('QJs', '0.5d0, 2.d0'), ('QJs', '1.0d0, 2.d0'))] &
                & + [('QJs', 'calc_step4<<<blocks,threads>>>(nx, ny, nz, ' + GEOM + 'Rs, ' + Q5('QJ') + ')', 'QJ')]
#:endif
#! One RK stage on a compute rank: fluxes of qin, update kernel upd, boundary condition on qout.
#! RESCALE hands the recycling plane to the I/O rank first and waits for the rescaled inlet
#! before set_bc; COMMZ computes the stencil-safe interior while the z halo is in flight.
#:def stage(num, qin, upd, qout)
  #:set FLUX_ARGS = 'nx, ny, nz, xix, etay, zetaz, Jacobian, ' + Q5(qin) + ', ' + Q5('Q') + ', T, mu, mut, qc2, ux, vy, wz, E, F, G'
  #:if RESCALE
          call step_rescale(${num}$, myrank, nx, ny, nz, step, flag_re, flag_req, ireq, ireq2, Jacobian, &
                            ${Q5(qin)}$, ${Q5('Qm')}$, ${Q5('Qre')}$)
  #:endif
  #:if COMMZ
          call start_exchange_z(myrank, nranks, overlap, nx, ny, nz, ${Q5(qin)}$, &
                                Qs1d_lo, Qs1d_hi, Qr1d_lo, Qr1d_hi, send_lo, send_hi, recv_lo, recv_hi, req_z)
  #:endif
          call calc_EFG(${FLUX_ARGS}$)
  #:if COMMZ
          call finish_exchange_z(overlap, nx, ny, nz, recv_lo, recv_hi, Qr1d_lo, Qr1d_hi, ${Q5(qin)}$, req_z)
          call calc_EFG_halo(${FLUX_ARGS}$)
  #:endif
          call ${upd}$
  #:if RESCALE
          call wait_rescale(myrank, ireq, ireq2, istat, istat2)
          call set_bc(myrank, nx, ny, nz, Jacobian, ${Q5(qout)}$, ${Q5('Qre')}$)
  #:else
          call set_bc(myrank, nx, ny, nz, ${bc_extra}$Jacobian, ${Q5(qout)}$)
  #:endif
#:enddef
module calc_time_dev
  use cudafor
  use mpi
  use nvtx
  use mod_globals, only : nt, np, nre2, rerank, &
  & blocks, threads, blocksE, blocksF, blocksG, threadsE, threadsF, threadsG, &
  & blocksEv, blocksFv, blocksGv, threadsEv, threadsFv, threadsGv
  use mod_constant, only : one_third
  use calc_flux_base
  use calc_steps
  use calc_rescale
  use calc_para
  use set
  use preprocess
  use print
  implicit none
  public RungeKutta
contains

  !> Runge-Kutta time integration (RK = ${RK}$${', recycling-rescaling inflow' if RESCALE else ''}$${', z-decomposed with overlapped halo exchange' if COMMZ else ''}$).
  !> Even ranks compute on their GPU; odd ranks receive the snapshots and write them
  !> (and, with RESCALE, rank rerank+1 rescales the recycling plane on the host each stage).
  subroutine RungeKutta(myrank, mygpu, nx, ny, nz, x, dx_cpu, y, dy_cpu, z, dz_cpu, Jacobian_cpu, Q)
    integer, intent(in)    :: myrank, mygpu, nx, ny, nz
    real(8), intent(in)    :: x(nx), dx_cpu(nx-1), y(ny), dy_cpu(ny-1)
    real(8), intent(in)    :: z(nz), dz_cpu(nz-1), Jacobian_cpu(nx,ny)
    real(8), intent(inout) :: Q(nx,ny,nz,5)
    integer t1, t2, ierr, nranks, ndevices, stat
    integer istat(MPI_STATUS_SIZE)
    ! GPU arrays (compute ranks only)
    real(8), allocatable, device :: Q_1(:,:,:), Q_2(:,:,:), Q_3(:,:,:), Q_4(:,:,:), Q_5(:,:,:)
    real(8), allocatable, device :: QJ_1(:,:,:), QJ_2(:,:,:), QJ_3(:,:,:), QJ_4(:,:,:), QJ_5(:,:,:)
    real(8), allocatable, device :: ${SA}$_1(:,:,:), ${SA}$_2(:,:,:), ${SA}$_3(:,:,:), ${SA}$_4(:,:,:), ${SA}$_5(:,:,:)
    #:if RK == 4
    real(8), allocatable, device :: Rs(:,:,:,:)
    #:endif
    real(8), allocatable, device :: E(:,:,:,:), F(:,:,:,:), G(:,:,:,:)
    real(8), allocatable, device :: T(:,:,:), mu(:,:,:), mut(:,:,:), qc2(:,:,:)
    real(8), allocatable, device :: ux(:,:,:), vy(:,:,:), wz(:,:,:)
    real(8), allocatable, device :: xix(:), etay(:), zetaz(:), Jacobian(:,:), dtdxdy(:,:), dtdydz(:,:), dtdzdx(:,:)
    ! for plot
    real(4) :: ke0 = 1.e0, entropy0 = 1.e0
    #:if RESCALE
    ! recycling-rescaling: running-mean counter and flag, recycling plane, mean profile
    integer :: step = ${QM_STEP0}$, flag_re = 0, flag_req
    integer ireq, ireq2(2), istat2(MPI_STATUS_SIZE,2)
    real(8), allocatable, device :: Qre_1(:), Qre_2(:), Qre_3(:), Qre_4(:), Qre_5(:)
    real(8), allocatable, device :: Qm_1(:), Qm_2(:), Qm_3(:), Qm_4(:), Qm_5(:)
    real(8), allocatable, pinned :: Qm_cpu_1(:), Qm_cpu_2(:), Qm_cpu_3(:), Qm_cpu_4(:), Qm_cpu_5(:)
    #:endif
    #:if COMMZ
    ! z-halo exchange buffers
    integer overlap, req_z(4)
    real(8), allocatable, device :: Qs1d_lo(:), Qs1d_hi(:), Qr1d_lo(:), Qr1d_hi(:)
    real(8), allocatable, pinned :: send_lo(:), send_hi(:)
    #:if MPI == 'CPU'
    real(8), allocatable, pinned :: recv_lo(:), recv_hi(:)
    #:else
    real(8), allocatable, device :: recv_lo(:), recv_hi(:)
    #:endif
    #:endif
    #:if BC_FORCING
    ! step index and random phases for the blowing/suction strip (set_bc)
    integer t_now
    real(8) :: phi_l(500), phi_m(500)
    real(8), device :: phi_l_gpu(500), phi_m_gpu(500)
    #:endif

    #:if COMMZ
    overlap = ${ORDER // 2}$
    #:endif
    call MPI_COMM_SIZE(MPI_COMM_WORLD, nranks, ierr)
    if (mod(myrank,2) == 0) then
      stat = cudaGetDeviceCount(ndevices)
      print *, "rank", myrank, " has found ", ndevices, " GPU devices"
      call check_gpu(mygpu)
      call allocate_device_mem(myrank, nx, ny, nz, dtdxdy, dtdydz, dtdzdx, xix, etay, zetaz, Jacobian, &
                               ${Q5('Q')}$, T, mu, mut, qc2, ux, vy, wz, E, F, G)
      allocate(QJ_1(nx,ny,nz), QJ_2(nx,ny,nz), QJ_3(nx,ny,nz), QJ_4(nx,ny,nz), QJ_5(nx,ny,nz), &
               ${SA}$_1(nx,ny,nz), ${SA}$_2(nx,ny,nz), ${SA}$_3(nx,ny,nz), ${SA}$_4(nx,ny,nz), ${SA}$_5(nx,ny,nz), &
               ${'Rs(nx-2,ny-2,nz-2,5), ' if RK == 4 else ''}$stat=ierr)
      if (ierr /= 0) then
        print *, "myrank is ", myrank, " memory allocation failed", ierr
      else
        print *, "myrank is ", myrank, " memory allocation has completed"
      endif
      call pre_calc(nx, ny, nz, myrank, nranks, x, dx_cpu, y, dy_cpu, z, dz_cpu, Jacobian_cpu, Q, &
                    dtdxdy, dtdydz, dtdzdx, xix, etay, zetaz, Jacobian, ${Q5('QJ')}$, ke0, entropy0)
      ${SA}$_1 = QJ_1; ${SA}$_2 = QJ_2; ${SA}$_3 = QJ_3; ${SA}$_4 = QJ_4; ${SA}$_5 = QJ_5
      #:if RK == 4
      Rs = 0.d0
      #:endif
      #:if COMMZ
      allocate(Qs1d_lo(nx*ny*overlap*5), Qs1d_hi(nx*ny*overlap*5), &
               Qr1d_lo(nx*ny*overlap*5), Qr1d_hi(nx*ny*overlap*5), stat=ierr)
      allocate(send_lo(nx*ny*overlap*5), send_hi(nx*ny*overlap*5), &
               recv_lo(nx*ny*overlap*5), recv_hi(nx*ny*overlap*5), stat=ierr)
      ! Prove the z-halo really moves data before spending a run on it: a
      ! transport that cannot handle these buffers corrupts the halo silently
      ! and only shows up as NaN much later (see check_exchange_z).
      call check_exchange_z(myrank, nranks, overlap, nx, ny, nz, &
                            Qs1d_lo, Qs1d_hi, send_lo, send_hi, recv_lo, recv_hi)
      #:endif
    else
      call MPI_RECV(ke0,      1, MPI_REAL4, myrank-1, myrank, MPI_COMM_WORLD, istat, ierr)
      call MPI_RECV(entropy0, 1, MPI_REAL4, myrank-1, myrank, MPI_COMM_WORLD, istat, ierr)
      call send_recv_for_print_odd(myrank, nranks, 0, nx, ny, nz, x, y, z, Jacobian_cpu, Q, ke0, entropy0)
    endif
    #:if RESCALE
    call pre_rescale(myrank, flag_re, flag_req, ny, nz, ${Q5('Qre')}$, &
                     ${Q5('Qm')}$, ${Q5('Qm_cpu')}$)
    #:endif
    #:if BC_FORCING
    ! random phases for the blowing/suction strip, identical on every rank
    if (myrank == 0) then
      call random_number(phi_l)
      call random_number(phi_m)
    endif
    call MPI_BCAST(phi_l, size(phi_l), MPI_REAL8, 0, MPI_COMM_WORLD, ierr)
    call MPI_BCAST(phi_m, size(phi_m), MPI_REAL8, 0, MPI_COMM_WORLD, ierr)
    phi_l_gpu = phi_l
    phi_m_gpu = phi_m
    #:endif

    call MPI_BARRIER(MPI_COMM_WORLD, ierr)
    print *, "myrank is ", myrank, " start Runge-Kutta${' (z-decomp)' if COMMZ else ''}$"
    do t2 = 1, np
      #:if RESCALE
      ! the I/O rank rerank+1 takes part in every stage, so the rank branch is per stage
      do t1 = 1, nt
        #:for num, qin, upd, qout in [(k + 1,) + st for k, st in enumerate(STAGES)]
        if (mod(myrank,2) == 0) then
          $:stage(num, qin, upd, qout)
        elseif (myrank == rerank+1) then
          call rescale_recv_send(${num}$, flag_re, nx, ny, nz, np*(t2-1)+t1, y, Jacobian_cpu, ${Q5('Qm_cpu')}$)
        endif
        #:endfor
      enddo
      #:else
      if (mod(myrank,2) == 0) then
        do t1 = 1, nt
          #:if BC_FORCING
          t_now = nt * (t2 - 1) + t1
          #:endif
          #:for num, qin, upd, qout in [(k + 1,) + st for k, st in enumerate(STAGES)]
          $:stage(num, qin, upd, qout)
          #:endfor
        enddo
        #:if COMMZ
        ! Refresh the z ghost planes before output so the VTK slab (and the
        ! final restart dump) carries the neighbours' data instead of the
        ! local placeholder written by set_bc_cyclic_z.
        call start_exchange_z(myrank, nranks, overlap, nx, ny, nz, ${Q5('QJ')}$, &
                              Qs1d_lo, Qs1d_hi, Qr1d_lo, Qr1d_hi, send_lo, send_hi, recv_lo, recv_hi, req_z)
        call finish_exchange_z(overlap, nx, ny, nz, recv_lo, recv_hi, Qr1d_lo, Qr1d_hi, ${Q5('QJ')}$, req_z)
        #:endif
      endif
      #:endif
      if (mod(myrank,2) == 0) then
        call send_recv_for_print_even(myrank, nranks, t2, nx, ny, nz, x, y, z, Jacobian_cpu, ${Q5('QJ')}$, Q, ke0, entropy0)
      else
        call send_recv_for_print_odd(myrank, nranks, t2, nx, ny, nz, x, y, z, Jacobian_cpu, Q, ke0, entropy0)
      endif
    enddo

    if (mod(myrank,2) == 0) then
      deallocate(${Q5('Q')}$, T, mu, mut, qc2, ux, vy, wz, ${Q5('QJ')}$, &
                 ${Q5(SA)}$, ${'Rs, ' if RK == 4 else ''}$E, F, G, xix, etay, zetaz, Jacobian, dtdxdy, dtdydz, dtdzdx)
      #:if COMMZ
      deallocate(Qs1d_lo, Qs1d_hi, Qr1d_lo, Qr1d_hi, send_lo, send_hi, recv_lo, recv_hi)
      #:endif
    endif
    #:if RESCALE
    if (myrank == 0 .or. myrank == rerank) then
      deallocate(${Q5('Qre')}$, ${Q5('Qm')}$)
    elseif (myrank == rerank+1) then
      deallocate(${Q5('Qm_cpu')}$)
    endif
    #:endif
    print *, "myrank is ", myrank, " deallocate GPU memory"
  end subroutine RungeKutta
end module calc_time_dev
