#:include 'config.fypp'
#:if not defined('VISC_ORDER')
  #:set VISC_ORDER = ORDER
#:endif
#:set is_les = (VISC == 'LES')
#:set base_suf = ""
#:if VISC_ORDER == 2
module calc_visc_high
end module calc_visc_high
#:else
module calc_visc_high
  use libm
  use mod_globals, only : gamma, R, Pr, Prt, dt, threadsEv, threadsFv, threadsGv
  use mod_constant, only : id_visc, Cp, gamma_1, Cp_over_Pr, one_third, two_third, one_twelfth
  use load_smem_visc_cent${VISC_ORDER}$
  implicit none
  private
  public calc_Ev${VISC_ORDER}$, calc_Fv${VISC_ORDER}$, calc_Gv${VISC_ORDER}$, &
         calc_Ev${VISC_ORDER}$_koff, calc_Fv${VISC_ORDER}$_koff, calc_Gv${VISC_ORDER}$_koff
  real(8), parameter :: one_24 = 1.d0 / 24.d0
contains
  #:include 'calc_visc_cent.f90.fypp'

  !=====================================================================
  ! Notes on the shared-memory / register layout used by all 3 kernels:
  !   - `uvw` is a SINGLE reusable shared buffer, not 3 persistent u,v,w
  !     arrays: each stage only ever needs ONE velocity component (both in
  !     the high-order interior branch -- calc_tau_straight/cross's "self"
  !     velocity arg -- and in the 2nd-order boundary fallback, which only
  !     reads uvw(idx)/uvw(idx+1)), so it's loaded fresh by that stage's own
  !     load call (no separate _uvw call/syncthreads()).
  !   - grad_a,grad_b are 2 REUSABLE shared buffers, recycled across the
  !     3 stress-component stages: stage1 needs 2 gradients live at once
  !     (grad_a, grad_b), stages 2 and 3 need only 1 (grad_a, reloaded).
  !   - mu is never held in shared memory: `mui = interp(mu)` is read via
  !     a handful of scalar global-memory reads and computed ONCE (via the
  !     scalar-argument interp${VISC_ORDER}$_s), then reused unchanged by
  !     all 3 stages' calc_tau_straight/calc_tau_cross calls. Likewise `T`
  !     is never stored to a register array; diff${VISC_ORDER}$_s is called
  !     directly on scalar reads.
  !   - LES `Hsgs` (dead code, VISC='LES' unused by any case) needs
  !     u²+v²+w² together; since only one component is available per
  !     stage, it's ACCUMULATED: stage 1 initializes H(:) with
  !     Cp*T+qc2+0.5*u², stage 2 adds 0.5*v², stage 3 adds 0.5*w² and
  !     finally computes Hsgs. `H` (interior stencil) / `Hb` (2-point
  !     boundary fallback) persist at subroutine scope for this reason.
  !   - `valid` gates whether THIS thread's (i,j,k) is in-array-bounds at
  !     all; `interior` (only meaningful when valid) picks the high-order
  !     stencil vs. the 2nd-order boundary fallback. Every staged load
  !     (and its syncthreads()) runs unconditionally for every thread in
  !     the block, valid or not -- an early `return` here would leave
  !     out-of-range threads never reaching the later stage2/stage3
  !     syncthreads() calls that their still-running block-mates do reach,
  !     deadlocking the block.
  !=====================================================================

#:for is_koff in [False, True]
  #:set suf = base_suf
  #:if is_koff
    #:set suf = suf + "_koff"
  #:endif
  attributes(global) subroutine calc_Ev${VISC_ORDER}$${suf}$(nx, ny, nz, dx, dy, dz, Q_2, Q_3, Q_4, T, mu, &
    #:if is_les
      mut, qc2, &
    #:endif
    #:if is_koff
      k_lo, k_hi, &
    #:endif
    E)
    integer, intent(in), value                 :: nx
    integer, intent(in), value                 :: ny
    integer, intent(in), value                 :: nz
    real(8), intent(in), device, contiguous    :: dx(nx-1)
    real(8), intent(in), device, contiguous    :: dy(ny-1)
    real(8), intent(in), device, contiguous    :: dz(nz-1)
    real(8), intent(in), device, contiguous    :: Q_2(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: Q_3(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: Q_4(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: T(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: mu(nx,ny,nz)
    #:if is_les
    real(8), intent(in), device, contiguous    :: mut(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: qc2(nx,ny,nz)
    #:endif
    real(8), intent(inout), device, contiguous :: E(nx-1,ny-2,nz-2,5)
    #:if is_koff
    integer, intent(in), value                 :: k_lo
    integer, intent(in), value                 :: k_hi
    #:endif
    #:if VISC_ORDER == 4
    integer, parameter :: io_v = 1
    #:else
    integer, parameter :: io_v = 2
    #:endif
    integer, parameter :: sx = threadsEv%x + 2*io_v + 1
    integer, parameter :: sy = threadsEv%y
    integer, parameter :: sz = threadsEv%z
    real(8), dimension(-(io_v-1):sx*sy*sz-io_v), shared :: uvw
    real(8), dimension(-(io_v-1):sx*sy*sz-io_v), shared :: grad_a
    real(8), dimension(-(io_v-1):sx*sy*sz-io_v), shared :: grad_b
    integer i, j, k, it, jt, kt, idx, offset_yz
    logical :: valid, interior
    real(8) :: kTx, utau_sum, mui
    ! only the boundary-path scalars actually needed by a LATER stage persist
    ! at subroutine scope; everything used within a single stage is declared
    ! inside that stage's own `block` below to keep its register live range
    ! short.
    real(8) :: mx, muy, muz
    #:if is_les
    real(8) :: Hsgs, mxsgs, muysgs, muzsgs, muti
    real(8) :: H(2*io_v+2), Hb(2)
    #:endif
    it = threadIdx%x
    jt = threadIdx%y
    kt = threadIdx%z
    j  = (blockIdx%y-1)*blockDim%y + jt + 1
    #:if is_koff
    k  = (blockIdx%z-1)*blockDim%z + kt + k_lo - 1
    #:else
    k  = (blockIdx%z-1)*blockDim%z + kt + 1
    #:endif
    offset_yz = (jt-1)*sx + (kt-1)*sx*sy
    call load_smem_visc_cent${VISC_ORDER}$_x_stage1(it, jt, kt, j, k, nx, ny, nz, dy(j), dz(k), Q_2, Q_3, Q_4, grad_a, grad_b, uvw)
    i  = (blockIdx%x-1)*blockDim%x + it
    idx = it + offset_yz
    #:if is_koff
    valid = .not. (nx-1 < i .or. ny-1 < j .or. k_hi < k)
    #:else
    valid = .not. (nx-1 < i .or. ny-1 < j .or. nz-1 < k)
    #:endif
    if (valid) then
      interior = (io_v+1 <= i .and. i <= nx-io_v-1 .and. io_v+2 <= j .and. j <= ny-io_v-1 .and. io_v+2 <= k .and. k <= nz-io_v-1)
    endif

    ! ---- stage 1: straight component -> E(...,2) [uses uvw=u, grad_a=vy, grad_b=wz] ----
    if (valid) then
    if (interior) then
      block
        real(8) :: Tx
        #:if VISC_ORDER == 4
        mui = interp${VISC_ORDER}$_s(mu(i,j,k)+mu(i+1,j,k), mu(i-1,j,k)+mu(i+2,j,k))
        Tx  = diff${VISC_ORDER}$_s(dx(i), T(i,j,k)-T(i+1,j,k), T(i-1,j,k)-T(i+2,j,k))
        #:if is_les
        muti = interp${VISC_ORDER}$_s(mut(i,j,k)+mut(i+1,j,k), mut(i-1,j,k)+mut(i+2,j,k))
        H(1) = Cp*T(i-1,j,k) + 0.5d0*uvw(idx-1)**2 + qc2(i-1,j,k)
        H(2) = Cp*T(i,  j,k) + 0.5d0*uvw(idx  )**2 + qc2(i,  j,k)
        H(3) = Cp*T(i+1,j,k) + 0.5d0*uvw(idx+1)**2 + qc2(i+1,j,k)
        H(4) = Cp*T(i+2,j,k) + 0.5d0*uvw(idx+2)**2 + qc2(i+2,j,k)
        #:endif
        #:else
        mui = interp${VISC_ORDER}$_s(mu(i-2,j,k)+mu(i+3,j,k), mu(i-1,j,k)+mu(i+2,j,k), mu(i,j,k)+mu(i+1,j,k))
        Tx  = diff${VISC_ORDER}$_s(dx(i), -T(i-2,j,k)+T(i+3,j,k), T(i-1,j,k)-T(i+2,j,k), -T(i,j,k)+T(i+1,j,k))
        #:if is_les
        muti = interp${VISC_ORDER}$_s(mut(i-2,j,k)+mut(i+3,j,k), mut(i-1,j,k)+mut(i+2,j,k), mut(i,j,k)+mut(i+1,j,k))
        H(1) = Cp*T(i-2,j,k) + 0.5d0*uvw(idx-2)**2 + qc2(i-2,j,k)
        H(2) = Cp*T(i-1,j,k) + 0.5d0*uvw(idx-1)**2 + qc2(i-1,j,k)
        H(3) = Cp*T(i,  j,k) + 0.5d0*uvw(idx  )**2 + qc2(i,  j,k)
        H(4) = Cp*T(i+1,j,k) + 0.5d0*uvw(idx+1)**2 + qc2(i+1,j,k)
        H(5) = Cp*T(i+2,j,k) + 0.5d0*uvw(idx+2)**2 + qc2(i+2,j,k)
        H(6) = Cp*T(i+3,j,k) + 0.5d0*uvw(idx+3)**2 + qc2(i+3,j,k)
        #:endif
        #:endif
        kTx = Cp_over_Pr * mui * Tx
        block
          real(8) :: tau, utau
          #:if is_les
          call calc_tau_straight_LES(mui, muti, uvw(idx-io_v:idx+io_v+1), grad_a(idx-io_v:idx+io_v+1), grad_b(idx-io_v:idx+io_v+1), dx(i), tau, utau)
          #:else
          call calc_tau_straight(mui, uvw(idx-io_v:idx+io_v+1), grad_a(idx-io_v:idx+io_v+1), grad_b(idx-io_v:idx+io_v+1), dx(i), tau, utau)
          #:endif
          call __stcg(E(i,j-1,k-1,2), __ldlu(E(i,j-1,k-1,2)) - tau)
          utau_sum = utau
        end block
      end block
    else
      block
        real(8) :: mu_c, mu_e, T_c, T_e, mvy, mwz, mux
        #:if is_les
        real(8) :: mut_c, mut_e, mvysgs, mwzsgs, muxsgs
        #:endif
        mu_c = mu(i,  j,k)
        mu_e = mu(i+1,j,k)
        mx   = 0.5d0 * (mu_c + mu_e)
        T_c  = T(i,  j,k)
        T_e  = T(i+1,j,k)
        kTx  = Cp_over_Pr * mx * (T_e - T_c) * dx(i)
        #:if is_les
        mut_c = mut(i,  j,k)
        mut_e = mut(i+1,j,k)
        mxsgs = 0.5d0 * (mut_c + mut_e)
        #:endif
        block
          real(8) :: my(2), mu_cjm, mu_cjp, mu_ejm, mu_ejp
          #:if is_les
          real(8) :: mysgs(2), mut_cjm, mut_cjp, mut_ejm, mut_ejp
          #:endif
          ! corner neighbours below are each read exactly once by this thread: __ldcs
          mu_cjm = __ldcs(mu(i,  j-1,k))
          mu_cjp = __ldcs(mu(i,  j+1,k))
          mu_ejm = __ldcs(mu(i+1,j-1,k))
          mu_ejp = __ldcs(mu(i+1,j+1,k))
          my(1) = 0.25d0 * (mu_cjm + mu_c + mu_ejm + mu_e)
          my(2) = 0.25d0 * (mu_c + mu_cjp + mu_e + mu_ejp)
          muy = 0.25d0 * (my(1) * (-Q_2(i,j-1,k) + Q_2(i,j,k) - Q_2(i+1,j-1,k) + Q_2(i+1,j,k)) &
                        + my(2) * (-Q_2(i,j,k) + Q_2(i,j+1,k) - Q_2(i+1,j,k) + Q_2(i+1,j+1,k))) * dy(j)
          mvy = 0.25d0 * (my(1) * (-Q_3(i,j-1,k) + Q_3(i,j,k) - Q_3(i+1,j-1,k) + Q_3(i+1,j,k)) &
                        + my(2) * (-Q_3(i,j,k) + Q_3(i,j+1,k) - Q_3(i+1,j,k) + Q_3(i+1,j+1,k))) * dy(j)
          #:if is_les
          mut_cjm = __ldcs(mut(i,  j-1,k))
          mut_cjp = __ldcs(mut(i,  j+1,k))
          mut_ejm = __ldcs(mut(i+1,j-1,k))
          mut_ejp = __ldcs(mut(i+1,j+1,k))
          mysgs(:) = (/0.25d0 * (mut_cjm + mut_c + mut_ejm + mut_e), &
                       0.25d0 * (mut_c + mut_cjp + mut_e + mut_ejp)/)
          muysgs = 0.25d0 * (mysgs(1) * (-Q_2(i,j-1,k) + Q_2(i,j,k) - Q_2(i+1,j-1,k) + Q_2(i+1,j,k)) &
                           + mysgs(2) * (-Q_2(i,j,k) + Q_2(i,j+1,k) - Q_2(i+1,j,k) + Q_2(i+1,j+1,k))) * dy(j)
          mvysgs = 0.25d0 * (mysgs(1) * (-Q_3(i,j-1,k) + Q_3(i,j,k) - Q_3(i+1,j-1,k) + Q_3(i+1,j,k)) &
                           + mysgs(2) * (-Q_3(i,j,k) + Q_3(i,j+1,k) - Q_3(i+1,j,k) + Q_3(i+1,j+1,k))) * dy(j)
          #:endif
        end block
        block
          real(8) :: mz(2), mu_ckm, mu_ckp, mu_ekm, mu_ekp
          #:if is_les
          real(8) :: mzsgs(2), mut_ckm, mut_ckp, mut_ekm, mut_ekp
          #:endif
          ! corner neighbours below are each read exactly once by this thread: __ldcs
          mu_ckm = __ldcs(mu(i,  j,k-1))
          mu_ckp = __ldcs(mu(i,  j,k+1))
          mu_ekm = __ldcs(mu(i+1,j,k-1))
          mu_ekp = __ldcs(mu(i+1,j,k+1))
          mz(1) = 0.25d0 * (mu_ckm + mu_c + mu_ekm + mu_e)
          mz(2) = 0.25d0 * (mu_c + mu_ckp + mu_e + mu_ekp)
          muz = 0.25d0 * (mz(1) * (-Q_2(i,j,k-1) + Q_2(i,j,k) - Q_2(i+1,j,k-1) + Q_2(i+1,j,k)) &
                        + mz(2) * (-Q_2(i,j,k) + Q_2(i,j,k+1) - Q_2(i+1,j,k) + Q_2(i+1,j,k+1))) * dz(k)
          mwz = 0.25d0 * (mz(1) * (-Q_4(i,j,k-1) + Q_4(i,j,k) - Q_4(i+1,j,k-1) + Q_4(i+1,j,k)) &
                        + mz(2) * (-Q_4(i,j,k) + Q_4(i,j,k+1) - Q_4(i+1,j,k) + Q_4(i+1,j,k+1))) * dz(k)
          #:if is_les
          mut_ckm = __ldcs(mut(i,  j,k-1))
          mut_ckp = __ldcs(mut(i,  j,k+1))
          mut_ekm = __ldcs(mut(i+1,j,k-1))
          mut_ekp = __ldcs(mut(i+1,j,k+1))
          mzsgs(:) = (/0.25d0 * (mut_ckm + mut_c + mut_ekm + mut_e), &
                       0.25d0 * (mut_c + mut_ckp + mut_e + mut_ekp)/)
          muzsgs = 0.25d0 * (mzsgs(1) * (-Q_2(i,j,k-1) + Q_2(i,j,k) - Q_2(i+1,j,k-1) + Q_2(i+1,j,k)) &
                           + mzsgs(2) * (-Q_2(i,j,k) + Q_2(i,j,k+1) - Q_2(i+1,j,k) + Q_2(i+1,j,k+1))) * dz(k)
          mwzsgs = 0.25d0 * (mzsgs(1) * (-Q_4(i,j,k-1) + Q_4(i,j,k) - Q_4(i+1,j,k-1) + Q_4(i+1,j,k)) &
                           + mzsgs(2) * (-Q_4(i,j,k) + Q_4(i,j,k+1) - Q_4(i+1,j,k) + Q_4(i+1,j,k+1))) * dz(k)
          #:endif
        end block
        mux = mx * (-uvw(idx) + uvw(idx+1)) * dx(i)
        #:if is_les
        muxsgs = mxsgs * (-uvw(idx) + uvw(idx+1)) * dx(i)
        Hb(1) = Cp*T_c + 0.5d0*uvw(idx  )**2 + qc2(i,  j,k)
        Hb(2) = Cp*T_e + 0.5d0*uvw(idx+1)**2 + qc2(i+1,j,k)
        #:endif
        block
          real(8) :: tau, utau
          tau  = two_third * fma(2.d0, mux, -(mvy + mwz))
          utau = 0.5d0 * (uvw(idx) + uvw(idx+1)) * tau
          #:if is_les
          tau = fma(two_third, fma(2.d0, muxsgs, -(mvysgs + mwzsgs)), tau)
          #:endif
          call __stcg(E(i,j-1,k-1,2), __ldlu(E(i,j-1,k-1,2)) - tau)
          utau_sum = utau
        end block
      end block
    endif
    endif
    call syncthreads()
    call load_smem_visc_cent${VISC_ORDER}$_x_stage2(it, jt, kt, j, k, nx, ny, nz, dy(j), Q_2, Q_3, grad_a, uvw)

    ! ---- stage 2: cross component #1 -> E(...,3) [uses uvw=v, grad_a=uy] ----
    if (valid) then
    if (interior) then
      block
        real(8) :: tau, utau
        #:if is_les
        H(:) = H(:) + 0.5d0*uvw(idx-io_v:idx+io_v+1)**2
        call calc_tau_cross_LES(mui, muti, uvw(idx-io_v:idx+io_v+1), grad_a(idx-io_v:idx+io_v+1), dx(i), tau, utau)
        #:else
        call calc_tau_cross(mui, uvw(idx-io_v:idx+io_v+1), grad_a(idx-io_v:idx+io_v+1), dx(i), tau, utau)
        #:endif
        call __stcg(E(i,j-1,k-1,3), __ldlu(E(i,j-1,k-1,3)) - tau)
        utau_sum = utau_sum + utau
      end block
    else
      block
        real(8) :: tau, utau, mvx
        #:if is_les
        real(8) :: mvxsgs
        #:endif
        mvx = mx * (-uvw(idx) + uvw(idx+1)) * dx(i)
        #:if is_les
        mvxsgs = mxsgs * (-uvw(idx) + uvw(idx+1)) * dx(i)
        Hb(1) = Hb(1) + 0.5d0*uvw(idx  )**2
        Hb(2) = Hb(2) + 0.5d0*uvw(idx+1)**2
        #:endif
        tau  = muy + mvx
        utau = 0.5d0 * (uvw(idx) + uvw(idx+1)) * tau
        #:if is_les
        tau = tau + muysgs + mvxsgs
        #:endif
        call __stcg(E(i,j-1,k-1,3), __ldlu(E(i,j-1,k-1,3)) - tau)
        utau_sum = utau_sum + utau
      end block
    endif
    endif
    call syncthreads()
    call load_smem_visc_cent${VISC_ORDER}$_x_stage3(it, jt, kt, j, k, nx, ny, nz, dz(k), Q_2, Q_4, grad_a, uvw)

    ! ---- stage 3: cross component #2 -> E(...,4) [uses uvw=w, grad_a=uz] ----
    if (valid) then
    if (interior) then
      block
        real(8) :: tau, utau
        #:if is_les
        H(:) = H(:) + 0.5d0*uvw(idx-io_v:idx+io_v+1)**2
        Hsgs = -muti * diff${VISC_ORDER}$_s(dx(i), &
        #:if VISC_ORDER == 4
        H(2)-H(3), H(1)-H(4) &
        #:else
        -H(1)+H(6), H(2)-H(5), -H(3)+H(4) &
        #:endif
        ) / Prt
        call calc_tau_cross_LES(mui, muti, uvw(idx-io_v:idx+io_v+1), grad_a(idx-io_v:idx+io_v+1), dx(i), tau, utau)
        #:else
        call calc_tau_cross(mui, uvw(idx-io_v:idx+io_v+1), grad_a(idx-io_v:idx+io_v+1), dx(i), tau, utau)
        #:endif
        call __stcg(E(i,j-1,k-1,4), __ldlu(E(i,j-1,k-1,4)) - tau)
        utau_sum = utau_sum + utau
      end block
    else
      block
        real(8) :: tau, utau, mwx
        #:if is_les
        real(8) :: mwxsgs
        #:endif
        mwx = mx * (-uvw(idx) + uvw(idx+1)) * dx(i)
        #:if is_les
        mwxsgs = mxsgs * (-uvw(idx) + uvw(idx+1)) * dx(i)
        Hb(1) = Hb(1) + 0.5d0*uvw(idx  )**2
        Hb(2) = Hb(2) + 0.5d0*uvw(idx+1)**2
        Hsgs = -mxsgs * (-Hb(1) + Hb(2)) * dx(i) / Prt
        #:endif
        tau  = mwx + muz
        utau = 0.5d0 * (uvw(idx) + uvw(idx+1)) * tau
        #:if is_les
        tau = tau + mwxsgs + muzsgs
        #:endif
        call __stcg(E(i,j-1,k-1,4), __ldlu(E(i,j-1,k-1,4)) - tau)
        utau_sum = utau_sum + utau
      end block
    endif
    block
      real(8) :: e5v
      e5v = __ldlu(E(i,j-1,k-1,5))
      call __stcg(E(i,j-1,k-1,5), e5v - (utau_sum + kTx &
    #:if is_les
      + Hsgs &
    #:endif
      ))
    end block
    endif
  end subroutine calc_Ev${VISC_ORDER}$${suf}$
#:endfor


#:for is_koff in [False, True]
  #:set suf = base_suf
  #:if is_koff
    #:set suf = suf + "_koff"
  #:endif
  attributes(global) subroutine calc_Fv${VISC_ORDER}$${suf}$(nx, ny, nz, dx, dy, dz, Q_2, Q_3, Q_4, T, mu, &
    #:if is_les
      mut, qc2, &
    #:endif
    #:if is_koff
      k_lo, k_hi, &
    #:endif
    F)
    integer, intent(in), value                 :: nx
    integer, intent(in), value                 :: ny
    integer, intent(in), value                 :: nz
    real(8), intent(in), device, contiguous    :: dx(nx-1)
    real(8), intent(in), device, contiguous    :: dy(ny-1)
    real(8), intent(in), device, contiguous    :: dz(nz-1)
    real(8), intent(in), device, contiguous    :: Q_2(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: Q_3(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: Q_4(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: T(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: mu(nx,ny,nz)
    #:if is_les
    real(8), intent(in), device, contiguous    :: mut(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: qc2(nx,ny,nz)
    #:endif
    real(8), intent(inout), device, contiguous :: F(nx-2,ny-1,nz-2,5)
    #:if is_koff
    integer, intent(in), value                 :: k_lo
    integer, intent(in), value                 :: k_hi
    #:endif
    #:if VISC_ORDER == 4
    integer, parameter :: io_v = 1
    #:else
    integer, parameter :: io_v = 2
    #:endif
    integer, parameter :: sx = threadsFv%x
    integer, parameter :: sy = threadsFv%y + 2*io_v + 1
    integer, parameter :: sz = threadsFv%z
    real(8), dimension(-(io_v-1):sx*sy*sz-io_v), shared :: uvw
    real(8), dimension(-(io_v-1):sx*sy*sz-io_v), shared :: grad_a
    real(8), dimension(-(io_v-1):sx*sy*sz-io_v), shared :: grad_b
    integer i, j, k, it, jt, kt, idx, offset_xz
    logical :: valid, interior
    real(8) :: kTy, utau_sum, mui
    ! only the boundary-path scalars actually needed by a LATER stage persist
    ! at subroutine scope; everything used within a single stage is declared
    ! inside that stage's own `block` below to keep its register live range
    ! short.
    real(8) :: my, mvx, mvz
    #:if is_les
    real(8) :: Hsgs, mysgs, mvxsgs, mvzsgs, muti
    real(8) :: H(2*io_v+2), Hb(2)
    #:endif
    it = threadIdx%x
    jt = threadIdx%y
    kt = threadIdx%z
    i  = (blockIdx%x-1)*blockDim%x + it + 1
    #:if is_koff
    k  = (blockIdx%z-1)*blockDim%z + kt + k_lo - 1
    #:else
    k  = (blockIdx%z-1)*blockDim%z + kt + 1
    #:endif
    offset_xz = (it-1)*sy + (kt-1)*sy*sx
    call load_smem_visc_cent${VISC_ORDER}$_y_stage1(it, jt, kt, i, k, nx, ny, nz, dx(i), dz(k), Q_2, Q_3, Q_4, grad_a, grad_b, uvw)
    j  = (blockIdx%y-1)*blockDim%y + jt
    idx = jt + offset_xz
    #:if is_koff
    valid = .not. (nx-1 < i .or. ny-1 < j .or. k_hi < k)
    #:else
    valid = .not. (nx-1 < i .or. ny-1 < j .or. nz-1 < k)
    #:endif
    if (valid) then
      interior = (io_v+2 <= i .and. i <= nx-io_v-1 .and. io_v+1 <= j .and. j <= ny-io_v-1 .and. io_v+2 <= k .and. k <= nz-io_v-1)
    endif

    ! ---- stage 1: straight component -> F(...,3) [uses uvw=v, grad_a=ux, grad_b=wz] ----
    if (valid) then
    if (interior) then
      block
        real(8) :: Tx
        #:if VISC_ORDER == 4
        mui = interp${VISC_ORDER}$_s(mu(i,j,k)+mu(i,j+1,k), mu(i,j-1,k)+mu(i,j+2,k))
        Tx  = diff${VISC_ORDER}$_s(dy(j), T(i,j,k)-T(i,j+1,k), T(i,j-1,k)-T(i,j+2,k))
        #:if is_les
        muti = interp${VISC_ORDER}$_s(mut(i,j,k)+mut(i,j+1,k), mut(i,j-1,k)+mut(i,j+2,k))
        H(1) = Cp*T(i,j-1,k) + 0.5d0*uvw(idx-1)**2 + qc2(i,j-1,k)
        H(2) = Cp*T(i,j,  k) + 0.5d0*uvw(idx  )**2 + qc2(i,j,  k)
        H(3) = Cp*T(i,j+1,k) + 0.5d0*uvw(idx+1)**2 + qc2(i,j+1,k)
        H(4) = Cp*T(i,j+2,k) + 0.5d0*uvw(idx+2)**2 + qc2(i,j+2,k)
        #:endif
        #:else
        mui = interp${VISC_ORDER}$_s(mu(i,j-2,k)+mu(i,j+3,k), mu(i,j-1,k)+mu(i,j+2,k), mu(i,j,k)+mu(i,j+1,k))
        Tx  = diff${VISC_ORDER}$_s(dy(j), -T(i,j-2,k)+T(i,j+3,k), T(i,j-1,k)-T(i,j+2,k), -T(i,j,k)+T(i,j+1,k))
        #:if is_les
        muti = interp${VISC_ORDER}$_s(mut(i,j-2,k)+mut(i,j+3,k), mut(i,j-1,k)+mut(i,j+2,k), mut(i,j,k)+mut(i,j+1,k))
        H(1) = Cp*T(i,j-2,k) + 0.5d0*uvw(idx-2)**2 + qc2(i,j-2,k)
        H(2) = Cp*T(i,j-1,k) + 0.5d0*uvw(idx-1)**2 + qc2(i,j-1,k)
        H(3) = Cp*T(i,j,  k) + 0.5d0*uvw(idx  )**2 + qc2(i,j,  k)
        H(4) = Cp*T(i,j+1,k) + 0.5d0*uvw(idx+1)**2 + qc2(i,j+1,k)
        H(5) = Cp*T(i,j+2,k) + 0.5d0*uvw(idx+2)**2 + qc2(i,j+2,k)
        H(6) = Cp*T(i,j+3,k) + 0.5d0*uvw(idx+3)**2 + qc2(i,j+3,k)
        #:endif
        #:endif
        kTy = Cp_over_Pr * mui * Tx
        block
          real(8) :: tau, utau
          #:if is_les
          call calc_tau_straight_LES(mui, muti, uvw(idx-io_v:idx+io_v+1), grad_a(idx-io_v:idx+io_v+1), grad_b(idx-io_v:idx+io_v+1), dy(j), tau, utau)
          #:else
          call calc_tau_straight(mui, uvw(idx-io_v:idx+io_v+1), grad_a(idx-io_v:idx+io_v+1), grad_b(idx-io_v:idx+io_v+1), dy(j), tau, utau)
          #:endif
          call __stcg(F(i-1,j,k-1,3), __ldlu(F(i-1,j,k-1,3)) - tau)
          utau_sum = utau
        end block
      end block
    else
      block
        real(8) :: mu_c, mu_n, T_c, T_n, mux, mwz, mvy
        #:if is_les
        real(8) :: mut_c, mut_n, muxsgs, mwzsgs, mvysgs
        #:endif
        mu_c = mu(i,j,  k)
        mu_n = mu(i,j+1,k)
        my   = 0.5d0 * (mu_c + mu_n)
        T_c  = T(i,j,  k)
        T_n  = T(i,j+1,k)
        kTy  = Cp_over_Pr * my * (T_n - T_c) * dy(j)
        #:if is_les
        mut_c = mut(i,j,  k)
        mut_n = mut(i,j+1,k)
        mysgs = 0.5d0 * (mut_c + mut_n)
        #:endif
        block
          real(8) :: mx(2), mu_wc, mu_wn, mu_ec, mu_en
          #:if is_les
          real(8) :: mxsgs(2), mut_wc, mut_wn, mut_ec, mut_en
          #:endif
          ! corner neighbours below are each read exactly once by this thread: __ldcs
          mu_wc  = __ldcs(mu(i-1,j,  k))
          mu_wn  = __ldcs(mu(i-1,j+1,k))
          mu_ec  = __ldcs(mu(i+1,j,  k))
          mu_en  = __ldcs(mu(i+1,j+1,k))
          mx(1)  = 0.25d0 * (mu_wc + mu_c + mu_wn + mu_n)
          mx(2)  = 0.25d0 * (mu_c + mu_ec + mu_n + mu_en)
          mux    = 0.25d0 * (mx(1) * (-Q_2(i-1,j,k) + Q_2(i,j,k) - Q_2(i-1,j+1,k) + Q_2(i,j+1,k)) &
                            + mx(2) * (-Q_2(i,j,k) + Q_2(i+1,j,k) - Q_2(i,j+1,k) + Q_2(i+1,j+1,k))) * dx(i)
          mvx    = 0.25d0 * (mx(1) * (-Q_3(i-1,j,k) + Q_3(i,j,k) - Q_3(i-1,j+1,k) + Q_3(i,j+1,k)) &
                            + mx(2) * (-Q_3(i,j,k) + Q_3(i+1,j,k) - Q_3(i,j+1,k) + Q_3(i+1,j+1,k))) * dx(i)
          #:if is_les
          mut_wc  = __ldcs(mut(i-1,j,  k))
          mut_wn  = __ldcs(mut(i-1,j+1,k))
          mut_ec  = __ldcs(mut(i+1,j,  k))
          mut_en  = __ldcs(mut(i+1,j+1,k))
          mxsgs(:) = (/0.25d0 * (mut_wc + mut_c + mut_wn + mut_n), &
                       0.25d0 * (mut_c + mut_ec + mut_n + mut_en)/)
          muxsgs = 0.25d0 * (mxsgs(1) * (-Q_2(i-1,j,k) + Q_2(i,j,k) - Q_2(i-1,j+1,k) + Q_2(i,j+1,k)) &
                            + mxsgs(2) * (-Q_2(i,j,k) + Q_2(i+1,j,k) - Q_2(i,j+1,k) + Q_2(i+1,j+1,k))) * dx(i)
          mvxsgs = 0.25d0 * (mxsgs(1) * (-Q_3(i-1,j,k) + Q_3(i,j,k) - Q_3(i-1,j+1,k) + Q_3(i,j+1,k)) &
                            + mxsgs(2) * (-Q_3(i,j,k) + Q_3(i+1,j,k) - Q_3(i,j+1,k) + Q_3(i+1,j+1,k))) * dx(i)
          #:endif
        end block
        block
          real(8) :: mz(2), mu_ckm, mu_ckp, mu_nkm, mu_nkp
          #:if is_les
          real(8) :: mzsgs(2), mut_ckm, mut_ckp, mut_nkm, mut_nkp
          #:endif
          ! corner neighbours below are each read exactly once by this thread: __ldcs
          mu_ckm = __ldcs(mu(i,  j,  k-1))
          mu_ckp = __ldcs(mu(i,  j,  k+1))
          mu_nkm = __ldcs(mu(i,  j+1,k-1))
          mu_nkp = __ldcs(mu(i,  j+1,k+1))
          mz(1)  = 0.25d0 * (mu_ckm + mu_c + mu_nkm + mu_n)
          mz(2)  = 0.25d0 * (mu_c + mu_ckp + mu_n + mu_nkp)
          mvz    = 0.25d0 * (mz(1) * (-Q_3(i,j,k-1) + Q_3(i,j,k) - Q_3(i,j+1,k-1) + Q_3(i,j+1,k)) &
                            + mz(2) * (-Q_3(i,j,k) + Q_3(i,j,k+1) - Q_3(i,j+1,k) + Q_3(i,j+1,k+1))) * dz(k)
          mwz    = 0.25d0 * (mz(1) * (-Q_4(i,j,k-1) + Q_4(i,j,k) - Q_4(i,j+1,k-1) + Q_4(i,j+1,k)) &
                            + mz(2) * (-Q_4(i,j,k) + Q_4(i,j,k+1) - Q_4(i,j+1,k) + Q_4(i,j+1,k+1))) * dz(k)
          #:if is_les
          mut_ckm = __ldcs(mut(i,  j,  k-1))
          mut_ckp = __ldcs(mut(i,  j,  k+1))
          mut_nkm = __ldcs(mut(i,  j+1,k-1))
          mut_nkp = __ldcs(mut(i,  j+1,k+1))
          mzsgs(:) = (/0.25d0 * (mut_ckm + mut_c + mut_nkm + mut_n), &
                       0.25d0 * (mut_c + mut_ckp + mut_n + mut_nkp)/)
          mvzsgs = 0.25d0 * (mzsgs(1) * (-Q_3(i,j,k-1) + Q_3(i,j,k) - Q_3(i,j+1,k-1) + Q_3(i,j+1,k)) &
                            + mzsgs(2) * (-Q_3(i,j,k) + Q_3(i,j,k+1) - Q_3(i,j+1,k) + Q_3(i,j+1,k+1))) * dz(k)
          mwzsgs = 0.25d0 * (mzsgs(1) * (-Q_4(i,j,k-1) + Q_4(i,j,k) - Q_4(i,j+1,k-1) + Q_4(i,j+1,k)) &
                            + mzsgs(2) * (-Q_4(i,j,k) + Q_4(i,j,k+1) - Q_4(i,j+1,k) + Q_4(i,j+1,k+1))) * dz(k)
          #:endif
        end block
        mvy = my * (-uvw(idx) + uvw(idx+1)) * dy(j)
        #:if is_les
        mvysgs = mysgs * (-uvw(idx) + uvw(idx+1)) * dy(j)
        Hb(1) = Cp*T_c + 0.5d0*uvw(idx  )**2 + qc2(i,j,  k)
        Hb(2) = Cp*T_n + 0.5d0*uvw(idx+1)**2 + qc2(i,j+1,k)
        #:endif
        block
          real(8) :: tau, utau
          tau  = two_third * fma(2.d0, mvy, -(mwz + mux))
          utau = 0.5d0 * (uvw(idx) + uvw(idx+1)) * tau
          #:if is_les
          tau = fma(two_third, fma(2.d0, mvysgs, -(mwzsgs + muxsgs)), tau)
          #:endif
          call __stcg(F(i-1,j,k-1,3), __ldlu(F(i-1,j,k-1,3)) - tau)
          utau_sum = utau
        end block
      end block
    endif
    endif
    call syncthreads()
    call load_smem_visc_cent${VISC_ORDER}$_y_stage2(it, jt, kt, i, k, nx, ny, nz, dx(i), Q_2, Q_3, grad_a, uvw)

    ! ---- stage 2: cross component #1 -> F(...,2) [uses uvw=u, grad_a=vx] ----
    if (valid) then
    if (interior) then
      block
        real(8) :: tau, utau
        #:if is_les
        H(:) = H(:) + 0.5d0*uvw(idx-io_v:idx+io_v+1)**2
        call calc_tau_cross_LES(mui, muti, uvw(idx-io_v:idx+io_v+1), grad_a(idx-io_v:idx+io_v+1), dy(j), tau, utau)
        #:else
        call calc_tau_cross(mui, uvw(idx-io_v:idx+io_v+1), grad_a(idx-io_v:idx+io_v+1), dy(j), tau, utau)
        #:endif
        call __stcg(F(i-1,j,k-1,2), __ldlu(F(i-1,j,k-1,2)) - tau)
        utau_sum = utau_sum + utau
      end block
    else
      block
        real(8) :: tau, utau, muy
        #:if is_les
        real(8) :: muysgs
        #:endif
        muy = my * (-uvw(idx) + uvw(idx+1)) * dy(j)
        #:if is_les
        muysgs = mysgs * (-uvw(idx) + uvw(idx+1)) * dy(j)
        Hb(1) = Hb(1) + 0.5d0*uvw(idx  )**2
        Hb(2) = Hb(2) + 0.5d0*uvw(idx+1)**2
        #:endif
        tau  = muy + mvx
        utau = 0.5d0 * (uvw(idx) + uvw(idx+1)) * tau
        #:if is_les
        tau = tau + muysgs + mvxsgs
        #:endif
        call __stcg(F(i-1,j,k-1,2), __ldlu(F(i-1,j,k-1,2)) - tau)
        utau_sum = utau_sum + utau
      end block
    endif
    endif
    call syncthreads()
    call load_smem_visc_cent${VISC_ORDER}$_y_stage3(it, jt, kt, i, k, nx, ny, nz, dz(k), Q_3, Q_4, grad_a, uvw)

    ! ---- stage 3: cross component #2 -> F(...,4) [uses uvw=w, grad_a=vz] ----
    if (valid) then
    if (interior) then
      block
        real(8) :: tau, utau
        #:if is_les
        H(:) = H(:) + 0.5d0*uvw(idx-io_v:idx+io_v+1)**2
        Hsgs = -muti * diff${VISC_ORDER}$_s(dy(j), &
        #:if VISC_ORDER == 4
        H(2)-H(3), H(1)-H(4) &
        #:else
        -H(1)+H(6), H(2)-H(5), -H(3)+H(4) &
        #:endif
        ) / Prt
        call calc_tau_cross_LES(mui, muti, uvw(idx-io_v:idx+io_v+1), grad_a(idx-io_v:idx+io_v+1), dy(j), tau, utau)
        #:else
        call calc_tau_cross(mui, uvw(idx-io_v:idx+io_v+1), grad_a(idx-io_v:idx+io_v+1), dy(j), tau, utau)
        #:endif
        call __stcg(F(i-1,j,k-1,4), __ldlu(F(i-1,j,k-1,4)) - tau)
        utau_sum = utau_sum + utau
      end block
    else
      block
        real(8) :: tau, utau, mwy
        #:if is_les
        real(8) :: mwysgs
        #:endif
        mwy = my * (-uvw(idx) + uvw(idx+1)) * dy(j)
        #:if is_les
        mwysgs = mysgs * (-uvw(idx) + uvw(idx+1)) * dy(j)
        Hb(1) = Hb(1) + 0.5d0*uvw(idx  )**2
        Hb(2) = Hb(2) + 0.5d0*uvw(idx+1)**2
        Hsgs = -mysgs * (-Hb(1) + Hb(2)) * dy(j) / Prt
        #:endif
        tau  = mvz + mwy
        utau = 0.5d0 * (uvw(idx) + uvw(idx+1)) * tau
        #:if is_les
        tau = tau + mvzsgs + mwysgs
        #:endif
        call __stcg(F(i-1,j,k-1,4), __ldlu(F(i-1,j,k-1,4)) - tau)
        utau_sum = utau_sum + utau
      end block
    endif
    block
      real(8) :: f5v
      f5v = __ldlu(F(i-1,j,k-1,5))
      call __stcg(F(i-1,j,k-1,5), f5v - (utau_sum + kTy &
    #:if is_les
      + Hsgs &
    #:endif
      ))
    end block
    endif
  end subroutine calc_Fv${VISC_ORDER}$${suf}$
#:endfor


#:for is_koff in [False, True]
  #:set suf = base_suf
  #:if is_koff
    #:set suf = suf + "_koff"
  #:endif
  attributes(global) subroutine calc_Gv${VISC_ORDER}$${suf}$(nx, ny, nz, dx, dy, dz, Q_2, Q_3, Q_4, T, mu, &
    #:if is_les
      mut, qc2, &
    #:endif
    #:if is_koff
      k_lo, k_hi, &
    #:endif
    G)
    integer, intent(in), value                 :: nx
    integer, intent(in), value                 :: ny
    integer, intent(in), value                 :: nz
    real(8), intent(in), device, contiguous    :: dx(nx-1)
    real(8), intent(in), device, contiguous    :: dy(ny-1)
    real(8), intent(in), device, contiguous    :: dz(nz-1)
    real(8), intent(in), device, contiguous    :: Q_2(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: Q_3(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: Q_4(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: T(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: mu(nx,ny,nz)
    #:if is_les
    real(8), intent(in), device, contiguous    :: mut(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: qc2(nx,ny,nz)
    #:endif
    real(8), intent(inout), device, contiguous :: G(nx-2,ny-2,nz-1,5)
    #:if is_koff
    integer, intent(in), value                 :: k_lo
    integer, intent(in), value                 :: k_hi
    #:endif
    #:if VISC_ORDER == 4
    integer, parameter :: io_v = 1
    #:else
    integer, parameter :: io_v = 2
    #:endif
    integer, parameter :: sx = threadsGv%x
    integer, parameter :: sy = threadsGv%y
    integer, parameter :: sz = threadsGv%z + 2*io_v + 1
    real(8), dimension(-(io_v-1):sx*sy*sz-io_v), shared :: uvw
    real(8), dimension(-(io_v-1):sx*sy*sz-io_v), shared :: grad_a
    real(8), dimension(-(io_v-1):sx*sy*sz-io_v), shared :: grad_b
    integer i, j, k, it, jt, kt, idx, offset_xy
    logical :: valid, interior
    real(8) :: kTz, utau_sum, mui
    ! only the boundary-path scalars actually needed by a LATER stage persist
    ! at subroutine scope; everything used within a single stage is declared
    ! inside that stage's own `block` below to keep its register live range
    ! short.
    real(8) :: mz, mwx, mwy
    #:if is_les
    real(8) :: Hsgs, mzsgs, mwxsgs, mwysgs, muti
    real(8) :: H(2*io_v+2), Hb(2)
    #:endif
    it = threadIdx%x
    jt = threadIdx%y
    kt = threadIdx%z
    i  = (blockIdx%x-1)*blockDim%x + it + 1
    j  = (blockIdx%y-1)*blockDim%y + jt + 1
    offset_xy = (jt-1)*sz + (it-1)*sz*sy
    #:if is_koff
    call load_smem_visc_cent${VISC_ORDER}$_z_koff_stage1(it, jt, kt, i, j, nx, ny, nz, dx(i), dy(j), Q_2, Q_3, Q_4, grad_a, grad_b, uvw, k_lo)
    k  = (blockIdx%z-1)*blockDim%z + k_lo - 1 + kt
    valid = .not. (nx-1 < i .or. ny-1 < j .or. k_hi < k)
    #:else
    call load_smem_visc_cent${VISC_ORDER}$_z_stage1(it, jt, kt, i, j, nx, ny, nz, dx(i), dy(j), Q_2, Q_3, Q_4, grad_a, grad_b, uvw)
    k  = (blockIdx%z-1)*blockDim%z + kt
    valid = .not. (nx-1 < i .or. ny-1 < j .or. nz-1 < k)
    #:endif
    idx = kt + offset_xy
    if (valid) then
      interior = (io_v+2 <= i .and. i <= nx-io_v-1 .and. io_v+2 <= j .and. j <= ny-io_v-1 .and. io_v+1 <= k .and. k <= nz-io_v-1)
    endif

    ! ---- stage 1: straight component -> G(...,4) [uses uvw=w, grad_a=ux, grad_b=vy] ----
    if (valid) then
    if (interior) then
      block
        real(8) :: Tx
        #:if VISC_ORDER == 4
        mui = interp${VISC_ORDER}$_s(mu(i,j,k)+mu(i,j,k+1), mu(i,j,k-1)+mu(i,j,k+2))
        Tx  = diff${VISC_ORDER}$_s(dz(k), T(i,j,k)-T(i,j,k+1), T(i,j,k-1)-T(i,j,k+2))
        #:if is_les
        muti = interp${VISC_ORDER}$_s(mut(i,j,k)+mut(i,j,k+1), mut(i,j,k-1)+mut(i,j,k+2))
        H(1) = Cp*T(i,j,k-1) + 0.5d0*uvw(idx-1)**2 + qc2(i,j,k-1)
        H(2) = Cp*T(i,j,k  ) + 0.5d0*uvw(idx  )**2 + qc2(i,j,k  )
        H(3) = Cp*T(i,j,k+1) + 0.5d0*uvw(idx+1)**2 + qc2(i,j,k+1)
        H(4) = Cp*T(i,j,k+2) + 0.5d0*uvw(idx+2)**2 + qc2(i,j,k+2)
        #:endif
        #:else
        mui = interp${VISC_ORDER}$_s(mu(i,j,k-2)+mu(i,j,k+3), mu(i,j,k-1)+mu(i,j,k+2), mu(i,j,k)+mu(i,j,k+1))
        Tx  = diff${VISC_ORDER}$_s(dz(k), -T(i,j,k-2)+T(i,j,k+3), T(i,j,k-1)-T(i,j,k+2), -T(i,j,k)+T(i,j,k+1))
        #:if is_les
        muti = interp${VISC_ORDER}$_s(mut(i,j,k-2)+mut(i,j,k+3), mut(i,j,k-1)+mut(i,j,k+2), mut(i,j,k)+mut(i,j,k+1))
        H(1) = Cp*T(i,j,k-2) + 0.5d0*uvw(idx-2)**2 + qc2(i,j,k-2)
        H(2) = Cp*T(i,j,k-1) + 0.5d0*uvw(idx-1)**2 + qc2(i,j,k-1)
        H(3) = Cp*T(i,j,k  ) + 0.5d0*uvw(idx  )**2 + qc2(i,j,k  )
        H(4) = Cp*T(i,j,k+1) + 0.5d0*uvw(idx+1)**2 + qc2(i,j,k+1)
        H(5) = Cp*T(i,j,k+2) + 0.5d0*uvw(idx+2)**2 + qc2(i,j,k+2)
        H(6) = Cp*T(i,j,k+3) + 0.5d0*uvw(idx+3)**2 + qc2(i,j,k+3)
        #:endif
        #:endif
        kTz = Cp_over_Pr * mui * Tx
        block
          real(8) :: tau, utau
          #:if is_les
          call calc_tau_straight_LES(mui, muti, uvw(idx-io_v:idx+io_v+1), grad_a(idx-io_v:idx+io_v+1), grad_b(idx-io_v:idx+io_v+1), dz(k), tau, utau)
          #:else
          call calc_tau_straight(mui, uvw(idx-io_v:idx+io_v+1), grad_a(idx-io_v:idx+io_v+1), grad_b(idx-io_v:idx+io_v+1), dz(k), tau, utau)
          #:endif
          call __stcg(G(i-1,j-1,k,4), __ldlu(G(i-1,j-1,k,4)) - tau)
          utau_sum = utau
        end block
      end block
    else
      block
        real(8) :: mu_c, mu_t, T_c, T_t, mux, mvy, mwz
        #:if is_les
        real(8) :: mut_c, mut_t, muxsgs, mvysgs, mwzsgs
        #:endif
        mu_c = mu(i,  j,  k)
        mu_t = mu(i,  j,  k+1)
        mz   = 0.5d0 * (mu_c + mu_t)
        T_c  = T(i,j,k  )
        T_t  = T(i,j,k+1)
        kTz  = Cp_over_Pr * mz * (T_t - T_c) * dz(k)
        #:if is_les
        mut_c = mut(i,  j,  k)
        mut_t = mut(i,  j,  k+1)
        mzsgs = 0.5d0 * (mut_c + mut_t)
        #:endif
        block
          real(8) :: mx(2), mu_wc, mu_wt, mu_ec, mu_et
          #:if is_les
          real(8) :: mxsgs(2), mut_wc, mut_wt, mut_ec, mut_et
          #:endif
          ! corner neighbours below are each read exactly once by this thread: __ldcs
          mu_wc = __ldcs(mu(i-1,j,  k))
          mu_wt = __ldcs(mu(i-1,j,  k+1))
          mu_ec = __ldcs(mu(i+1,j,  k))
          mu_et = __ldcs(mu(i+1,j,  k+1))
          mx(1) = 0.25d0 * (mu_wc + mu_c + mu_wt + mu_t)
          mx(2) = 0.25d0 * (mu_c + mu_ec + mu_t + mu_et)
          mux = 0.25d0 * (mx(1) * (-Q_2(i-1,j,k) + Q_2(i,j,k) - Q_2(i-1,j,k+1) + Q_2(i,j,k+1)) &
                        + mx(2) * (-Q_2(i,j,k) + Q_2(i+1,j,k) - Q_2(i,j,k+1) + Q_2(i+1,j,k+1))) * dx(i)
          mwx = 0.25d0 * (mx(1) * (-Q_4(i-1,j,k) + Q_4(i,j,k) - Q_4(i-1,j,k+1) + Q_4(i,j,k+1)) &
                        + mx(2) * (-Q_4(i,j,k) + Q_4(i+1,j,k) - Q_4(i,j,k+1) + Q_4(i+1,j,k+1))) * dx(i)
          #:if is_les
          mut_wc = __ldcs(mut(i-1,j,  k))
          mut_wt = __ldcs(mut(i-1,j,  k+1))
          mut_ec = __ldcs(mut(i+1,j,  k))
          mut_et = __ldcs(mut(i+1,j,  k+1))
          mxsgs(:) = (/0.25d0 * (mut_wc + mut_c + mut_wt + mut_t), &
                       0.25d0 * (mut_c + mut_ec + mut_t + mut_et)/)
          muxsgs = 0.25d0 * (mxsgs(1) * (-Q_2(i-1,j,k) + Q_2(i,j,k) - Q_2(i-1,j,k+1) + Q_2(i,j,k+1)) &
                            + mxsgs(2) * (-Q_2(i,j,k) + Q_2(i+1,j,k) - Q_2(i,j,k+1) + Q_2(i+1,j,k+1))) * dx(i)
          mwxsgs = 0.25d0 * (mxsgs(1) * (-Q_4(i-1,j,k) + Q_4(i,j,k) - Q_4(i-1,j,k+1) + Q_4(i,j,k+1)) &
                            + mxsgs(2) * (-Q_4(i,j,k) + Q_4(i+1,j,k) - Q_4(i,j,k+1) + Q_4(i+1,j,k+1))) * dx(i)
          #:endif
        end block
        block
          real(8) :: my(2), mu_sc, mu_st, mu_nc, mu_nt
          #:if is_les
          real(8) :: mysgs(2), mut_sc, mut_st, mut_nc, mut_nt
          #:endif
          ! corner neighbours below are each read exactly once by this thread: __ldcs
          mu_sc = __ldcs(mu(i,  j-1,k))
          mu_st = __ldcs(mu(i,  j-1,k+1))
          mu_nc = __ldcs(mu(i,  j+1,k))
          mu_nt = __ldcs(mu(i,  j+1,k+1))
          my(1) = 0.25d0 * (mu_sc + mu_c + mu_st + mu_t)
          my(2) = 0.25d0 * (mu_c + mu_nc + mu_t + mu_nt)
          mvy = 0.25d0 * (my(1) * (-Q_3(i,j-1,k) + Q_3(i,j,k) - Q_3(i,j-1,k+1) + Q_3(i,j,k+1)) &
                        + my(2) * (-Q_3(i,j,k) + Q_3(i,j+1,k) - Q_3(i,j,k+1) + Q_3(i,j+1,k+1))) * dy(j)
          mwy = 0.25d0 * (my(1) * (-Q_4(i,j-1,k) + Q_4(i,j,k) - Q_4(i,j-1,k+1) + Q_4(i,j,k+1)) &
                        + my(2) * (-Q_4(i,j,k) + Q_4(i,j+1,k) - Q_4(i,j,k+1) + Q_4(i,j+1,k+1))) * dy(j)
          #:if is_les
          mut_sc = __ldcs(mut(i,  j-1,k))
          mut_st = __ldcs(mut(i,  j-1,k+1))
          mut_nc = __ldcs(mut(i,  j+1,k))
          mut_nt = __ldcs(mut(i,  j+1,k+1))
          mysgs(:) = (/0.25d0 * (mut_sc + mut_c + mut_st + mut_t), &
                       0.25d0 * (mut_c + mut_nc + mut_t + mut_nt)/)
          mvysgs = 0.25d0 * (mysgs(1) * (-Q_3(i,j-1,k) + Q_3(i,j,k) - Q_3(i,j-1,k+1) + Q_3(i,j,k+1)) &
                            + mysgs(2) * (-Q_3(i,j,k) + Q_3(i,j+1,k) - Q_3(i,j,k+1) + Q_3(i,j+1,k+1))) * dy(j)
          mwysgs = 0.25d0 * (mysgs(1) * (-Q_4(i,j-1,k) + Q_4(i,j,k) - Q_4(i,j-1,k+1) + Q_4(i,j,k+1)) &
                            + mysgs(2) * (-Q_4(i,j,k) + Q_4(i,j+1,k) - Q_4(i,j,k+1) + Q_4(i,j+1,k+1))) * dy(j)
          #:endif
        end block
        mwz = mz * (-uvw(idx) + uvw(idx+1)) * dz(k)
        #:if is_les
        mwzsgs = mzsgs * (-uvw(idx) + uvw(idx+1)) * dz(k)
        Hb(1) = Cp*T_c + 0.5d0*uvw(idx  )**2 + qc2(i,j,k  )
        Hb(2) = Cp*T_t + 0.5d0*uvw(idx+1)**2 + qc2(i,j,k+1)
        #:endif
        block
          real(8) :: tau, utau
          tau  = two_third * fma(2.d0, mwz, -(mux + mvy))
          utau = 0.5d0 * (uvw(idx) + uvw(idx+1)) * tau
          #:if is_les
          tau = fma(two_third, fma(2.d0, mwzsgs, -(muxsgs + mvysgs)), tau)
          #:endif
          call __stcg(G(i-1,j-1,k,4), __ldlu(G(i-1,j-1,k,4)) - tau)
          utau_sum = utau
        end block
      end block
    endif
    endif
    call syncthreads()
    #:if is_koff
    call load_smem_visc_cent${VISC_ORDER}$_z_koff_stage2(it, jt, kt, i, j, nx, ny, nz, dx(i), Q_2, Q_4, grad_a, uvw, k_lo)
    #:else
    call load_smem_visc_cent${VISC_ORDER}$_z_stage2(it, jt, kt, i, j, nx, ny, nz, dx(i), Q_2, Q_4, grad_a, uvw)
    #:endif

    ! ---- stage 2: cross component #1 -> G(...,2) [uses uvw=u, grad_a=wx] ----
    if (valid) then
    if (interior) then
      block
        real(8) :: tau, utau
        #:if is_les
        H(:) = H(:) + 0.5d0*uvw(idx-io_v:idx+io_v+1)**2
        call calc_tau_cross_LES(mui, muti, uvw(idx-io_v:idx+io_v+1), grad_a(idx-io_v:idx+io_v+1), dz(k), tau, utau)
        #:else
        call calc_tau_cross(mui, uvw(idx-io_v:idx+io_v+1), grad_a(idx-io_v:idx+io_v+1), dz(k), tau, utau)
        #:endif
        call __stcg(G(i-1,j-1,k,2), __ldlu(G(i-1,j-1,k,2)) - tau)
        utau_sum = utau_sum + utau
      end block
    else
      block
        real(8) :: tau, utau, muz
        #:if is_les
        real(8) :: muzsgs
        #:endif
        muz = mz * (-uvw(idx) + uvw(idx+1)) * dz(k)
        #:if is_les
        muzsgs = mzsgs * (-uvw(idx) + uvw(idx+1)) * dz(k)
        Hb(1) = Hb(1) + 0.5d0*uvw(idx  )**2
        Hb(2) = Hb(2) + 0.5d0*uvw(idx+1)**2
        #:endif
        tau  = mwx + muz
        utau = 0.5d0 * (uvw(idx) + uvw(idx+1)) * tau
        #:if is_les
        tau = tau + mwxsgs + muzsgs
        #:endif
        call __stcg(G(i-1,j-1,k,2), __ldlu(G(i-1,j-1,k,2)) - tau)
        utau_sum = utau_sum + utau
      end block
    endif
    endif
    call syncthreads()
    #:if is_koff
    call load_smem_visc_cent${VISC_ORDER}$_z_koff_stage3(it, jt, kt, i, j, nx, ny, nz, dy(j), Q_3, Q_4, grad_a, uvw, k_lo)
    #:else
    call load_smem_visc_cent${VISC_ORDER}$_z_stage3(it, jt, kt, i, j, nx, ny, nz, dy(j), Q_3, Q_4, grad_a, uvw)
    #:endif

    ! ---- stage 3: cross component #2 -> G(...,3) [uses uvw=v, grad_a=wy] ----
    if (valid) then
    if (interior) then
      block
        real(8) :: tau, utau
        #:if is_les
        H(:) = H(:) + 0.5d0*uvw(idx-io_v:idx+io_v+1)**2
        Hsgs = -muti * diff${VISC_ORDER}$_s(dz(k), &
        #:if VISC_ORDER == 4
        H(2)-H(3), H(1)-H(4) &
        #:else
        -H(1)+H(6), H(2)-H(5), -H(3)+H(4) &
        #:endif
        ) / Prt
        call calc_tau_cross_LES(mui, muti, uvw(idx-io_v:idx+io_v+1), grad_a(idx-io_v:idx+io_v+1), dz(k), tau, utau)
        #:else
        call calc_tau_cross(mui, uvw(idx-io_v:idx+io_v+1), grad_a(idx-io_v:idx+io_v+1), dz(k), tau, utau)
        #:endif
        call __stcg(G(i-1,j-1,k,3), __ldlu(G(i-1,j-1,k,3)) - tau)
        utau_sum = utau_sum + utau
      end block
    else
      block
        real(8) :: tau, utau, mvz
        #:if is_les
        real(8) :: mvzsgs
        #:endif
        mvz = mz * (-uvw(idx) + uvw(idx+1)) * dz(k)
        #:if is_les
        mvzsgs = mzsgs * (-uvw(idx) + uvw(idx+1)) * dz(k)
        Hb(1) = Hb(1) + 0.5d0*uvw(idx  )**2
        Hb(2) = Hb(2) + 0.5d0*uvw(idx+1)**2
        Hsgs = -mzsgs * (-Hb(1) + Hb(2)) * dz(k) / Prt
        #:endif
        tau  = mvz + mwy
        utau = 0.5d0 * (uvw(idx) + uvw(idx+1)) * tau
        #:if is_les
        tau = tau + mvzsgs + mwysgs
        #:endif
        call __stcg(G(i-1,j-1,k,3), __ldlu(G(i-1,j-1,k,3)) - tau)
        utau_sum = utau_sum + utau
      end block
    endif
    block
      real(8) :: g5v
      g5v = __ldlu(G(i-1,j-1,k,5))
      call __stcg(G(i-1,j-1,k,5), g5v - (utau_sum + kTz &
    #:if is_les
      + Hsgs &
    #:endif
      ))
    end block
    endif
  end subroutine calc_Gv${VISC_ORDER}$${suf}$
#:endfor
end module calc_visc_high
#:endif
