#:include 'config.fypp'
#:include 'precision.fypp'
#:if not defined('VISC_ORDER')
  #:set VISC_ORDER = ORDER
#:endif
#:set is_les = (VISC == 'LES')
#:set base_suf = "_in"
#:if VISC_ORDER == 2
module calc_visc_high_internal
end module calc_visc_high_internal
#:else
module calc_visc_high_internal
  use mod_precision
  ! constants referenced by the included calc_visc_cent.f90.fypp
  use mod_constant, only : two_third_visc, one_24_visc
  use libm
  use mod_globals, only : threadsEv, threadsFv, threadsGv
  use mod_constant, only : Prt => Prt_visc
  use mod_constant, only : Cp => Cp_visc, Cp_over_Pr => Cp_over_Pr_visc
  use load_smem_visc_cent${VISC_ORDER}$
  implicit none
  private
  public calc_Ev${VISC_ORDER}$_in, calc_Fv${VISC_ORDER}$_in, calc_Gv${VISC_ORDER}$_in, &
         calc_Ev${VISC_ORDER}$_in_koff, calc_Fv${VISC_ORDER}$_in_koff, calc_Gv${VISC_ORDER}$_in_koff
contains
  #:include 'calc_visc_cent.f90.fypp'

  ! mu is never held in shared memory or a register array -- `mui` is
  ! computed once via scalar reads + interp${VISC_ORDER}$_s and reused for
  ! all 3 tau/flux terms; likewise T uses diff${VISC_ORDER}$_s directly on
  ! scalar reads. u,v,w and the two cross-gradients unique to this direction
  ! (e.g. uy,uz for Ev) are loaded once into persistent shared buffers by a
  ! single load_smem_visc_cent call. The two "straight" gradients this
  ! direction needs but doesn't own (e.g. vy,wz for Ev) are precomputed once
  ! by calc_div and read straight from DRAM here instead -- avoids each of
  ! Ev/Fv/Gv recomputing the other two independently.

#:for is_koff in [False, True]
  #:set suf = base_suf
  #:if is_koff
    #:set suf = suf + "_koff"
  #:endif
  attributes(global) subroutine calc_Ev${VISC_ORDER}$${suf}$(nx, ny, nz, dx, dy, dz, Q_2, Q_3, Q_4, T, mu, &
    #:if is_les
      mut, qc2, &
    #:endif
    vy, wz, &
    #:if is_koff
      k_lo, k_hi, &
    #:endif
    E)
    integer, intent(in), value                 :: nx
    integer, intent(in), value                 :: ny
    integer, intent(in), value                 :: nz
    real(kd_arr), intent(in), device, contiguous    :: dx(nx-1)
    real(kd_arr), intent(in), device, contiguous    :: dy(ny-1)
    real(kd_arr), intent(in), device, contiguous    :: dz(nz-1)
    real(kd_arr), intent(in), device, contiguous    :: Q_2(nx,ny,nz)
    real(kd_arr), intent(in), device, contiguous    :: Q_3(nx,ny,nz)
    real(kd_arr), intent(in), device, contiguous    :: Q_4(nx,ny,nz)
    real(kd_arr), intent(in), device, contiguous    :: T(nx,ny,nz)
    real(kd_arr), intent(in), device, contiguous    :: mu(nx,ny,nz)
    #:if is_les
    real(kd_arr), intent(in), device, contiguous    :: mut(nx,ny,nz)
    real(kd_arr), intent(in), device, contiguous    :: qc2(nx,ny,nz)
    #:endif
    real(kd_arr), intent(in), device, contiguous    :: vy(nx,ny,nz) !< dv/dy at cell-center, precomputed by calc_div
    real(kd_arr), intent(in), device, contiguous    :: wz(nx,ny,nz) !< dw/dz at cell-center, precomputed by calc_div
    real(kd_arr), intent(inout), device, contiguous :: E(nx-1,ny-2,nz-2,5)
    #:if is_koff
    integer, intent(in), value                 :: k_lo
    integer, intent(in), value                 :: k_hi
    #:endif
    #:if VISC_ORDER == 4
    integer, parameter :: io_v = 1
    #:else
    integer, parameter :: io_v = 2
    #:endif
    integer, parameter :: sx = threadsEv%x + 2*io_v + 1
    integer, parameter :: sy = threadsEv%y
    integer, parameter :: sz = threadsEv%z
    real(kd_visc), dimension(-(io_v-1):sx*sy*sz-io_v), shared ::  u
    real(kd_visc), dimension(-(io_v-1):sx*sy*sz-io_v), shared ::  v
    real(kd_visc), dimension(-(io_v-1):sx*sy*sz-io_v), shared ::  w
    real(kd_visc), dimension(-(io_v-1):sx*sy*sz-io_v), shared :: uy
    real(kd_visc), dimension(-(io_v-1):sx*sy*sz-io_v), shared :: uz
    integer i, j, k, it, jt, kt, idx
    logical :: valid, interior
    real(kd_visc) :: utau_sum, mui
    #:if is_les
    real(kd_visc) :: Hsgs, muti
    real(kd_visc) :: H(2*io_v+2)
    #:endif
    interior = .false.
    it = threadIdx%x
    jt = threadIdx%y
    kt = threadIdx%z
    j  = (blockIdx%y-1)*blockDim%y + jt + 1
    #:if is_koff
    k  = (blockIdx%z-1)*blockDim%z + kt + k_lo - 1
    #:else
    k  = (blockIdx%z-1)*blockDim%z + kt + 1
    #:endif
    call load_smem_visc_cent${VISC_ORDER}$_x(it, jt, kt, j, k, nx, ny, nz, real(dy(j), kd_visc), real(dz(k), kd_visc), Q_2, Q_3, Q_4, u, v, w, uy, uz)
    i  = (blockIdx%x-1)*blockDim%x + it
    idx = it + (jt-1)*sx + (kt-1)*sx*sy
    #:if is_koff
    valid = .not. (nx-1 < i .or. ny-1 < j .or. k_hi < k)
    #:else
    valid = .not. (nx-1 < i .or. ny-1 < j .or. nz-1 < k)
    #:endif
    if (valid) then
      interior = (io_v+1 <= i .and. i <= nx-io_v-1 .and. io_v+2 <= j .and. j <= ny-io_v-1 .and. io_v+2 <= k .and. k <= nz-io_v-1)
    endif

    if (valid .and. interior) then
      #:if VISC_ORDER == 4
      mui = interp${VISC_ORDER}$_s(real(mu(i,j,k), kd_visc)+real(mu(i+1,j,k), kd_visc), real(mu(i-1,j,k), kd_visc)+real(mu(i+2,j,k), kd_visc))
      #:if is_les
      muti = interp${VISC_ORDER}$_s(real(mut(i,j,k), kd_visc)+real(mut(i+1,j,k), kd_visc), real(mut(i-1,j,k), kd_visc)+real(mut(i+2,j,k), kd_visc))
      H(1) = Cp*real(T(i-1,j,k), kd_visc) + 0.5_kd_visc*u(idx-1)**2 + real(qc2(i-1,j,k), kd_visc)
      H(2) = Cp*real(T(i,  j,k), kd_visc) + 0.5_kd_visc*u(idx  )**2 + real(qc2(i,  j,k), kd_visc)
      H(3) = Cp*real(T(i+1,j,k), kd_visc) + 0.5_kd_visc*u(idx+1)**2 + real(qc2(i+1,j,k), kd_visc)
      H(4) = Cp*real(T(i+2,j,k), kd_visc) + 0.5_kd_visc*u(idx+2)**2 + real(qc2(i+2,j,k), kd_visc)
      #:endif
      #:else
      mui = interp${VISC_ORDER}$_s(real(mu(i-2,j,k), kd_visc)+real(mu(i+3,j,k), kd_visc), real(mu(i-1,j,k), kd_visc)+real(mu(i+2,j,k), kd_visc), real(mu(i,j,k), kd_visc)+real(mu(i+1,j,k), kd_visc))
      #:if is_les
      muti = interp${VISC_ORDER}$_s(real(mut(i-2,j,k), kd_visc)+real(mut(i+3,j,k), kd_visc), real(mut(i-1,j,k), kd_visc)+real(mut(i+2,j,k), kd_visc), real(mut(i,j,k), kd_visc)+real(mut(i+1,j,k), kd_visc))
      H(1) = Cp*real(T(i-2,j,k), kd_visc) + 0.5_kd_visc*u(idx-2)**2 + real(qc2(i-2,j,k), kd_visc)
      H(2) = Cp*real(T(i-1,j,k), kd_visc) + 0.5_kd_visc*u(idx-1)**2 + real(qc2(i-1,j,k), kd_visc)
      H(3) = Cp*real(T(i,  j,k), kd_visc) + 0.5_kd_visc*u(idx  )**2 + real(qc2(i,  j,k), kd_visc)
      H(4) = Cp*real(T(i+1,j,k), kd_visc) + 0.5_kd_visc*u(idx+1)**2 + real(qc2(i+1,j,k), kd_visc)
      H(5) = Cp*real(T(i+2,j,k), kd_visc) + 0.5_kd_visc*u(idx+2)**2 + real(qc2(i+2,j,k), kd_visc)
      H(6) = Cp*real(T(i+3,j,k), kd_visc) + 0.5_kd_visc*u(idx+3)**2 + real(qc2(i+3,j,k), kd_visc)
      #:endif
      #:endif
      #:if is_les
      H(:) = H(:) + 0.5_kd_visc*v(idx-io_v:idx+io_v+1)**2 + 0.5_kd_visc*w(idx-io_v:idx+io_v+1)**2
      #:endif
      block
        real(kd_visc) :: tau, utau
        #:if is_les
        #:if VISC_CAST
        block
          real(kd_visc) :: s1(2*io_v+2), s2(2*io_v+2)
          s1 = vy(i-io_v:i+io_v+1,j,k)
          s2 = wz(i-io_v:i+io_v+1,j,k)
          call calc_tau_straight_LES(mui, muti, u(idx-io_v:idx+io_v+1), s1, s2, real(dx(i), kd_visc), tau, utau)
        end block
        #:else
        call calc_tau_straight_LES(mui, muti, u(idx-io_v:idx+io_v+1), vy(i-io_v:i+io_v+1,j,k), wz(i-io_v:i+io_v+1,j,k), real(dx(i), kd_visc), tau, utau)
        #:endif
        #:else
        #:if VISC_CAST
        block
          real(kd_visc) :: s1(2*io_v+2), s2(2*io_v+2)
          s1 = vy(i-io_v:i+io_v+1,j,k)
          s2 = wz(i-io_v:i+io_v+1,j,k)
          call calc_tau_straight(mui, u(idx-io_v:idx+io_v+1), s1, s2, real(dx(i), kd_visc), tau, utau)
        end block
        #:else
        call calc_tau_straight(mui, u(idx-io_v:idx+io_v+1), vy(i-io_v:i+io_v+1,j,k), wz(i-io_v:i+io_v+1,j,k), real(dx(i), kd_visc), tau, utau)
        #:endif
        #:endif
        call __stcg(E(i,j-1,k-1,2), __ldlu(E(i,j-1,k-1,2)) - tau)
        utau_sum = utau
      end block
      block
        real(kd_visc) :: tau, utau
        #:if is_les
        call calc_tau_cross_LES(mui, muti, v(idx-io_v:idx+io_v+1), uy(idx-io_v:idx+io_v+1), real(dx(i), kd_visc), tau, utau)
        #:else
        call calc_tau_cross(mui, v(idx-io_v:idx+io_v+1), uy(idx-io_v:idx+io_v+1), real(dx(i), kd_visc), tau, utau)
        #:endif
        call __stcg(E(i,j-1,k-1,3), __ldlu(E(i,j-1,k-1,3)) - tau)
        utau_sum = utau_sum + utau
      end block
      block
        real(kd_visc) :: tau, utau
        #:if is_les
        call calc_tau_cross_LES(mui, muti, w(idx-io_v:idx+io_v+1), uz(idx-io_v:idx+io_v+1), real(dx(i), kd_visc), tau, utau)
        #:else
        call calc_tau_cross(mui, w(idx-io_v:idx+io_v+1), uz(idx-io_v:idx+io_v+1), real(dx(i), kd_visc), tau, utau)
        #:endif
        call __stcg(E(i,j-1,k-1,4), __ldlu(E(i,j-1,k-1,4)) - tau)
        utau_sum = utau_sum + utau
      end block
      block
        real(kd_arr)  :: e5v  ! value loaded from the kd_arr flux array
        real(kd_visc) :: Tx, kTx
        #:if VISC_ORDER == 4
        Tx  = diff${VISC_ORDER}$_s(real(dx(i), kd_visc), real(T(i,j,k), kd_visc)-real(T(i+1,j,k), kd_visc), real(T(i-1,j,k), kd_visc)-real(T(i+2,j,k), kd_visc))
        #:else
        Tx  = diff${VISC_ORDER}$_s(real(dx(i), kd_visc), -real(T(i-2,j,k), kd_visc)+real(T(i+3,j,k), kd_visc), real(T(i-1,j,k), kd_visc)-real(T(i+2,j,k), kd_visc), -real(T(i,j,k), kd_visc)+real(T(i+1,j,k), kd_visc))
        #:endif
        kTx = Cp_over_Pr * mui * Tx
        #:if is_les
        Hsgs = -muti * diff${VISC_ORDER}$_s(real(dx(i), kd_visc), &
        #:if VISC_ORDER == 4
        H(2)-H(3), H(1)-H(4) &
        #:else
        -H(1)+H(6), H(2)-H(5), -H(3)+H(4) &
        #:endif
        ) / Prt
        #:endif
        e5v = __ldlu(E(i,j-1,k-1,5))
        call __stcg(E(i,j-1,k-1,5), e5v - (utau_sum + kTx &
    #:if is_les
      + Hsgs &
    #:endif
      ))
      end block
    endif
  end subroutine calc_Ev${VISC_ORDER}$${suf}$
#:endfor


#:for is_koff in [False, True]
  #:set suf = base_suf
  #:if is_koff
    #:set suf = suf + "_koff"
  #:endif
  attributes(global) subroutine calc_Fv${VISC_ORDER}$${suf}$(nx, ny, nz, dx, dy, dz, Q_2, Q_3, Q_4, T, mu, &
    #:if is_les
      mut, qc2, &
    #:endif
    ux, wz, &
    #:if is_koff
      k_lo, k_hi, &
    #:endif
    F)
    integer, intent(in), value                 :: nx
    integer, intent(in), value                 :: ny
    integer, intent(in), value                 :: nz
    real(kd_arr), intent(in), device, contiguous    :: dx(nx-1)
    real(kd_arr), intent(in), device, contiguous    :: dy(ny-1)
    real(kd_arr), intent(in), device, contiguous    :: dz(nz-1)
    real(kd_arr), intent(in), device, contiguous    :: Q_2(nx,ny,nz)
    real(kd_arr), intent(in), device, contiguous    :: Q_3(nx,ny,nz)
    real(kd_arr), intent(in), device, contiguous    :: Q_4(nx,ny,nz)
    real(kd_arr), intent(in), device, contiguous    :: T(nx,ny,nz)
    real(kd_arr), intent(in), device, contiguous    :: mu(nx,ny,nz)
    #:if is_les
    real(kd_arr), intent(in), device, contiguous    :: mut(nx,ny,nz)
    real(kd_arr), intent(in), device, contiguous    :: qc2(nx,ny,nz)
    #:endif
    real(kd_arr), intent(in), device, contiguous    :: ux(nx,ny,nz) !< du/dx at cell-center, precomputed by calc_div
    real(kd_arr), intent(in), device, contiguous    :: wz(nx,ny,nz) !< dw/dz at cell-center, precomputed by calc_div
    real(kd_arr), intent(inout), device, contiguous :: F(nx-2,ny-1,nz-2,5)
    #:if is_koff
    integer, intent(in), value                 :: k_lo
    integer, intent(in), value                 :: k_hi
    #:endif
    #:if VISC_ORDER == 4
    integer, parameter :: io_v = 1
    #:else
    integer, parameter :: io_v = 2
    #:endif
    integer, parameter :: sx = threadsFv%x
    integer, parameter :: sy = threadsFv%y + 2*io_v + 1
    integer, parameter :: sz = threadsFv%z
    real(kd_visc), dimension(-(io_v-1):sx*sy*sz-io_v), shared ::  u
    real(kd_visc), dimension(-(io_v-1):sx*sy*sz-io_v), shared ::  v
    real(kd_visc), dimension(-(io_v-1):sx*sy*sz-io_v), shared ::  w
    real(kd_visc), dimension(-(io_v-1):sx*sy*sz-io_v), shared :: vx
    real(kd_visc), dimension(-(io_v-1):sx*sy*sz-io_v), shared :: vz
    integer i, j, k, it, jt, kt, idx
    logical :: valid, interior
    real(kd_visc) :: utau_sum, mui
    #:if is_les
    real(kd_visc) :: Hsgs, muti
    real(kd_visc) :: H(2*io_v+2)
    #:endif
    interior = .false.
    it = threadIdx%x
    jt = threadIdx%y
    kt = threadIdx%z
    i  = (blockIdx%x-1)*blockDim%x + it + 1
    #:if is_koff
    k  = (blockIdx%z-1)*blockDim%z + kt + k_lo - 1
    #:else
    k  = (blockIdx%z-1)*blockDim%z + kt + 1
    #:endif
    call load_smem_visc_cent${VISC_ORDER}$_y(it, jt, kt, i, k, nx, ny, nz, real(dx(i), kd_visc), real(dz(k), kd_visc), Q_2, Q_3, Q_4, u, v, w, vx, vz)
    j  = (blockIdx%y-1)*blockDim%y + jt
    idx = jt + (it-1)*sy + (kt-1)*sy*sx
    #:if is_koff
    valid = .not. (nx-1 < i .or. ny-1 < j .or. k_hi < k)
    #:else
    valid = .not. (nx-1 < i .or. ny-1 < j .or. nz-1 < k)
    #:endif
    if (valid) then
      interior = (io_v+2 <= i .and. i <= nx-io_v-1 .and. io_v+1 <= j .and. j <= ny-io_v-1 .and. io_v+2 <= k .and. k <= nz-io_v-1)
    endif

    if (valid .and. interior) then
      #:if VISC_ORDER == 4
      mui = interp${VISC_ORDER}$_s(real(mu(i,j,k), kd_visc)+real(mu(i,j+1,k), kd_visc), real(mu(i,j-1,k), kd_visc)+real(mu(i,j+2,k), kd_visc))
      #:if is_les
      muti = interp${VISC_ORDER}$_s(real(mut(i,j,k), kd_visc)+real(mut(i,j+1,k), kd_visc), real(mut(i,j-1,k), kd_visc)+real(mut(i,j+2,k), kd_visc))
      H(1) = Cp*real(T(i,j-1,k), kd_visc) + 0.5_kd_visc*v(idx-1)**2 + real(qc2(i,j-1,k), kd_visc)
      H(2) = Cp*real(T(i,j,  k), kd_visc) + 0.5_kd_visc*v(idx  )**2 + real(qc2(i,j,  k), kd_visc)
      H(3) = Cp*real(T(i,j+1,k), kd_visc) + 0.5_kd_visc*v(idx+1)**2 + real(qc2(i,j+1,k), kd_visc)
      H(4) = Cp*real(T(i,j+2,k), kd_visc) + 0.5_kd_visc*v(idx+2)**2 + real(qc2(i,j+2,k), kd_visc)
      #:endif
      #:else
      mui = interp${VISC_ORDER}$_s(real(mu(i,j-2,k), kd_visc)+real(mu(i,j+3,k), kd_visc), real(mu(i,j-1,k), kd_visc)+real(mu(i,j+2,k), kd_visc), real(mu(i,j,k), kd_visc)+real(mu(i,j+1,k), kd_visc))
      #:if is_les
      muti = interp${VISC_ORDER}$_s(real(mut(i,j-2,k), kd_visc)+real(mut(i,j+3,k), kd_visc), real(mut(i,j-1,k), kd_visc)+real(mut(i,j+2,k), kd_visc), real(mut(i,j,k), kd_visc)+real(mut(i,j+1,k), kd_visc))
      H(1) = Cp*real(T(i,j-2,k), kd_visc) + 0.5_kd_visc*v(idx-2)**2 + real(qc2(i,j-2,k), kd_visc)
      H(2) = Cp*real(T(i,j-1,k), kd_visc) + 0.5_kd_visc*v(idx-1)**2 + real(qc2(i,j-1,k), kd_visc)
      H(3) = Cp*real(T(i,j,  k), kd_visc) + 0.5_kd_visc*v(idx  )**2 + real(qc2(i,j,  k), kd_visc)
      H(4) = Cp*real(T(i,j+1,k), kd_visc) + 0.5_kd_visc*v(idx+1)**2 + real(qc2(i,j+1,k), kd_visc)
      H(5) = Cp*real(T(i,j+2,k), kd_visc) + 0.5_kd_visc*v(idx+2)**2 + real(qc2(i,j+2,k), kd_visc)
      H(6) = Cp*real(T(i,j+3,k), kd_visc) + 0.5_kd_visc*v(idx+3)**2 + real(qc2(i,j+3,k), kd_visc)
      #:endif
      #:endif
      #:if is_les
      H(:) = H(:) + 0.5_kd_visc*u(idx-io_v:idx+io_v+1)**2 + 0.5_kd_visc*w(idx-io_v:idx+io_v+1)**2
      #:endif
      block
        real(kd_visc) :: tau, utau
        #:if VISC_ORDER == 4
        #:if is_les
        call calc_tau_straight_LES_s(mui, muti, v(idx-io_v:idx+io_v+1), &
             real(wz(i,j,k), kd_visc)+real(wz(i,j+1,k), kd_visc), real(ux(i,j,k), kd_visc)+real(ux(i,j+1,k), kd_visc), &
             real(wz(i,j-1,k), kd_visc)+real(wz(i,j+2,k), kd_visc), real(ux(i,j-1,k), kd_visc)+real(ux(i,j+2,k), kd_visc), &
             real(dy(j), kd_visc), tau, utau)
        #:else
        call calc_tau_straight_s(mui, v(idx-io_v:idx+io_v+1), &
             real(wz(i,j,k), kd_visc)+real(wz(i,j+1,k), kd_visc), real(ux(i,j,k), kd_visc)+real(ux(i,j+1,k), kd_visc), &
             real(wz(i,j-1,k), kd_visc)+real(wz(i,j+2,k), kd_visc), real(ux(i,j-1,k), kd_visc)+real(ux(i,j+2,k), kd_visc), &
             real(dy(j), kd_visc), tau, utau)
        #:endif
        #:else
        #:if is_les
        call calc_tau_straight_LES_s(mui, muti, v(idx-io_v:idx+io_v+1), &
             real(wz(i,j-2,k), kd_visc)+real(wz(i,j+3,k), kd_visc), real(ux(i,j-2,k), kd_visc)+real(ux(i,j+3,k), kd_visc), &
             real(wz(i,j-1,k), kd_visc)+real(wz(i,j+2,k), kd_visc), real(ux(i,j-1,k), kd_visc)+real(ux(i,j+2,k), kd_visc), &
             real(wz(i,j,  k), kd_visc)+real(wz(i,j+1,k), kd_visc), real(ux(i,j,  k), kd_visc)+real(ux(i,j+1,k), kd_visc), &
             real(dy(j), kd_visc), tau, utau)
        #:else
        call calc_tau_straight_s(mui, v(idx-io_v:idx+io_v+1), &
             real(wz(i,j-2,k), kd_visc)+real(wz(i,j+3,k), kd_visc), real(ux(i,j-2,k), kd_visc)+real(ux(i,j+3,k), kd_visc), &
             real(wz(i,j-1,k), kd_visc)+real(wz(i,j+2,k), kd_visc), real(ux(i,j-1,k), kd_visc)+real(ux(i,j+2,k), kd_visc), &
             real(wz(i,j,  k), kd_visc)+real(wz(i,j+1,k), kd_visc), real(ux(i,j,  k), kd_visc)+real(ux(i,j+1,k), kd_visc), &
             real(dy(j), kd_visc), tau, utau)
        #:endif
        #:endif
        call __stcg(F(i-1,j,k-1,3), __ldlu(F(i-1,j,k-1,3)) - tau)
        utau_sum = utau
      end block
      block
        real(kd_visc) :: tau, utau
        #:if is_les
        call calc_tau_cross_LES(mui, muti, u(idx-io_v:idx+io_v+1), vx(idx-io_v:idx+io_v+1), real(dy(j), kd_visc), tau, utau)
        #:else
        call calc_tau_cross(mui, u(idx-io_v:idx+io_v+1), vx(idx-io_v:idx+io_v+1), real(dy(j), kd_visc), tau, utau)
        #:endif
        call __stcg(F(i-1,j,k-1,2), __ldlu(F(i-1,j,k-1,2)) - tau)
        utau_sum = utau_sum + utau
      end block
      block
        real(kd_visc) :: tau, utau
        #:if is_les
        call calc_tau_cross_LES(mui, muti, w(idx-io_v:idx+io_v+1), vz(idx-io_v:idx+io_v+1), real(dy(j), kd_visc), tau, utau)
        #:else
        call calc_tau_cross(mui, w(idx-io_v:idx+io_v+1), vz(idx-io_v:idx+io_v+1), real(dy(j), kd_visc), tau, utau)
        #:endif
        call __stcg(F(i-1,j,k-1,4), __ldlu(F(i-1,j,k-1,4)) - tau)
        utau_sum = utau_sum + utau
      end block
      block
        real(kd_arr)  :: f5v  ! value loaded from the kd_arr flux array
        real(kd_visc) :: Ty, kTy
        #:if VISC_ORDER == 4
        Ty  = diff${VISC_ORDER}$_s(real(dy(j), kd_visc), real(T(i,j,k), kd_visc)-real(T(i,j+1,k), kd_visc), real(T(i,j-1,k), kd_visc)-real(T(i,j+2,k), kd_visc))
        #:else
        Ty  = diff${VISC_ORDER}$_s(real(dy(j), kd_visc), -real(T(i,j-2,k), kd_visc)+real(T(i,j+3,k), kd_visc), real(T(i,j-1,k), kd_visc)-real(T(i,j+2,k), kd_visc), -real(T(i,j,k), kd_visc)+real(T(i,j+1,k), kd_visc))
        #:endif
        kTy = Cp_over_Pr * mui * Ty
        #:if is_les
        Hsgs = -muti * diff${VISC_ORDER}$_s(real(dy(j), kd_visc), &
        #:if VISC_ORDER == 4
        H(2)-H(3), H(1)-H(4) &
        #:else
        -H(1)+H(6), H(2)-H(5), -H(3)+H(4) &
        #:endif
        ) / Prt
        #:endif
        f5v = __ldlu(F(i-1,j,k-1,5))
        call __stcg(F(i-1,j,k-1,5), f5v - (utau_sum + kTy &
    #:if is_les
      + Hsgs &
    #:endif
      ))
      end block
    endif
  end subroutine calc_Fv${VISC_ORDER}$${suf}$
#:endfor


#:for is_koff in [False, True]
  #:set suf = base_suf
  #:if is_koff
    #:set suf = suf + "_koff"
  #:endif
  attributes(global) subroutine calc_Gv${VISC_ORDER}$${suf}$(nx, ny, nz, dx, dy, dz, Q_2, Q_3, Q_4, T, mu, &
    #:if is_les
      mut, qc2, &
    #:endif
    ux, vy, &
    #:if is_koff
      k_lo, k_hi, &
    #:endif
    G)
    integer, intent(in), value                 :: nx
    integer, intent(in), value                 :: ny
    integer, intent(in), value                 :: nz
    real(kd_arr), intent(in), device, contiguous    :: dx(nx-1)
    real(kd_arr), intent(in), device, contiguous    :: dy(ny-1)
    real(kd_arr), intent(in), device, contiguous    :: dz(nz-1)
    real(kd_arr), intent(in), device, contiguous    :: Q_2(nx,ny,nz)
    real(kd_arr), intent(in), device, contiguous    :: Q_3(nx,ny,nz)
    real(kd_arr), intent(in), device, contiguous    :: Q_4(nx,ny,nz)
    real(kd_arr), intent(in), device, contiguous    :: T(nx,ny,nz)
    real(kd_arr), intent(in), device, contiguous    :: mu(nx,ny,nz)
    #:if is_les
    real(kd_arr), intent(in), device, contiguous    :: mut(nx,ny,nz)
    real(kd_arr), intent(in), device, contiguous    :: qc2(nx,ny,nz)
    #:endif
    real(kd_arr), intent(in), device, contiguous    :: ux(nx,ny,nz) !< du/dx at cell-center, precomputed by calc_div
    real(kd_arr), intent(in), device, contiguous    :: vy(nx,ny,nz) !< dv/dy at cell-center, precomputed by calc_div
    real(kd_arr), intent(inout), device, contiguous :: G(nx-2,ny-2,nz-1,5)
    #:if is_koff
    integer, intent(in), value                 :: k_lo
    integer, intent(in), value                 :: k_hi
    #:endif
    #:if VISC_ORDER == 4
    integer, parameter :: io_v = 1
    #:else
    integer, parameter :: io_v = 2
    #:endif
    integer, parameter :: sx = threadsGv%x
    integer, parameter :: sy = threadsGv%y
    integer, parameter :: sz = threadsGv%z + 2*io_v + 1
    real(kd_visc), dimension(-(io_v-1):sx*sy*sz-io_v), shared ::  u
    real(kd_visc), dimension(-(io_v-1):sx*sy*sz-io_v), shared ::  v
    real(kd_visc), dimension(-(io_v-1):sx*sy*sz-io_v), shared ::  w
    real(kd_visc), dimension(-(io_v-1):sx*sy*sz-io_v), shared :: wx
    real(kd_visc), dimension(-(io_v-1):sx*sy*sz-io_v), shared :: wy
    integer i, j, k, it, jt, kt, idx
    logical :: valid, interior
    real(kd_visc) :: utau_sum, mui
    #:if is_les
    real(kd_visc) :: Hsgs, muti
    real(kd_visc) :: H(2*io_v+2)
    #:endif
    interior = .false.
    it = threadIdx%x
    jt = threadIdx%y
    kt = threadIdx%z
    i  = (blockIdx%x-1)*blockDim%x + it + 1
    j  = (blockIdx%y-1)*blockDim%y + jt + 1
    #:if is_koff
    call load_smem_visc_cent${VISC_ORDER}$_z_koff(it, jt, kt, i, j, nx, ny, nz, real(dx(i), kd_visc), real(dy(j), kd_visc), Q_2, Q_3, Q_4, u, v, w, wx, wy, k_lo)
    k  = (blockIdx%z-1)*blockDim%z + k_lo - 1 + kt
    valid = .not. (nx-1 < i .or. ny-1 < j .or. k_hi < k)
    #:else
    call load_smem_visc_cent${VISC_ORDER}$_z(it, jt, kt, i, j, nx, ny, nz, real(dx(i), kd_visc), real(dy(j), kd_visc), Q_2, Q_3, Q_4, u, v, w, wx, wy)
    k  = (blockIdx%z-1)*blockDim%z + kt
    valid = .not. (nx-1 < i .or. ny-1 < j .or. nz-1 < k)
    #:endif
    idx = kt + (jt-1)*sz + (it-1)*sz*sy
    if (valid) then
      interior = (io_v+2 <= i .and. i <= nx-io_v-1 .and. io_v+2 <= j .and. j <= ny-io_v-1 .and. io_v+1 <= k .and. k <= nz-io_v-1)
    endif

    if (valid .and. interior) then
      #:if VISC_ORDER == 4
      mui = interp${VISC_ORDER}$_s(real(mu(i,j,k), kd_visc)+real(mu(i,j,k+1), kd_visc), real(mu(i,j,k-1), kd_visc)+real(mu(i,j,k+2), kd_visc))
      #:if is_les
      muti = interp${VISC_ORDER}$_s(real(mut(i,j,k), kd_visc)+real(mut(i,j,k+1), kd_visc), real(mut(i,j,k-1), kd_visc)+real(mut(i,j,k+2), kd_visc))
      H(1) = Cp*real(T(i,j,k-1), kd_visc) + 0.5_kd_visc*w(idx-1)**2 + real(qc2(i,j,k-1), kd_visc)
      H(2) = Cp*real(T(i,j,k  ), kd_visc) + 0.5_kd_visc*w(idx  )**2 + real(qc2(i,j,k  ), kd_visc)
      H(3) = Cp*real(T(i,j,k+1), kd_visc) + 0.5_kd_visc*w(idx+1)**2 + real(qc2(i,j,k+1), kd_visc)
      H(4) = Cp*real(T(i,j,k+2), kd_visc) + 0.5_kd_visc*w(idx+2)**2 + real(qc2(i,j,k+2), kd_visc)
      #:endif
      #:else
      mui = interp${VISC_ORDER}$_s(real(mu(i,j,k-2), kd_visc)+real(mu(i,j,k+3), kd_visc), real(mu(i,j,k-1), kd_visc)+real(mu(i,j,k+2), kd_visc), real(mu(i,j,k), kd_visc)+real(mu(i,j,k+1), kd_visc))
      #:if is_les
      muti = interp${VISC_ORDER}$_s(real(mut(i,j,k-2), kd_visc)+real(mut(i,j,k+3), kd_visc), real(mut(i,j,k-1), kd_visc)+real(mut(i,j,k+2), kd_visc), real(mut(i,j,k), kd_visc)+real(mut(i,j,k+1), kd_visc))
      H(1) = Cp*real(T(i,j,k-2), kd_visc) + 0.5_kd_visc*w(idx-2)**2 + real(qc2(i,j,k-2), kd_visc)
      H(2) = Cp*real(T(i,j,k-1), kd_visc) + 0.5_kd_visc*w(idx-1)**2 + real(qc2(i,j,k-1), kd_visc)
      H(3) = Cp*real(T(i,j,k  ), kd_visc) + 0.5_kd_visc*w(idx  )**2 + real(qc2(i,j,k  ), kd_visc)
      H(4) = Cp*real(T(i,j,k+1), kd_visc) + 0.5_kd_visc*w(idx+1)**2 + real(qc2(i,j,k+1), kd_visc)
      H(5) = Cp*real(T(i,j,k+2), kd_visc) + 0.5_kd_visc*w(idx+2)**2 + real(qc2(i,j,k+2), kd_visc)
      H(6) = Cp*real(T(i,j,k+3), kd_visc) + 0.5_kd_visc*w(idx+3)**2 + real(qc2(i,j,k+3), kd_visc)
      #:endif
      #:endif
      #:if is_les
      H(:) = H(:) + 0.5_kd_visc*u(idx-io_v:idx+io_v+1)**2 + 0.5_kd_visc*v(idx-io_v:idx+io_v+1)**2
      #:endif
      block
        real(kd_visc) :: tau, utau
        #:if VISC_ORDER == 4
        #:if is_les
        call calc_tau_straight_LES_s(mui, muti, w(idx-io_v:idx+io_v+1), &
             real(ux(i,j,k), kd_visc)+real(ux(i,j,k+1), kd_visc), real(vy(i,j,k), kd_visc)+real(vy(i,j,k+1), kd_visc), &
             real(ux(i,j,k-1), kd_visc)+real(ux(i,j,k+2), kd_visc), real(vy(i,j,k-1), kd_visc)+real(vy(i,j,k+2), kd_visc), &
             real(dz(k), kd_visc), tau, utau)
        #:else
        call calc_tau_straight_s(mui, w(idx-io_v:idx+io_v+1), &
             real(ux(i,j,k), kd_visc)+real(ux(i,j,k+1), kd_visc), real(vy(i,j,k), kd_visc)+real(vy(i,j,k+1), kd_visc), &
             real(ux(i,j,k-1), kd_visc)+real(ux(i,j,k+2), kd_visc), real(vy(i,j,k-1), kd_visc)+real(vy(i,j,k+2), kd_visc), &
             real(dz(k), kd_visc), tau, utau)
        #:endif
        #:else
        #:if is_les
        call calc_tau_straight_LES_s(mui, muti, w(idx-io_v:idx+io_v+1), &
             real(ux(i,j,k-2), kd_visc)+real(ux(i,j,k+3), kd_visc), real(vy(i,j,k-2), kd_visc)+real(vy(i,j,k+3), kd_visc), &
             real(ux(i,j,k-1), kd_visc)+real(ux(i,j,k+2), kd_visc), real(vy(i,j,k-1), kd_visc)+real(vy(i,j,k+2), kd_visc), &
             real(ux(i,j,k  ), kd_visc)+real(ux(i,j,k+1), kd_visc), real(vy(i,j,k  ), kd_visc)+real(vy(i,j,k+1), kd_visc), &
             real(dz(k), kd_visc), tau, utau)
        #:else
        call calc_tau_straight_s(mui, w(idx-io_v:idx+io_v+1), &
             real(ux(i,j,k-2), kd_visc)+real(ux(i,j,k+3), kd_visc), real(vy(i,j,k-2), kd_visc)+real(vy(i,j,k+3), kd_visc), &
             real(ux(i,j,k-1), kd_visc)+real(ux(i,j,k+2), kd_visc), real(vy(i,j,k-1), kd_visc)+real(vy(i,j,k+2), kd_visc), &
             real(ux(i,j,k  ), kd_visc)+real(ux(i,j,k+1), kd_visc), real(vy(i,j,k  ), kd_visc)+real(vy(i,j,k+1), kd_visc), &
             real(dz(k), kd_visc), tau, utau)
        #:endif
        #:endif
        call __stcg(G(i-1,j-1,k,4), __ldlu(G(i-1,j-1,k,4)) - tau)
        utau_sum = utau
      end block
      block
        real(kd_visc) :: tau, utau
        #:if is_les
        call calc_tau_cross_LES(mui, muti, u(idx-io_v:idx+io_v+1), wx(idx-io_v:idx+io_v+1), real(dz(k), kd_visc), tau, utau)
        #:else
        call calc_tau_cross(mui, u(idx-io_v:idx+io_v+1), wx(idx-io_v:idx+io_v+1), real(dz(k), kd_visc), tau, utau)
        #:endif
        call __stcg(G(i-1,j-1,k,2), __ldlu(G(i-1,j-1,k,2)) - tau)
        utau_sum = utau_sum + utau
      end block
      block
        real(kd_visc) :: tau, utau
        #:if is_les
        call calc_tau_cross_LES(mui, muti, v(idx-io_v:idx+io_v+1), wy(idx-io_v:idx+io_v+1), real(dz(k), kd_visc), tau, utau)
        #:else
        call calc_tau_cross(mui, v(idx-io_v:idx+io_v+1), wy(idx-io_v:idx+io_v+1), real(dz(k), kd_visc), tau, utau)
        #:endif
        call __stcg(G(i-1,j-1,k,3), __ldlu(G(i-1,j-1,k,3)) - tau)
        utau_sum = utau_sum + utau
      end block
      block
        real(kd_arr)  :: g5v  ! value loaded from the kd_arr flux array
        real(kd_visc) :: Tz, kTz
        #:if VISC_ORDER == 4
        Tz  = diff${VISC_ORDER}$_s(real(dz(k), kd_visc), real(T(i,j,k), kd_visc)-real(T(i,j,k+1), kd_visc), real(T(i,j,k-1), kd_visc)-real(T(i,j,k+2), kd_visc))
        #:else
        Tz  = diff${VISC_ORDER}$_s(real(dz(k), kd_visc), -real(T(i,j,k-2), kd_visc)+real(T(i,j,k+3), kd_visc), real(T(i,j,k-1), kd_visc)-real(T(i,j,k+2), kd_visc), -real(T(i,j,k), kd_visc)+real(T(i,j,k+1), kd_visc))
        #:endif
        kTz = Cp_over_Pr * mui * Tz
        #:if is_les
        Hsgs = -muti * diff${VISC_ORDER}$_s(real(dz(k), kd_visc), &
        #:if VISC_ORDER == 4
        H(2)-H(3), H(1)-H(4) &
        #:else
        -H(1)+H(6), H(2)-H(5), -H(3)+H(4) &
        #:endif
        ) / Prt
        #:endif
        g5v = __ldlu(G(i-1,j-1,k,5))
        call __stcg(G(i-1,j-1,k,5), g5v - (utau_sum + kTz &
    #:if is_les
      + Hsgs &
    #:endif
      ))
      end block
    endif
  end subroutine calc_Gv${VISC_ORDER}$${suf}$
#:endfor
end module calc_visc_high_internal
#:endif
