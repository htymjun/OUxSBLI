#:include 'config.fypp'
#:if not defined('VISC_ORDER')
  #:set VISC_ORDER = ORDER
#:endif
#! ---------------------------------------------------------------------------
#! z-halo geometry used by the COMMZ paths (calc_EFG / calc_EFG_halo below).
#! OV convective and OVV viscous ghost planes sit on each z end of the local
#! slab, so the interior planes are [OV+1, nz-OV]. A quantity may be computed
#! BEFORE finish_exchange_z has refreshed the ghost planes only if every plane
#! its stencil touches is interior:
#!   E/F convective at plane k : planes k-1..k+1 (Ducros sensor)  -> [OV+2, nz-OV-1]
#!   G   convective at face  k : planes k-io..k+io+1 and sensor    -> [GLO, nz-GHI]
#!   E/F viscous    at plane k : planes k-OVV..k+OVV (uz/vz, wz)   -> [OV+1+OVV, nz-OV-OVV]
#!   G   viscous    at face  k : planes k-OVV+1..k+OVV             -> [OV+OVV, nz-OV-OVV]
#!   wz             at plane k : planes k-OVV..k+OVV               -> [OV+1+OVV, nz-OV-OVV]
#!   ux, vy, primitives, mu, T : plane k only                      -> [OV+1, nz-OV]
#! Everything else runs in calc_EFG_halo after the exchange, in the order
#! primitives -> sensor -> calc_div -> convective -> viscous, so a viscous
#! increment is never clobbered by a later convective assignment. The high-z
#! range of every pair starts no lower than the low-z range ends, so a thin
#! slab never double-counts a plane. With one compute rank the exchange is a
#! self-copy and the result is bit-identical to the non-COMMZ path.
#! ---------------------------------------------------------------------------
#:set OV  = ORDER // 2
#:set OVV = VISC_ORDER // 2
#:set GLO = OV + 1 + max(OV - 1, 1)
#:set GHI = OV + max(OV, 2)
#:if COMMZ and VISC in ('NS', 'LES') and VISC_ORDER == 2
  $:error('COMMZ with VISC_ORDER=2 is not implemented (calc_visc2 has no k-range kernels)')
#:endif
#! ---------------------------------------------------------------------------
#! KEEP_TVD: give the KEEP central flux a MUSCL-limited Rusanov dissipation
#! term, so `TVD` reaches KEEP instead of being silently ignored. Default off,
#! so every existing case generates byte-identical code. See
#! calc_keep_tvd.f90.fypp.
#! ---------------------------------------------------------------------------
#:if not defined('KEEP_TVD')
  #:set KEEP_TVD = False
#:endif
#:if KEEP_TVD and SCHEME != 'KEEP'
  #:stop 'KEEP_TVD only applies to SCHEME=KEEP (SLAU/Roe/Hybrid already read id_tvd)'
#:endif
#:if KEEP_TVD and TVD == 'hybrid'
  #:stop "KEEP_TVD with TVD='hybrid' is not implemented: the threshold limiter needs the Ducros sensor, which is not passed to the KEEP kernels. Use TVD='tvd', or SCHEME='Hybrid' which already switches KEEP<->SLAU on that sensor."
#:endif
module calc_flux_base
  use mod_globals, only : sp, &
  & blocks, threads, blocksE, blocksF, blocksG, threadsE, threadsF, threadsG, &
  & blocksEv, blocksFv, blocksGv, threadsEv, threadsFv, threadsGv
  use calc_physical_quantities
  use calc_hybrid
  use calc_keep_kernel
  use calc_keep_kernel_internal
  use calc_slau_kernel
  use calc_slau_kernel_internal
  use calc_hybrid_kernel
  use calc_hybrid_kernel_internal
  #:if VISC in ('NS', 'LES')
  use calc_visc2
  use calc_visc_high
  use calc_visc_high_internal
  #:endif
  #:set fused_conv_visc = (SCHEME in ('KEEP', 'SLAU') and VISC == 'NS' and ORDER == 6 and VISC_ORDER == 6 and not BC_X and not BC_Y and not BC_Z and not COMMZ and not KEEP_TVD)
  #:if fused_conv_visc and SCHEME == 'KEEP'
  use calc_keep_visc_kernel_internal
  #:elif fused_conv_visc and SCHEME == 'SLAU'
  use calc_slau_visc_kernel_internal
  #:endif
  #:if VISC in ('NS', 'LES') and VISC_ORDER > 2
  use calc_div, only : calc_div_ux_${VISC_ORDER}$_in, calc_div_vy_${VISC_ORDER}$_in, calc_div_wz_${VISC_ORDER}$_in
  #:endif
  #:if VISC == 'LES'
  use calc_les
  #:endif
  use set
  implicit none
  private
  public calc_EFG, init_sensor
  #:if COMMZ
  public calc_EFG_halo
  #:endif
  integer, parameter :: io_fb      = ${ORDER_IO}$
  integer, parameter :: overlap_fb = ${OV}$   ! convective z ghost planes per side
  integer, parameter :: overlap_v  = ${OVV}$  ! viscous z ghost planes per side
  real(sp), allocatable, device, save :: sensor(:,:,:)
  ! set fypp
  #:set scheme_name = SCHEME.lower()
  #:set args_t = ", T" if SCHEME in ('KEEP', 'Hybrid') else ""
  #:set args_sensor = ", sensor" if SCHEME in ('SLAU', 'Hybrid') else ""
contains
  subroutine init_sensor(nx, ny, nz)
    integer, intent(in) :: nx, ny, nz
    allocate(sensor(nx,ny,nz))
  end subroutine init_sensor


  subroutine calc_conv(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q_1, Q_2, Q_3, Q_4, Q_5, T, E, F, G)
    integer, intent(in), value               :: nx, ny, nz
    real(8), intent(in), device, contiguous  :: inv_dx(nx-1), inv_dy(ny-1), inv_dz(nz-1)
    real(8), intent(in), device, contiguous  :: Q_1(nx,ny,nz), Q_2(nx,ny,nz), Q_3(nx,ny,nz)
    real(8), intent(in), device, contiguous  :: Q_4(nx,ny,nz), Q_5(nx,ny,nz), T(nx,ny,nz)
    real(8), intent(out), device, contiguous :: E(nx-1,ny-2,nz-2,5)
    real(8), intent(out), device, contiguous :: F(nx-2,ny-1,nz-2,5)
    real(8), intent(out), device, contiguous :: G(nx-2,ny-2,nz-1,5)
    ! shock sensor
    #:if SCHEME in ('SLAU', 'Hybrid')
    call calc_Ducros<<<blocks,threads>>>(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q_2, Q_3, Q_4, sensor)
    #:endif
    ! flux
    call calc_${scheme_name}$_x${'' if BC_X else '_in'}$<<<blocksE,threadsE>>>(nx, ny, nz, Q_1, Q_2, Q_3, Q_4, Q_5${args_t}$${args_sensor}$, E)
    call calc_${scheme_name}$_y${'' if BC_Y else '_in'}$<<<blocksF,threadsF>>>(nx, ny, nz, Q_1, Q_2, Q_3, Q_4, Q_5${args_t}$${args_sensor}$, F)
    call calc_${scheme_name}$_z${'' if BC_Z else '_in'}$<<<blocksG,threadsG>>>(nx, ny, nz, Q_1, Q_2, Q_3, Q_4, Q_5${args_t}$${args_sensor}$, G)
  end subroutine calc_conv


#:if COMMZ
  !> Number of z blocks needed to cover n planes (or faces) with tz threads each.
  pure function zblocks(n, tz) result(nb)
    integer, intent(in) :: n, tz
    integer :: nb
    nb = (n + tz - 1) / tz
  end function zblocks


  !> Ducros shock sensor over the whole local slab (no-op for KEEP). Called once
  !> before the exchange and once after it, because the k+-1 stencil of the
  !> planes next to a ghost plane is only complete after the exchange.
  subroutine calc_sensor(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q_2, Q_3, Q_4)
    integer, intent(in), value              :: nx, ny, nz
    real(8), intent(in), device, contiguous :: inv_dx(nx-1), inv_dy(ny-1), inv_dz(nz-1)
    real(8), intent(in), device, contiguous :: Q_2(nx,ny,nz), Q_3(nx,ny,nz), Q_4(nx,ny,nz)
    #:if SCHEME in ('SLAU', 'Hybrid')
    call calc_Ducros<<<blocks,threads>>>(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q_2, Q_3, Q_4, sensor)
    #:endif
  end subroutine calc_sensor


  !> Convective E and F on the z planes [k_lo, k_hi] only.
  subroutine calc_conv_EF_koff(nx, ny, nz, Q_1, Q_2, Q_3, Q_4, Q_5, T, E, F, k_lo, k_hi)
    integer, intent(in), value                 :: nx, ny, nz, k_lo, k_hi
    real(8), intent(in), device, contiguous    :: Q_1(nx,ny,nz), Q_2(nx,ny,nz), Q_3(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: Q_4(nx,ny,nz), Q_5(nx,ny,nz), T(nx,ny,nz)
    real(8), intent(inout), device, contiguous :: E(nx-1,ny-2,nz-2,5)
    real(8), intent(inout), device, contiguous :: F(nx-2,ny-1,nz-2,5)
    type(dim3) :: bE, bF
    if (k_hi < k_lo) return
    bE = dim3(blocksE%x, blocksE%y, zblocks(k_hi-k_lo+1, threadsE%z))
    bF = dim3(blocksF%x, blocksF%y, zblocks(k_hi-k_lo+1, threadsF%z))
    call calc_${scheme_name}$_x${'' if BC_X else '_in'}$_koff<<<bE,threadsE>>>(nx, ny, nz, Q_1, Q_2, Q_3, Q_4, Q_5${args_t}$${args_sensor}$, E, k_lo, k_hi)
    call calc_${scheme_name}$_y${'' if BC_Y else '_in'}$_koff<<<bF,threadsF>>>(nx, ny, nz, Q_1, Q_2, Q_3, Q_4, Q_5${args_t}$${args_sensor}$, F, k_lo, k_hi)
  end subroutine calc_conv_EF_koff


  !> Convective G on the z faces [k_lo, k_hi] only (interior-stencil kernel;
  !> it skips the faces outside [io+1, nz-io-1] by itself).
  subroutine calc_conv_G_koff(nx, ny, nz, Q_1, Q_2, Q_3, Q_4, Q_5, T, G, k_lo, k_hi)
    integer, intent(in), value                 :: nx, ny, nz, k_lo, k_hi
    real(8), intent(in), device, contiguous    :: Q_1(nx,ny,nz), Q_2(nx,ny,nz), Q_3(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: Q_4(nx,ny,nz), Q_5(nx,ny,nz), T(nx,ny,nz)
    real(8), intent(inout), device, contiguous :: G(nx-2,ny-2,nz-1,5)
    type(dim3) :: bG
    if (k_hi < k_lo) return
    bG = dim3(blocksG%x, blocksG%y, zblocks(k_hi-k_lo+1, threadsG%z))
    call calc_${scheme_name}$_z_in_koff<<<bG,threadsG>>>(nx, ny, nz, Q_1, Q_2, Q_3, Q_4, Q_5${args_t}$${args_sensor}$, G, k_lo, k_hi)
  end subroutine calc_conv_G_koff
#:endif


  subroutine calc_EFG(nx, ny, nz, inv_dx, inv_dy, inv_dz, Jacobian, &
                       QJ_1, QJ_2, QJ_3, QJ_4, QJ_5, Q_1, Q_2, Q_3, Q_4, Q_5, T, mu, mut, qc2, ux, vy, wz, E, F, G)
    integer, intent(in), value                 :: nx, ny, nz
    real(8), intent(in), device, contiguous    :: inv_dx(nx-1), inv_dy(ny-1), inv_dz(nz-1)
    real(8), intent(in), device, contiguous    :: Jacobian(nx,ny)
    real(8), intent(in), device, contiguous    :: QJ_1(nx,ny,nz), QJ_2(nx,ny,nz), QJ_3(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: QJ_4(nx,ny,nz), QJ_5(nx,ny,nz)
    real(8), intent(inout), device, contiguous :: Q_1(nx,ny,nz), Q_2(nx,ny,nz), Q_3(nx,ny,nz)
    real(8), intent(inout), device, contiguous :: Q_4(nx,ny,nz), Q_5(nx,ny,nz), T(nx,ny,nz)
    #:if VISC == 'Euler'
    real(8), intent(inout), device, contiguous :: mu(1,1,1), mut(1,1,1), qc2(1,1,1)
    real(8), intent(inout), device, contiguous :: ux(1,1,1), vy(1,1,1), wz(1,1,1)
    #:elif VISC == 'NS'
    real(8), intent(inout), device, contiguous :: mu(nx,ny,nz)
    real(8), intent(inout), device, contiguous :: mut(1,1,1), qc2(1,1,1)
    real(8), intent(inout), device, contiguous :: ux(nx,ny,nz), vy(nx,ny,nz), wz(nx,ny,nz)
    #:elif VISC == 'LES'
    real(8), intent(inout), device, contiguous :: mu(nx,ny,nz), mut(nx,ny,nz), qc2(nx,ny,nz)
    real(8), intent(inout), device, contiguous :: ux(nx,ny,nz), vy(nx,ny,nz), wz(nx,ny,nz)
    #:endif
    real(8), intent(inout), device, contiguous :: E(nx-1,ny-2,nz-2,5), F(nx-2,ny-1,nz-2,5)
    real(8), intent(inout), device, contiguous :: G(nx-2,ny-2,nz-1,5)
    #:if COMMZ and VISC in ('NS', 'LES')
    integer    :: kv_lo, kv_hi, kg_lo, kg_hi
    type(dim3) :: bEv, bFv, bGv
    #:endif
    ! ===================================================================
    ! main part (Euler)
    ! ===================================================================
  #:if VISC == 'Euler'
    #:if not COMMZ
    call calc_quantities_3D(nx, ny, nz, Jacobian, QJ_1, QJ_2, QJ_3, QJ_4, QJ_5, Q_1, Q_2, Q_3, Q_4, Q_5, T, 1, nz)
    call calc_conv(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q_1, Q_2, Q_3, Q_4, Q_5, T, E, F, G)
    #:else
    ! Interior planes only -- everything whose stencil reaches a z ghost plane
    ! is deferred to calc_EFG_halo (ranges: see the header of this file).
    call calc_quantities_3D(nx, ny, nz, Jacobian, QJ_1, QJ_2, QJ_3, QJ_4, QJ_5, Q_1, Q_2, Q_3, Q_4, Q_5, T, overlap_fb+1, nz-overlap_fb)
    call calc_sensor(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q_2, Q_3, Q_4)
    call calc_conv_EF_koff(nx, ny, nz, Q_1, Q_2, Q_3, Q_4, Q_5, T, E, F, overlap_fb+2, nz-overlap_fb-1)
    call calc_conv_G_koff(nx, ny, nz, Q_1, Q_2, Q_3, Q_4, Q_5, T, G, ${GLO}$, nz-${GHI}$)
    #:endif
  #:else
    ! ===================================================================
    ! NS and LES
    ! ===================================================================
    #:set is_les   = (VISC == 'LES')
    #:set les_args = ', mut, qc2' if is_les else ''
    ! ===================================================================
    ! axis
    ! ===================================================================
    #:set dirs = [ &
      {'dir': 'E', 'is_bc': BC_X, 'grad': 'vy, wz', 'r': 'kv'}, &
      {'dir': 'F', 'is_bc': BC_Y, 'grad': 'ux, wz', 'r': 'kv'}, &
      {'dir': 'G', 'is_bc': BC_Z, 'grad': 'ux, vy', 'r': 'kg'} &
    ]
    #:if is_les
    mut = 0.d0
    qc2 = 0.d0
    #:endif
    #:if not COMMZ
    ! ===================================================================
    ! main part (NS and LES), whole domain
    ! ===================================================================
    call calc_quantities_T_3D(nx, ny, nz, Jacobian, QJ_1, QJ_2, QJ_3, QJ_4, QJ_5, Q_1, Q_2, Q_3, Q_4, Q_5, T, mu, 1, nz)
    #:if VISC_ORDER > 2
    ! ux/vy/wz (cell-center velocity gradients) are precomputed once here and
    ! reused by calc_Ev/Fv/Gv below instead of each direction independently
    ! recomputing the other two -- see calc_div.f90. Split into 3
    ! single-component kernels (each with a directly-bounded loop in its own
    ! margin direction, no branching) rather than one combined kernel, to
    ! keep each kernel's register footprint to just the one component it
    ! computes.
    call calc_div_ux_${VISC_ORDER}$_in(nx, ny, nz, inv_dx, Q_2, ux, 1, nz)
    call calc_div_vy_${VISC_ORDER}$_in(nx, ny, nz, inv_dy, Q_3, vy, 1, nz)
    call calc_div_wz_${VISC_ORDER}$_in(nx, ny, nz, inv_dz, Q_4, wz, ${OVV+1}$, nz-${OVV}$)
    #:endif
      #:if fused_conv_visc and SCHEME == 'KEEP'
      ! Fused convective+viscous: one launch per direction instead of
      ! calc_conv + calc_Ev/Fv/Gv6_in, see calc_keep_visc_kernel.f90.fypp
      call calc_keepv_x_in<<<blocksE,threadsE>>>(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q_1, Q_2, Q_3, Q_4, Q_5, T, mu, vy, wz, E)
      call calc_keepv_y_in<<<blocksF,threadsF>>>(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q_1, Q_2, Q_3, Q_4, Q_5, T, mu, ux, wz, F)
      call calc_keepv_z_in<<<blocksG,threadsG>>>(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q_1, Q_2, Q_3, Q_4, Q_5, T, mu, ux, vy, G)
      #:elif fused_conv_visc and SCHEME == 'SLAU'
      ! Fused convective+viscous: one launch per direction instead of
      ! calc_conv + calc_Ev/Fv/Gv6_in, see calc_slau_visc_kernel.f90.fypp
      call calc_Ducros<<<blocks,threads>>>(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q_2, Q_3, Q_4, sensor)
      call calc_slauv_x_in<<<blocksE,threadsE>>>(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q_1, Q_2, Q_3, Q_4, Q_5, T, mu, sensor, vy, wz, E)
      call calc_slauv_y_in<<<blocksF,threadsF>>>(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q_1, Q_2, Q_3, Q_4, Q_5, T, mu, sensor, ux, wz, F)
      call calc_slauv_z_in<<<blocksG,threadsG>>>(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q_1, Q_2, Q_3, Q_4, Q_5, T, mu, sensor, ux, vy, G)
      #:else
      call calc_conv(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q_1, Q_2, Q_3, Q_4, Q_5, T, E, F, G)
      #:if is_les
      call calc_mut<<<blocks,threads>>>(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q_1, Q_2, Q_3, Q_4, mut, qc2)
      call set_bc_mut(nx, ny, nz, mut, qc2)
      #:endif

      #:for d in dirs
      #:set in_sfx = '_in' if (not d['is_bc'] and ORDER == 6) else ''
      #:set grad_args = ', ' + d['grad'] if VISC_ORDER > 2 else ''
      call calc_${d['dir']}$v${VISC_ORDER}$${in_sfx}$<<<blocks${d['dir']}$v,threads${d['dir']}$v>>>&
           &(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q_2, Q_3, Q_4, T, mu${les_args}$${grad_args}$, ${d['dir']}$)
      #:endfor
      #:endif
    #:else
    ! ===================================================================
    ! main part (NS and LES), COMMZ: only the stencil-safe interior before
    ! the exchange (ranges: see the header of this file)
    ! ===================================================================
    call calc_quantities_T_3D(nx, ny, nz, Jacobian, QJ_1, QJ_2, QJ_3, QJ_4, QJ_5, Q_1, Q_2, Q_3, Q_4, Q_5, T, mu, overlap_fb+1, nz-overlap_fb)
    #:if VISC_ORDER > 2
    call calc_div_ux_${VISC_ORDER}$_in(nx, ny, nz, inv_dx, Q_2, ux, overlap_fb+1, nz-overlap_fb)
    call calc_div_vy_${VISC_ORDER}$_in(nx, ny, nz, inv_dy, Q_3, vy, overlap_fb+1, nz-overlap_fb)
    call calc_div_wz_${VISC_ORDER}$_in(nx, ny, nz, inv_dz, Q_4, wz, overlap_fb+1+overlap_v, nz-overlap_fb-overlap_v)
    #:endif
    call calc_sensor(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q_2, Q_3, Q_4)
    call calc_conv_EF_koff(nx, ny, nz, Q_1, Q_2, Q_3, Q_4, Q_5, T, E, F, overlap_fb+2, nz-overlap_fb-1)
    call calc_conv_G_koff(nx, ny, nz, Q_1, Q_2, Q_3, Q_4, Q_5, T, G, ${GLO}$, nz-${GHI}$)
    #:if is_les
    ! LES+COMMZ has never been exercised: calc_mut still sweeps the whole slab
    ! before the exchange, so mut/qc2 next to the ghost planes see stale data.
    call calc_mut<<<blocks,threads>>>(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q_1, Q_2, Q_3, Q_4, mut, qc2)
    call set_bc_mut(nx, ny, nz, mut, qc2)
    #:endif
    kv_lo = overlap_fb + 1 + overlap_v;  kv_hi = nz - overlap_fb - overlap_v   ! E/F planes
    kg_lo = overlap_fb + overlap_v;      kg_hi = nz - overlap_fb - overlap_v   ! G faces
    #:for d in dirs
    #:set in_sfx = '_in' if (not d['is_bc'] and ORDER == 6) else ''
    #:set grad_args = ', ' + d['grad'] if VISC_ORDER > 2 else ''
    #:set r = d['r']
    if (${r}$_hi >= ${r}$_lo) then
      b${d['dir']}$v = dim3(blocks${d['dir']}$v%x, blocks${d['dir']}$v%y, zblocks(${r}$_hi-${r}$_lo+1, threads${d['dir']}$v%z))
      call calc_${d['dir']}$v${VISC_ORDER}$${in_sfx}$_koff<<<b${d['dir']}$v,threads${d['dir']}$v>>>&
           &(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q_2, Q_3, Q_4, T, mu${les_args}$${grad_args}$, ${r}$_lo, ${r}$_hi, ${d['dir']}$)
    endif
    #:endfor
    #:endif
  #:endif
  end subroutine calc_EFG


#:if COMMZ
  !> Everything that needs the freshly exchanged z ghost planes, in the order
  !> primitives -> sensor -> calc_div -> convective (assignment) -> viscous
  !> (increment). Ranges are the complements of those used in calc_EFG.
  subroutine calc_EFG_halo(nx, ny, nz, inv_dx, inv_dy, inv_dz, &
                             Jacobian, QJ_1, QJ_2, QJ_3, QJ_4, QJ_5, Q_1, Q_2, Q_3, Q_4, Q_5, T, mu, mut, qc2, ux, vy, wz, E, F, G)
    integer, intent(in), value                 :: nx, ny, nz
    real(8), intent(in), device, contiguous    :: inv_dx(nx-1), inv_dy(ny-1), inv_dz(nz-1)
    real(8), intent(in), device, contiguous    :: Jacobian(nx,ny)
    real(8), intent(in), device, contiguous    :: QJ_1(nx,ny,nz), QJ_2(nx,ny,nz), QJ_3(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: QJ_4(nx,ny,nz), QJ_5(nx,ny,nz)
    real(8), intent(inout), device, contiguous :: Q_1(nx,ny,nz), Q_2(nx,ny,nz), Q_3(nx,ny,nz)
    real(8), intent(inout), device, contiguous :: Q_4(nx,ny,nz), Q_5(nx,ny,nz), T(nx,ny,nz)
    #:if VISC == 'Euler'
    real(8), intent(inout), device, contiguous :: mu(1,1,1), mut(1,1,1), qc2(1,1,1)
    real(8), intent(inout), device, contiguous :: ux(1,1,1), vy(1,1,1), wz(1,1,1)
    #:elif VISC == 'NS'
    real(8), intent(inout), device, contiguous :: mu(nx,ny,nz)
    real(8), intent(inout), device, contiguous :: mut(1,1,1), qc2(1,1,1)
    real(8), intent(inout), device, contiguous :: ux(nx,ny,nz), vy(nx,ny,nz), wz(nx,ny,nz)
    #:elif VISC == 'LES'
    real(8), intent(inout), device, contiguous :: mu(nx,ny,nz), mut(nx,ny,nz), qc2(nx,ny,nz)
    real(8), intent(inout), device, contiguous :: ux(nx,ny,nz), vy(nx,ny,nz), wz(nx,ny,nz)
    #:endif
    real(8), intent(inout), device, contiguous :: E(nx-1,ny-2,nz-2,5)
    real(8), intent(inout), device, contiguous :: F(nx-2,ny-1,nz-2,5)
    real(8), intent(inout), device, contiguous :: G(nx-2,ny-2,nz-1,5)
    ! low-z range of each pair is [first, *_hi1], high-z range is [*_lo2, last]
    integer :: kef_hi1, kef_lo2   ! convective E/F planes
    integer :: kg_hi1,  kg_lo2    ! convective G faces
    #:if VISC in ('NS', 'LES')
    integer :: kw_lo1, kw_hi1, kw_lo2, kw_hi2   ! wz planes
    integer :: kv_hi1,  kv_lo2    ! viscous E/F planes
    integer :: kgv_hi1, kgv_lo2   ! viscous G faces
    type(dim3) :: bEv, bFv, bGv
    #:endif
    kef_hi1 = overlap_fb + 1
    kef_lo2 = max(nz - overlap_fb, kef_hi1 + 1)
    kg_hi1  = ${GLO}$ - 1
    kg_lo2  = max(nz - ${GHI}$ + 1, kg_hi1 + 1)
    ! 1. primitives on the ghost planes
  #:if VISC == 'Euler'
    call calc_quantities_3D(nx, ny, nz, Jacobian, QJ_1, QJ_2, QJ_3, QJ_4, QJ_5, Q_1, Q_2, Q_3, Q_4, Q_5, T, 1, overlap_fb)
    call calc_quantities_3D(nx, ny, nz, Jacobian, QJ_1, QJ_2, QJ_3, QJ_4, QJ_5, Q_1, Q_2, Q_3, Q_4, Q_5, T, nz-overlap_fb+1, nz)
  #:else
    call calc_quantities_T_3D(nx, ny, nz, Jacobian, QJ_1, QJ_2, QJ_3, QJ_4, QJ_5, Q_1, Q_2, Q_3, Q_4, Q_5, T, mu, 1, overlap_fb)
    call calc_quantities_T_3D(nx, ny, nz, Jacobian, QJ_1, QJ_2, QJ_3, QJ_4, QJ_5, Q_1, Q_2, Q_3, Q_4, Q_5, T, mu, nz-overlap_fb+1, nz)
  #:endif
    ! 2. sensor (planes next to the ghosts were stale before the exchange)
    call calc_sensor(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q_2, Q_3, Q_4)
  #:if VISC in ('NS', 'LES') and VISC_ORDER > 2
    ! 3. cell-centre gradients that read ghost planes
    kw_lo1 = overlap_fb + 1
    kw_hi1 = overlap_fb + overlap_v
    kw_lo2 = max(nz - overlap_fb - overlap_v + 1, kw_hi1 + 1)
    kw_hi2 = nz - overlap_fb
    call calc_div_ux_${VISC_ORDER}$_in(nx, ny, nz, inv_dx, Q_2, ux, 1, overlap_fb)
    call calc_div_ux_${VISC_ORDER}$_in(nx, ny, nz, inv_dx, Q_2, ux, nz-overlap_fb+1, nz)
    call calc_div_vy_${VISC_ORDER}$_in(nx, ny, nz, inv_dy, Q_3, vy, 1, overlap_fb)
    call calc_div_vy_${VISC_ORDER}$_in(nx, ny, nz, inv_dy, Q_3, vy, nz-overlap_fb+1, nz)
    call calc_div_wz_${VISC_ORDER}$_in(nx, ny, nz, inv_dz, Q_4, wz, kw_lo1, kw_hi1)
    call calc_div_wz_${VISC_ORDER}$_in(nx, ny, nz, inv_dz, Q_4, wz, kw_lo2, kw_hi2)
  #:endif
    ! 4. convective fluxes next to the ghost planes (assignment -> before viscous)
    call calc_conv_EF_koff(nx, ny, nz, Q_1, Q_2, Q_3, Q_4, Q_5, T, E, F, 2, kef_hi1)
    call calc_conv_EF_koff(nx, ny, nz, Q_1, Q_2, Q_3, Q_4, Q_5, T, E, F, kef_lo2, nz-1)
    call calc_conv_G_koff(nx, ny, nz, Q_1, Q_2, Q_3, Q_4, Q_5, T, G, 1, kg_hi1)
    call calc_conv_G_koff(nx, ny, nz, Q_1, Q_2, Q_3, Q_4, Q_5, T, G, kg_lo2, nz-1)
  #:if VISC in ('NS', 'LES')
    #:set is_les   = (VISC == 'LES')
    #:set les_args = ', mut, qc2' if is_les else ''
    #:set dirs = [ &
      {'dir': 'E', 'is_bc': BC_X, 'grad': 'vy, wz', 'lo1': '2', 'hi1': 'kv_hi1',  'lo2': 'kv_lo2',  'hi2': 'nz-1'}, &
      {'dir': 'F', 'is_bc': BC_Y, 'grad': 'ux, wz', 'lo1': '2', 'hi1': 'kv_hi1',  'lo2': 'kv_lo2',  'hi2': 'nz-1'}, &
      {'dir': 'G', 'is_bc': BC_Z, 'grad': 'ux, vy', 'lo1': '1', 'hi1': 'kgv_hi1', 'lo2': 'kgv_lo2', 'hi2': 'nz-1'} &
    ]
    ! 5. viscous fluxes next to the ghost planes (increment)
    kv_hi1  = overlap_fb + overlap_v
    kv_lo2  = max(nz - overlap_fb - overlap_v + 1, kv_hi1 + 1)
    kgv_hi1 = overlap_fb + overlap_v - 1
    kgv_lo2 = max(nz - overlap_fb - overlap_v + 1, kgv_hi1 + 1)
    #:for d in dirs
    #:set in_sfx = '_in' if (not d['is_bc'] and ORDER == 6) else ''
    #:set grad_args = ', ' + d['grad'] if VISC_ORDER > 2 else ''
    #:for lo, hi in [(d['lo1'], d['hi1']), (d['lo2'], d['hi2'])]
    if (${hi}$ >= ${lo}$) then
      b${d['dir']}$v = dim3(blocks${d['dir']}$v%x, blocks${d['dir']}$v%y, zblocks(${hi}$-(${lo}$)+1, threads${d['dir']}$v%z))
      call calc_${d['dir']}$v${VISC_ORDER}$${in_sfx}$_koff<<<b${d['dir']}$v,threads${d['dir']}$v>>>&
           &(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q_2, Q_3, Q_4, T, mu${les_args}$${grad_args}$, ${lo}$, ${hi}$, ${d['dir']}$)
    endif
    #:endfor
    #:endfor
  #:endif
  end subroutine calc_EFG_halo
#:endif
end module calc_flux_base
