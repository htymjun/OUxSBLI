! Mixed-precision (FP64 convection / FP32 viscous) flux dispatcher for NSTGV
! (VISC='NS', SCHEME='SLAU', ORDER=6, COMMZ=False -- no Euler/LES/COMMZ/halo
! branches are needed, unlike the general 3D_solver/src/calc_flux_base.f90.fypp
! this is forked from). calc_EFG picks between two bodies based on the
! case's config.fypp OVERLAP_GC flag:
!   OVERLAP_GC = False -> calc_conv_visc_seq: single default stream,
!     sequential -- convective (real8, unchanged baseline SLAU kernels) then
!     viscous (real4-internal, calc_visc_high_internal_mp), same ordering as
!     the plain (non-fltflt) baseline solver.
!   OVERLAP_GC = True  -> calc_conv_visc_paired_mixed: mirrors
!     3D_solver_fltflt/src/calc_flux_base_ff.f90.fypp's calc_conv_visc_paired
!     staggered 3-phase Green-Context overlap, with the precision assignment
!     inverted (real8 conv on stream_conv, real4-internal visc on stream_visc
!     -- see mod_streams_mixed.f90/green_ctx_bindings_mixed.f90).
!
! Perfect-SoA / mixed-precision layout: Q is fully split into Q_1..Q_5 (full
! split, technique A). E/F/G keep the shared baseline's trailing-5 layout
! (technique B) as allocated by 3D_solver/src/preprocess.f90.fypp. mu is
! real(4) (MIXED_FORK-gated in preprocess.f90.fypp); T stays real(8) (still
! needed as an intent(inout) output of calc_quantities_T_3D_mixed) but is no
! longer threaded into the viscous kernels -- those consume the persistent
! real(4) mirror T_r4 (calc_physical_quantities_mixed) directly instead,
! together with u_r4/v_r4/w_r4 and the new real(4) grid-metric mirrors
! inv_dx_r4/inv_dy_r4/inv_dz_r4, eliminating the redundant per-thread
! real(8)->real(4) casts calc_visc_high_internal_mp.f90.fypp /
! load_smem_visc_cent_mp.f90.fypp used to perform on Q/T/mu themselves.
#:include 'config.fypp'
#:if not defined('OVERLAP_MODE')
  #:set OVERLAP_MODE = 'gc' if OVERLAP_GC else 'none'
#:endif
module calc_flux_base
  #:if OVERLAP_GC
  use cudafor
  use nvtx
  #:endif
  use mod_globals, only : sp, &
  & blocks, threads, blocksE, blocksF, blocksG, threadsE, threadsF, threadsG, &
  & blocksEv, blocksFv, blocksGv, threadsEv, threadsFv, threadsGv
  use calc_physical_quantities_mixed, only : calc_quantities_T_3D_mixed, u_r4, v_r4, w_r4, T_r4
  use calc_hybrid
  use calc_slau_kernel_internal
  use calc_visc_high_internal_mp
  use calc_div_mp
  #:if OVERLAP_MODE == 'gc'
  use calc_slau_kernel_internal_acc, only : calc_slau_y_in_acc, calc_slau_z_in_acc
  use mod_streams_mixed, only : stream_conv, stream_visc, event_E, event_Fv, event_Gv
  #:elif OVERLAP_MODE == 'streams'
  use mod_streams_mixed, only : stream_dir
  #:elif OVERLAP_MODE == 'zslab'
  use calc_slau_kernel_internal_acc, only : calc_slau_y_in_acc_koff
  use mod_streams_mixed, only : stream_dir, event_Fconv
  #:endif
  use set
  implicit none
  private
  public calc_EFG, init_sensor
  real(sp), allocatable, device, save :: sensor(:,:,:)
contains
  subroutine init_sensor(nx, ny, nz)
    integer, intent(in) :: nx, ny, nz
    allocate(sensor(nx,ny,nz))
  end subroutine init_sensor


  !> Sequential (OVERLAP_GC=False) dispatch: default stream throughout,
  !> identical ordering/semantics to the plain (non-fork) baseline solver --
  !> convective flux written fresh into E/F/G, then the FP32-internal viscous
  !> kernels accumulate onto the same buffers. No manual sync needed: default-
  !> stream launches are implicitly ordered by the CUDA runtime.
  subroutine calc_conv_visc_seq(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q_1, Q_2, Q_3, Q_4, Q_5, mu, &
                                 inv_dx_r4, inv_dy_r4, inv_dz_r4, ux, vy, wz, E, F, G)
    integer, intent(in), value                 :: nx, ny, nz
    real(8), intent(in), device, contiguous    :: inv_dx(nx-1), inv_dy(ny-1), inv_dz(nz-1)
    real(8), intent(in), device, contiguous    :: Q_1(nx,ny,nz), Q_2(nx,ny,nz), Q_3(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: Q_4(nx,ny,nz), Q_5(nx,ny,nz)
    real(4), intent(in), device, contiguous    :: mu(nx,ny,nz)
    real(4), intent(in), device, contiguous    :: inv_dx_r4(nx-1), inv_dy_r4(ny-1), inv_dz_r4(nz-1)
    real(4), intent(in), device, contiguous    :: ux(nx,ny,nz), vy(nx,ny,nz), wz(nx,ny,nz)
    real(8), intent(inout), device, contiguous :: E(nx-1,ny-2,nz-2,5), F(nx-2,ny-1,nz-2,5)
    real(8), intent(inout), device, contiguous :: G(nx-2,ny-2,nz-1,5)
    call calc_Ducros<<<blocks,threads>>>(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q_2, Q_3, Q_4, sensor)
    call calc_slau_x_in<<<blocksE,threadsE>>>(nx, ny, nz, Q_1, Q_2, Q_3, Q_4, Q_5, sensor, E)
    call calc_slau_y_in<<<blocksF,threadsF>>>(nx, ny, nz, Q_1, Q_2, Q_3, Q_4, Q_5, sensor, F)
    call calc_slau_z_in<<<blocksG,threadsG>>>(nx, ny, nz, Q_1, Q_2, Q_3, Q_4, Q_5, sensor, G)
    call calc_Ev6_in_mp<<<blocksEv,threadsEv>>>(nx, ny, nz, inv_dx_r4, inv_dy_r4, inv_dz_r4, u_r4, v_r4, w_r4, T_r4, mu, vy, wz, E)
    call calc_Fv6_in_mp<<<blocksFv,threadsFv>>>(nx, ny, nz, inv_dx_r4, inv_dy_r4, inv_dz_r4, u_r4, v_r4, w_r4, T_r4, mu, ux, wz, F)
    call calc_Gv6_in_mp<<<blocksGv,threadsGv>>>(nx, ny, nz, inv_dx_r4, inv_dy_r4, inv_dz_r4, u_r4, v_r4, w_r4, T_r4, mu, ux, vy, G)
  end subroutine calc_conv_visc_seq


#:if OVERLAP_MODE == 'streams'
  !> Per-direction dispatch on three ordinary (non-Green-Context) streams: each
  !> stream owns one flux array end to end and runs its convective kernel then
  !> its viscous kernel.
  !>
  !>   stream_dir(1): calc_slau_x_in -> calc_Ev6_in_mp   (owns E)
  !>   stream_dir(2): calc_slau_y_in -> calc_Fv6_in_mp   (owns F)
  !>   stream_dir(3): calc_slau_z_in -> calc_Gv6_in_mp   (owns G)
  !>
  !> Properties that make this preferable to the Green-Context 3-phase dispatch
  !> below (all measured on GH200 513^3, see 3D_solver_mixed/nsys_ncu_SoA/):
  !>
  !>  * No cross-stream dependency at all, hence no events and no
  !>    cudaStreamWaitEvent. Within a stream the order is conv-then-visc, which
  !>    is exactly what calc_conv_visc_seq does per array.
  !>  * Numerically identical to the sequential path by construction: per array
  !>    the write order is unchanged (convective fresh write, then the viscous
  !>    kernel accumulating onto it). The 3-phase dispatch inverts that order,
  !>    which is why it needs the F/G zero-fill and the accumulate-variant
  !>    convective kernels -- and why it took two rounds of fixes to get right.
  !>  * Drops both of those costs: the zero-fill measured 3.06 ms/RK stage and
  !>    the _acc read-modify-write ~10.5 ms/stage.
  !>  * No SM partition, so blocks from the FP64 convective and FP32 viscous
  !>    kernels may co-reside on the same SM. Because the three streams' kernels
  !>    have different durations they naturally stagger, so at a given instant
  !>    one stream is typically in its FP32 viscous kernel while another is in
  !>    its FP64 convective kernel. Partitioning SMs (the 'gc' mode) is
  !>    provably work-conserving and can only tie sequential; sharing them is
  !>    the one mechanism with headroom above that -- the FP32/FP64 co-execution
  !>    microbenchmarks in 3D_solver_mixed/fp32fp64_report/ measured 4-28% wall
  !>    reduction vs serial on this exact GPU.
  subroutine calc_conv_visc_streamed(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q_1, Q_2, Q_3, Q_4, Q_5, mu, &
                                      inv_dx_r4, inv_dy_r4, inv_dz_r4, ux, vy, wz, E, F, G)
    integer, intent(in), value                 :: nx, ny, nz
    real(8), intent(in), device, contiguous    :: inv_dx(nx-1), inv_dy(ny-1), inv_dz(nz-1)
    real(8), intent(in), device, contiguous    :: Q_1(nx,ny,nz), Q_2(nx,ny,nz), Q_3(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: Q_4(nx,ny,nz), Q_5(nx,ny,nz)
    real(4), intent(in), device, contiguous    :: mu(nx,ny,nz)
    real(4), intent(in), device, contiguous    :: inv_dx_r4(nx-1), inv_dy_r4(ny-1), inv_dz_r4(nz-1)
    real(4), intent(in), device, contiguous    :: ux(nx,ny,nz), vy(nx,ny,nz), wz(nx,ny,nz)
    real(8), intent(inout), device, contiguous :: E(nx-1,ny-2,nz-2,5), F(nx-2,ny-1,nz-2,5)
    real(8), intent(inout), device, contiguous :: G(nx-2,ny-2,nz-1,5)
    integer :: istat
    type(nvtxRangeId) :: id
    ! stream_dir are cudaStreamNonBlocking streams, so they do NOT pick up the
    ! legacy default stream's implicit ordering. calc_quantities_T_3D_mixed,
    ! calc_div_* and calc_Ducros all ran on the default stream just before this
    ! call and every kernel below reads their output (Q/T_r4/mu, ux/vy/wz,
    ! sensor) -- drain it first or the launches below race stale data.
    istat = cudaDeviceSynchronize()
    ! Each pair is independent of the other two; the only ordering that matters
    ! is conv-before-visc within a stream, which same-stream program order gives
    ! for free.
    id = nvtxRangeStart("E+Ev")
    call calc_slau_x_in<<<blocksE,threadsE,0,stream_dir(1)>>>(nx, ny, nz, Q_1, Q_2, Q_3, Q_4, Q_5, sensor, E)
    call calc_Ev6_in_mp<<<blocksEv,threadsEv,0,stream_dir(1)>>>(nx, ny, nz, inv_dx_r4, inv_dy_r4, inv_dz_r4, u_r4, v_r4, w_r4, T_r4, mu, vy, wz, E)
    call nvtxRangeEnd(id)
    id = nvtxRangeStart("F+Fv")
    call calc_slau_y_in<<<blocksF,threadsF,0,stream_dir(2)>>>(nx, ny, nz, Q_1, Q_2, Q_3, Q_4, Q_5, sensor, F)
    call calc_Fv6_in_mp<<<blocksFv,threadsFv,0,stream_dir(2)>>>(nx, ny, nz, inv_dx_r4, inv_dy_r4, inv_dz_r4, u_r4, v_r4, w_r4, T_r4, mu, ux, wz, F)
    call nvtxRangeEnd(id)
    id = nvtxRangeStart("G+Gv")
    call calc_slau_z_in<<<blocksG,threadsG,0,stream_dir(3)>>>(nx, ny, nz, Q_1, Q_2, Q_3, Q_4, Q_5, sensor, G)
    call calc_Gv6_in_mp<<<blocksGv,threadsGv,0,stream_dir(3)>>>(nx, ny, nz, inv_dx_r4, inv_dy_r4, inv_dz_r4, u_r4, v_r4, w_r4, T_r4, mu, ux, vy, G)
    call nvtxRangeEnd(id)
    ! Mirror of the entry drain: RungeKutta launches calc_step* on the default
    ! stream immediately after this returns, reading E/F/G.
    istat = cudaDeviceSynchronize()
  end subroutine calc_conv_visc_streamed
#:endif


#:if OVERLAP_MODE == 'zslab'
  !> z-slab launch primitive for the F-direction convective (accumulate)
  !> kernel -- mirrors 3D_solver/src/calc_flux_base.f90.fypp's
  !> calc_conv_G_koff: reuse blocksF%x/%y unchanged, recompute only blocksF%z
  !> from the requested [k_lo,k_hi] slab width, and launch on the caller's
  !> stream.
  subroutine calc_conv_F_koff_acc(nx, ny, nz, Q_1, Q_2, Q_3, Q_4, Q_5, F, k_lo, k_hi, str)
    integer, intent(in), value                 :: nx, ny, nz, k_lo, k_hi
    real(8), intent(in), device, contiguous    :: Q_1(nx,ny,nz), Q_2(nx,ny,nz), Q_3(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: Q_4(nx,ny,nz), Q_5(nx,ny,nz)
    real(8), intent(inout), device, contiguous :: F(nx-2,ny-1,nz-2,5)
    integer(cuda_stream_kind), intent(in), value :: str
    integer :: n_F
    type(dim3) :: bF
    n_F = k_hi - k_lo + 1
    bF = dim3(blocksF%x, blocksF%y, (n_F + threadsF%z - 1) / threadsF%z)
    call calc_slau_y_in_acc_koff<<<bF,threadsF,0,str>>>(nx, ny, nz, Q_1, Q_2, Q_3, Q_4, Q_5, sensor, F, k_lo, k_hi)
  end subroutine calc_conv_F_koff_acc


  !> Same z-slab cropping for the F-direction viscous kernel. calc_Fv6_in_koff_mp
  !> already exists (3D_solver_mixed/src/calc_visc_high_internal_mp.f90.fypp,
  !> generated by its #:for is_koff loop) -- no new kernel needed here, only
  !> this grid-cropping wrapper.
  subroutine calc_visc_Fv_koff(nx, ny, nz, inv_dx_r4, inv_dy_r4, inv_dz_r4, mu, ux, wz, F, k_lo, k_hi, str)
    integer, intent(in), value                 :: nx, ny, nz, k_lo, k_hi
    real(4), intent(in), device, contiguous    :: inv_dx_r4(nx-1), inv_dy_r4(ny-1), inv_dz_r4(nz-1)
    real(4), intent(in), device, contiguous    :: mu(nx,ny,nz), ux(nx,ny,nz), wz(nx,ny,nz)
    real(8), intent(inout), device, contiguous :: F(nx-2,ny-1,nz-2,5)
    integer(cuda_stream_kind), intent(in), value :: str
    integer :: n_Fv
    type(dim3) :: bFv
    n_Fv = k_hi - k_lo + 1
    bFv = dim3(blocksFv%x, blocksFv%y, (n_Fv + threadsFv%z - 1) / threadsFv%z)
    call calc_Fv6_in_koff_mp<<<bFv,threadsFv,0,str>>>(nx, ny, nz, inv_dx_r4, inv_dy_r4, inv_dz_r4, u_r4, v_r4, w_r4, T_r4, mu, ux, wz, k_lo, k_hi, F)
  end subroutine calc_visc_Fv_koff


  !> F's valid k-range is [2, nz-1] (F(nx-2,ny-1,nz-2,5), i.e. k-1 in
  !> [1,nz-2] -- see calc_slau_y_in_acc's k=(blockIdx%z-1)*blockDim%z+kt+1
  !> with blockDim%z=threadsF%z=1). Splits that range into NZSLAB
  !> (near-)equal slabs, front-loading the remainder onto the first `rem`
  !> slabs so every k-plane in [2,nz-1] is covered exactly once.
  subroutine calc_F_slab_bounds(islab, nz, lo, hi)
    integer, intent(in)  :: islab, nz
    integer, intent(out) :: lo, hi
    integer :: nzk, base, rem
    nzk = nz - 2
    base = nzk / ${NZSLAB}$
    rem  = mod(nzk, ${NZSLAB}$)
    if (islab <= rem) then
      lo = 2 + (islab-1)*(base+1)
      hi = lo + base
    else
      lo = 2 + rem*(base+1) + (islab-1-rem)*base
      hi = lo + base - 1
    endif
  end subroutine calc_F_slab_bounds


  !> z-slab pipelined dispatch, F/Fv ONLY -- see NSTGV/config.fypp's
  !> OVERLAP_MODE doc comment for why E/Ev and G/Gv cannot benefit (their
  !> non-z grid dims already exceed GH200's residency capacity regardless of
  !> z-slab thickness). E and G are computed exactly as calc_conv_visc_seq
  !> does: full-grid, unchanged, default stream.
  !>
  !> F is zeroed once, then a ONE-SLAB-OFFSET pipeline runs
  !> calc_conv_F_koff_acc(slab i) concurrently with calc_visc_Fv_koff(slab
  !> i-1) on two dedicated non-blocking streams. The offset is load-bearing,
  !> not cosmetic: F-conv and Fv-visc both accumulate (`F = F + flux`) into
  !> the SAME F(...,k-1,...) addresses for a given slab index, and that
  !> read-modify-write is not atomic across two kernels on two streams --
  !> running slab i's conv and visc concurrently would race and silently
  !> corrupt results (the same class of bug 'gc' mode hit twice before this
  !> file's history). Because conv(slab i) and visc(slab i-1) target
  !> disjoint k-ranges, they can never collide no matter how the scheduler
  !> interleaves them.
  subroutine calc_conv_visc_zslab(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q_1, Q_2, Q_3, Q_4, Q_5, mu, &
                                   inv_dx_r4, inv_dy_r4, inv_dz_r4, ux, vy, wz, E, F, G)
    integer, intent(in), value                 :: nx, ny, nz
    real(8), intent(in), device, contiguous    :: inv_dx(nx-1), inv_dy(ny-1), inv_dz(nz-1)
    real(8), intent(in), device, contiguous    :: Q_1(nx,ny,nz), Q_2(nx,ny,nz), Q_3(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: Q_4(nx,ny,nz), Q_5(nx,ny,nz)
    real(4), intent(in), device, contiguous    :: mu(nx,ny,nz)
    real(4), intent(in), device, contiguous    :: inv_dx_r4(nx-1), inv_dy_r4(ny-1), inv_dz_r4(nz-1)
    real(4), intent(in), device, contiguous    :: ux(nx,ny,nz), vy(nx,ny,nz), wz(nx,ny,nz)
    real(8), intent(inout), device, contiguous :: E(nx-1,ny-2,nz-2,5), F(nx-2,ny-1,nz-2,5)
    real(8), intent(inout), device, contiguous :: G(nx-2,ny-2,nz-1,5)
    integer :: istat, islab, k_lo, k_hi, k_lo_prev, k_hi_prev
    call calc_Ducros<<<blocks,threads>>>(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q_2, Q_3, Q_4, sensor)
    call calc_slau_x_in<<<blocksE,threadsE>>>(nx, ny, nz, Q_1, Q_2, Q_3, Q_4, Q_5, sensor, E)
    call calc_slau_z_in<<<blocksG,threadsG>>>(nx, ny, nz, Q_1, Q_2, Q_3, Q_4, Q_5, sensor, G)
    call calc_Ev6_in_mp<<<blocksEv,threadsEv>>>(nx, ny, nz, inv_dx_r4, inv_dy_r4, inv_dz_r4, u_r4, v_r4, w_r4, T_r4, mu, vy, wz, E)
    call calc_Gv6_in_mp<<<blocksGv,threadsGv>>>(nx, ny, nz, inv_dx_r4, inv_dy_r4, inv_dz_r4, u_r4, v_r4, w_r4, T_r4, mu, ux, vy, G)
    F = 0.d0
    ! stream_dir are non-blocking, so they do not pick up the default stream's
    ! implicit ordering -- Ducros/E/G/Ev/Gv/the F zero-fill above all ran on
    ! the default stream and must be drained before the slab loop reads
    ! Q/T_r4/mu/ux/wz or writes F.
    istat = cudaDeviceSynchronize()
    call calc_F_slab_bounds(1, nz, k_lo, k_hi)
    call calc_conv_F_koff_acc(nx, ny, nz, Q_1, Q_2, Q_3, Q_4, Q_5, F, k_lo, k_hi, stream_dir(1))
    istat = cudaEventRecord(event_Fconv, stream_dir(1))
    do islab = 2, ${NZSLAB}$
      k_lo_prev = k_lo; k_hi_prev = k_hi
      call calc_F_slab_bounds(islab, nz, k_lo, k_hi)
      ! visc(slab i-1) must wait for conv(slab i-1) to actually finish, not
      ! merely be issued -- program order across two independent non-blocking
      ! streams does NOT imply execution order. Without this wait, visc and
      ! conv can race on the same F(...,k-1,...) addresses for slab i-1 (a
      ! non-atomic read-modify-write); conv(slab i), launched right after on
      ! stream 1, has no such dependency and is free to run concurrently with
      ! this wait/visc call -- that concurrency is the whole point.
      istat = cudaStreamWaitEvent(stream_dir(2), event_Fconv, 0)
      call calc_visc_Fv_koff(nx, ny, nz, inv_dx_r4, inv_dy_r4, inv_dz_r4, mu, ux, wz, F, k_lo_prev, k_hi_prev, stream_dir(2))
      call calc_conv_F_koff_acc(nx, ny, nz, Q_1, Q_2, Q_3, Q_4, Q_5, F, k_lo, k_hi, stream_dir(1))
      istat = cudaEventRecord(event_Fconv, stream_dir(1))
    end do
    istat = cudaStreamWaitEvent(stream_dir(2), event_Fconv, 0)
    call calc_visc_Fv_koff(nx, ny, nz, inv_dx_r4, inv_dy_r4, inv_dz_r4, mu, ux, wz, F, k_lo, k_hi, stream_dir(2))
    ! Mirror of the entry drain: RungeKutta launches calc_step* on the default
    ! stream immediately after this returns, reading E/F/G.
    istat = cudaDeviceSynchronize()
  end subroutine calc_conv_visc_zslab
#:endif


#:if OVERLAP_MODE == 'gc'
  !> Interleaved convective (real8, stream_conv) / viscous (real4-internal,
  !> stream_visc) dispatch, staggered into 3 phases so each phase's pair of
  !> kernels runs concurrently on disjoint Green-Context SM partitions:
  !>   phase 1: E (conv, fresh write)   || Fv (visc, fresh write onto zeroed F)
  !>   phase 2: F (conv, ACCUMULATES onto Fv, waits on Fv) || Gv (visc, fresh onto zeroed G)
  !>   phase 3: G (conv, ACCUMULATES onto Gv, waits on Gv) || Ev (visc, accumulates onto E, waits on E)
  !>
  !> calc_slau_x_in (E) is the ordinary intent(out) fresh-write kernel --
  !> nothing precedes it. F/G use calc_slau_*_in_ACC
  !> (calc_slau_kernel_internal_acc.f90.fypp) instead of the ordinary
  !> calc_slau_y_in/z_in: those are intent(out) fresh overwrites too, which
  !> would silently discard whatever Fv/Gv already wrote into F/G this phase
  !> (the earlier version of this dispatcher had exactly that bug -- launched
  !> Fv/Gv first, then overwrote their contribution with a fresh convective
  !> write, causing NaN blowup). calc_slau_y_in_acc/z_in_acc instead do
  !> `F = F + flux`, so the phase order below is safe: F/G are zeroed first,
  !> Fv/Gv write their (narrower-range) viscous contribution into the zeroed
  !> buffer, then F/G's convective kernel adds its flux on top -- boundary
  !> cells Fv/Gv never touch simply get `0 + flux`, matching a plain
  !> convective-only write there.
  subroutine calc_conv_visc_paired_mixed(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q_1, Q_2, Q_3, Q_4, Q_5, mu, &
                                          inv_dx_r4, inv_dy_r4, inv_dz_r4, ux, vy, wz, E, F, G)
    integer, intent(in), value                 :: nx, ny, nz
    real(8), intent(in), device, contiguous    :: inv_dx(nx-1), inv_dy(ny-1), inv_dz(nz-1)
    real(8), intent(in), device, contiguous    :: Q_1(nx,ny,nz), Q_2(nx,ny,nz), Q_3(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: Q_4(nx,ny,nz), Q_5(nx,ny,nz)
    real(4), intent(in), device, contiguous    :: mu(nx,ny,nz)
    real(4), intent(in), device, contiguous    :: inv_dx_r4(nx-1), inv_dy_r4(ny-1), inv_dz_r4(nz-1)
    real(4), intent(in), device, contiguous    :: ux(nx,ny,nz), vy(nx,ny,nz), wz(nx,ny,nz)
    real(8), intent(inout), device, contiguous :: E(nx-1,ny-2,nz-2,5), F(nx-2,ny-1,nz-2,5)
    real(8), intent(inout), device, contiguous :: G(nx-2,ny-2,nz-1,5)
    integer :: istat
    ! Fv/Gv's fresh (non-koff) write only covers the range where their own
    ! cross-derivative stencil is valid (a VISC_ORDER-wide halo in BOTH
    ! transverse directions), narrower than the range the paired convective
    ! kernel accumulates into next -- zero F/G first so that accumulate sees
    ! a valid (viscous-free) baseline in the boundary-shell cells Fv/Gv never
    ! touch, instead of uninitialized memory.
    F = 0.d0
    G = 0.d0
    ! stream_conv/stream_visc are CUDA Green Context streams -- separate CUDA
    ! contexts from the one that ran calc_quantities_T_3D_mixed (default
    ! stream, just before this call) and the F/G zero-fill above, so they do
    ! not get the implicit default-stream ordering an ordinary stream would.
    ! Drain the default stream first so the kernels below don't race stale
    ! Q/T_r4/mu or the zero-fill. cudaDeviceSynchronize() with the primary
    ! context current (always true here) drains all green contexts too.
    istat = cudaDeviceSynchronize()
    ! calc_Ducros must run every step (the SLAU/HRSLAU2 kernels below read
    ! `sensor`, a persistent module-level array) -- the sequential dispatch
    ! calls it on the default stream; here it goes on stream_conv so it's
    ! ordered before the convective kernels without an extra event.
    call calc_Ducros<<<blocks,threads,0,stream_conv>>>(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q_2, Q_3, Q_4, sensor)
    ! ---- phase 1: E (conv) || Fv (visc) ----
    call calc_slau_x_in<<<blocksE,threadsE,0,stream_conv>>>(nx, ny, nz, Q_1, Q_2, Q_3, Q_4, Q_5, sensor, E)
    istat = cudaEventRecord(event_E, stream_conv)
    call calc_Fv6_in_mp<<<blocksFv,threadsFv,0,stream_visc>>>(nx, ny, nz, inv_dx_r4, inv_dy_r4, inv_dz_r4, u_r4, v_r4, w_r4, T_r4, mu, ux, wz, F)
    istat = cudaEventRecord(event_Fv, stream_visc)
    ! ---- phase 2: F (conv, waits on Fv) || Gv (visc) ----
    istat = cudaStreamWaitEvent(stream_conv, event_Fv, 0)
    call calc_slau_y_in_acc<<<blocksF,threadsF,0,stream_conv>>>(nx, ny, nz, Q_1, Q_2, Q_3, Q_4, Q_5, sensor, F)
    call calc_Gv6_in_mp<<<blocksGv,threadsGv,0,stream_visc>>>(nx, ny, nz, inv_dx_r4, inv_dy_r4, inv_dz_r4, u_r4, v_r4, w_r4, T_r4, mu, ux, vy, G)
    istat = cudaEventRecord(event_Gv, stream_visc)
    ! ---- phase 3: G (conv, waits on Gv) || Ev (visc, waits on E) ----
    istat = cudaStreamWaitEvent(stream_conv, event_Gv, 0)
    call calc_slau_z_in_acc<<<blocksG,threadsG,0,stream_conv>>>(nx, ny, nz, Q_1, Q_2, Q_3, Q_4, Q_5, sensor, G)
    istat = cudaStreamWaitEvent(stream_visc, event_E, 0)
    call calc_Ev6_in_mp<<<blocksEv,threadsEv,0,stream_visc>>>(nx, ny, nz, inv_dx_r4, inv_dy_r4, inv_dz_r4, u_r4, v_r4, w_r4, T_r4, mu, vy, wz, E)
    ! Mirror of the entry sync: the caller (RungeKutta) launches calc_step*
    ! on the default stream right after this returns, reading E/F/G.
    istat = cudaDeviceSynchronize()
  end subroutine calc_conv_visc_paired_mixed
#:endif


  subroutine calc_EFG(nx, ny, nz, inv_dx, inv_dy, inv_dz, Jacobian, &
                       QJ_1, QJ_2, QJ_3, QJ_4, QJ_5, Q_1, Q_2, Q_3, Q_4, Q_5, T, mu, mut, qc2, &
                       inv_dx_r4, inv_dy_r4, inv_dz_r4, ux, vy, wz, E, F, G, k_lo_G, k_hi_G)
    integer, intent(in), value                 :: nx, ny, nz
    real(8), intent(in), device, contiguous    :: inv_dx(nx-1), inv_dy(ny-1), inv_dz(nz-1)
    real(8), intent(in), device, contiguous    :: Jacobian(nx,ny)
    real(8), intent(in), device, contiguous    :: QJ_1(nx,ny,nz), QJ_2(nx,ny,nz), QJ_3(nx,ny,nz)
    real(8), intent(in), device, contiguous    :: QJ_4(nx,ny,nz), QJ_5(nx,ny,nz)
    real(8), intent(inout), device, contiguous :: Q_1(nx,ny,nz), Q_2(nx,ny,nz), Q_3(nx,ny,nz)
    real(8), intent(inout), device, contiguous :: Q_4(nx,ny,nz), Q_5(nx,ny,nz), T(nx,ny,nz)
    real(4), intent(inout), device, contiguous :: mu(nx,ny,nz)
    real(8), intent(inout), device, contiguous :: mut(1,1,1), qc2(1,1,1)
    real(4), intent(in), device, contiguous    :: inv_dx_r4(nx-1), inv_dy_r4(ny-1), inv_dz_r4(nz-1)
    real(4), intent(inout), device, contiguous :: ux(nx,ny,nz), vy(nx,ny,nz), wz(nx,ny,nz)
    real(8), intent(inout), device, contiguous :: E(nx-1,ny-2,nz-2,5), F(nx-2,ny-1,nz-2,5)
    real(8), intent(inout), device, contiguous :: G(nx-2,ny-2,nz-1,5)
    integer, intent(in)                        :: k_lo_G, k_hi_G
    call calc_quantities_T_3D_mixed(nx, ny, nz, Jacobian, QJ_1, QJ_2, QJ_3, QJ_4, QJ_5, Q_1, Q_2, Q_3, Q_4, Q_5, T, mu, 1, nz)
    ! ux/vy/wz (cell-center velocity gradients, real(4)) precomputed once here
    ! and reused by calc_Ev/Fv/Gv6_in_mp below -- see calc_div_mp.f90, ported
    ! from 3D_solver/src/calc_div.f90's calc_div_{ux,vy,wz}_6_in.
    call calc_div_ux_6_in_mp(nx, ny, nz, inv_dx_r4, u_r4, ux)
    call calc_div_vy_6_in_mp(nx, ny, nz, inv_dy_r4, v_r4, vy)
    call calc_div_wz_6_in_mp(nx, ny, nz, inv_dz_r4, w_r4, wz)
    #:if OVERLAP_MODE == 'gc'
    call calc_conv_visc_paired_mixed(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q_1, Q_2, Q_3, Q_4, Q_5, mu, &
                                      inv_dx_r4, inv_dy_r4, inv_dz_r4, ux, vy, wz, E, F, G)
    #:elif OVERLAP_MODE == 'streams'
    ! calc_Ducros writes `sensor`, which all three convective kernels read, so it
    ! must precede the fan-out. It goes on the default stream (full chip) rather
    ! than inside one of the three streams: putting it in a stream would make the
    ! other two wait on an event for no benefit, since nothing can start before
    ! it anyway.
    call calc_Ducros<<<blocks,threads>>>(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q_2, Q_3, Q_4, sensor)
    call calc_conv_visc_streamed(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q_1, Q_2, Q_3, Q_4, Q_5, mu, &
                                  inv_dx_r4, inv_dy_r4, inv_dz_r4, ux, vy, wz, E, F, G)
    #:elif OVERLAP_MODE == 'zslab'
    call calc_conv_visc_zslab(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q_1, Q_2, Q_3, Q_4, Q_5, mu, &
                               inv_dx_r4, inv_dy_r4, inv_dz_r4, ux, vy, wz, E, F, G)
    #:else
    call calc_conv_visc_seq(nx, ny, nz, inv_dx, inv_dy, inv_dz, Q_1, Q_2, Q_3, Q_4, Q_5, mu, &
                             inv_dx_r4, inv_dy_r4, inv_dz_r4, ux, vy, wz, E, F, G)
    #:endif
  end subroutine calc_EFG
end module calc_flux_base
